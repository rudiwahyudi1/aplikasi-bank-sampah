                        <span>TOTAL BERAT</span>
                        <span class="fw-bold" id="receiptTotalWeight">0 kg</span>
                    </div>
                    <div class="d-flex justify-content-between fs-6 fw-bold mt-1">
                        <span>TOTAL SETORAN</span>
                        <span id="receiptTotalValue">Rp 0</span>
                    </div>
                    <div class="d-flex justify-content-between text-muted" style="font-size: 10.5px; margin-top: 3px;">
                        <span>Status Setoran</span>
                        <span class="fw-bold text-success" id="receiptStatus">LUNAS</span>
                    </div>
                    <div class="d-flex justify-content-between mt-1 pt-1" style="border-top: 1px dotted #888;">
                        <span class="fw-semibold">Saldo Buku Tabungan</span>
                        <span class="fw-bold text-primary" id="receiptCustomerBalance">Rp 0</span>
                    </div>

                    <div class="thermal-double-divider"></div>

                    <div class="text-center" style="font-size: 10px;">
                        <div>*** TERIMA KASIH ***</div>
                        <div>Telah memilah sampah demi bumi lestari</div>
                        <div class="mt-1 font-monospace" style="letter-spacing: 2px;">||||||||||||||||||||||||||||</div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 p-3 bg-white d-flex gap-2 no-print">
                <button type="button" class="btn btn-outline-secondary w-50 fw-semibold" onclick="sendReceiptWhatsApp()">
                    <i class="bi bi-whatsapp me-1 text-success"></i> Kirim WhatsApp
                </button>
                <button type="button" class="btn btn-primary w-50 fw-semibold" onclick="printThermalReceipt()">
                    <i class="bi bi-printer me-1"></i> Cetak Struk
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ================================================================
     MODAL SCANNER QR KAMERA (#modalQrScanner)
================================================================= -->
<div class="modal fade" id="modalQrScanner" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 440px;">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header border-0 bg-success text-white p-3">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-qr-code-scan fs-5"></i>
                    <h6 class="modal-title fw-bold mb-0">Scanner QR Code Nasabah</h6>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-3 text-center">
                <p class="text-muted small mb-3">Arahkan kamera ke QR Code pada Kartu Anggota Digital nasabah untuk mendeteksi identitas otomatis.</p>
                
                <div id="qrVideoRegion" class="bg-dark rounded-3 mb-3 mx-auto" style="width: 100%; min-height: 260px; display: flex; align-items: center; justify-content: center; color: #fff;">
                    <div class="spinner-border text-light spinner-border-sm me-2" role="status"></div>
                    <span>Mengaktifkan kamera...</span>
                </div>

                <div id="scanErrorMessage" class="alert alert-danger py-2 small" style="display: none;"></div>

                <!-- SCAN RESULT CARD -->
                <div id="scanResultCard" class="card border-success p-3 rounded-3 text-start bg-light" style="display: none;">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <i class="bi bi-check-circle-fill text-success fs-5"></i>
                        <span class="fw-bold text-dark">Kartu Berhasil Terdeteksi!</span>
                    </div>
                    <div class="small text-muted mb-2">Kode Nasabah:</div>
                    <div class="badge bg-success fs-6 font-monospace mb-3" id="scannedCodeBadge">BS-2026-XXXX</div>
                    <button type="button" id="btnApplyScanFilter" class="btn btn-success w-100 fw-semibold" data-bs-dismiss="modal">
                        <i class="bi bi-funnel me-1"></i> Tampilkan Data Pickup Nasabah Ini
                    </button>
                </div>
            </div>
            <div class="modal-footer border-0 p-3 bg-light">
                <button type="button" class="btn btn-secondary w-100 fw-semibold rounded-3" data-bs-dismiss="modal">Tutup Scanner</button>
            </div>
        </div>
    </div>
</div>
</script>