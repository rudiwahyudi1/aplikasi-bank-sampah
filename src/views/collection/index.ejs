        color: #fff;
    }

    .ios-timeline-step.current .ios-timeline-icon {
        background: #34c759;
        color: #fff;
        box-shadow: 0 0 0 5px rgba(52, 199, 89, .13);
    }

    .ios-timeline-content {
        padding: 1px 0 22px;
        min-width: 0;
    }

    .ios-step-title {
        color: #1c1c1e;
        font-size: 14px;
        font-weight: 700;
        line-height: 1.4;
    }

    .ios-step-desc {
        color: #8e8e93;
        font-size: 12px;
        line-height: 1.5;
        margin-top: 3px;
    }

    .ios-current-badge {
        display: inline-flex;
        align-items: center;
        margin-left: 5px;
        padding: 3px 7px;
        border-radius: 999px;
        background: #e8f8ed;
        color: #248a3d;
        font-size: 10px;
        font-weight: 700;
        vertical-align: middle;
    }

    /* ALERT */
    .ios-alert {
        border: 0;
        border-radius: 18px;
        padding: 14px 16px;
        font-size: 13px;
        line-height: 1.5;
    }

    .ios-alert.rejected {
        background: #fff0f0;
        color: #c62828;
    }

    .ios-alert.cancelled {
        background: #f0f0f2;
        color: #636366;
    }

    .ios-alert i {
        font-size: 15px;
    }

    /* INFO CARDS */
    .ios-info-card {
        height: 100%;
        background: #fff;
        border-radius: 17px;
        padding: 15px;
        box-shadow: 0 1px 3px rgba(0, 0, 0, .04);
    }

    .ios-info-label {
        color: #8e8e93;
        font-size: 11px;
        font-weight: 600;
        margin-bottom: 7px;
    }

    .ios-info-value {
        color: #1c1c1e;
        font-size: 13px;
        font-weight: 700;
        line-height: 1.4;
    }

    .ios-info-value i {
        color: #34c759;
    }

    /* NOTE */
    .ios-note {
        background: #fff;
        border-radius: 17px;
        padding: 14px 16px;
        color: #8e8e93;
        font-size: 12px;
        line-height: 1.55;
        box-shadow: 0 1px 3px rgba(0, 0, 0, .04);
    }

    .ios-note i {
        color: #34c759;
    }

    /* FOOTER */
    .ios-tracking-footer {
        background: rgba(255, 255, 255, .94);
        border-top: 1px solid rgba(60, 60, 67, .12);
        padding: 13px 18px;
    }

    .ios-btn-close {
        width: 100%;
        border: 0;
        border-radius: 14px;
        padding: 11px 16px;
        background: #e5e5ea;
        color: #1c1c1e;
        font-size: 14px;
        font-weight: 700;
        transition: .2s ease;
    }

    .ios-btn-close:hover {
        background: #d1d1d6;
    }

    /* MOBILE */
    @media (max-width: 576px) {

        .ios-tracking-modal .modal-dialog {
            margin: 10px;
            max-width: none;
        }

        .ios-tracking-modal .modal-content {
            border-radius: 22px;
        }

        .ios-tracking-header {
            padding: 17px 16px 15px;
        }

        .ios-tracking-body {
            padding: 12px;
        }

        .ios-tracking-summary {
            border-radius: 18px;
            padding: 16px;
        }

        .ios-tracking-header-inner {
            align-items: flex-start;
        }

        .ios-tracking-title {
            font-size: 17px;
        }

        .ios-tracking-subtitle {
            font-size: 12px;
        }

        .ios-tracking-code {
            font-size: 18px;
        }

        .ios-status {
            margin-top: 12px;
        }

        .ios-info-card {
            padding: 13px;
            border-radius: 15px;
        }

        .ios-info-label {
            font-size: 10px;
        }

        .ios-info-value {
            font-size: 12px;
        }

        .ios-timeline-step {
            gap: 11px;
        }

        .ios-timeline-icon {
            width: 32px;
            min-width: 32px;
            height: 32px;
        }

        .ios-timeline-line {
            left: 15px;
            top: 32px;
        }

        .ios-step-title {
            font-size: 13px;
        }

        .ios-step-desc {
            font-size: 11px;
        }
    }

    /* MODAL ANIMATION */
    .ios-tracking-modal.fade .modal-dialog {
        transform: translateY(15px) scale(.98);
        transition: transform .25s ease;
    }

    .ios-tracking-modal.show .modal-dialog {
        transform: translateY(0) scale(1);
    }
</style>

<div class="card bg-white border-0 p-3 p-md-4 rounded-4 shadow-sm">
    <div class="collection-page">


        <!-- ========================================================
            PAGE HEADER
        ========================================================= -->
        <div class="mb-4">

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">

                <div class="d-flex align-items-center gap-2">

                    <div class="page-icon">

                        <i class="bi bi-truck"></i>

                    </div>

                    <div class="page-title-wrap">
                        <h5 class="mb-0">PENGUMPULAN SAMPAH</h5>
                    </div>

                </div>


                <div class="d-flex gap-2">

                    <button
                        type="button"
                        class="btn btn-light border"
                        data-bs-toggle="modal"
                        data-bs-target="#exportCollectionModal">
                        <i class="bi bi-file-earmark-arrow-down me-1 text-primary"></i>
                        Export Data
                    </button>

                    <% if (isManager) { %>

                        <a
                            href="/reports"
                            class="btn btn-light border text-decoration-none">

                            <i class="bi bi-bar-chart me-1"></i>
                            Laporan

                        </a>

                    <% } %>


                    <button
                        type="button"
                        class="btn btn-outline-success fw-semibold"
                        onclick="openQrScannerModal()">
                        <i class="bi bi-qr-code-scan me-1"></i>
                        Scan QR Nasabah
                    </button>

                    <% if (isNasabah) { %>

                        <button
                            type="button"
                            class="btn btn-success"
                            data-bs-toggle="modal"
                            data-bs-target="#requestCollectionModal">

                            <i class="bi bi-plus-lg me-1"></i>
                            Ajukan Pickup

                        </button>

                    <% } %>

                </div>

            </div>

        </div>


        <!-- ========================================================
            STATISTICS
        ========================================================= -->
        <div class="mb-4">

            <div class="row g-2">


                <!-- TOTAL -->
                <div class="col-6 col-xl">

                    <div class="stat-card h-100">

                        <div class="d-flex justify-content-between align-items-center">

                            <div>

                                <div class="stat-label">
                                    Total
                                </div>

                                <div class="stat-value">
                                    <%= Number(
                                        safeSummary.total || 0
                                    ).toLocaleString("id-ID") %>
                                </div>

                            </div>

                            <div
                                class="stat-icon"
                                style="background:#eef2ff;color:#536dfe">

                                <i class="bi bi-collection"></i>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- DIAJUKAN -->
                <div class="col-6 col-xl">

                    <div class="stat-card h-100">

                        <div class="d-flex justify-content-between align-items-center">

                            <div>

                                <div class="stat-label">
                                    Diajukan
                                </div>

                                <div class="stat-value">
                                    <%= Number(
                                        safeSummary.diajukan || 0
                                    ).toLocaleString("id-ID") %>
                                </div>

                            </div>

                            <div
                                class="stat-icon"
                                style="background:#fff6df;color:#a66b00">

                                <i class="bi bi-send"></i>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- DIJADWALKAN -->
                <div class="col-6 col-xl">

                    <div class="stat-card h-100">

                        <div class="d-flex justify-content-between align-items-center">

                            <div>

                                <div class="stat-label">
                                    Dijadwalkan
                                </div>

                                <div class="stat-value">
                                    <%= Number(
                                        safeSummary.dijadwalkan || 0
                                    ).toLocaleString("id-ID") %>
                                </div>

                            </div>

                            <div
                                class="stat-icon"
                                style="background:#edf5ff;color:#2878d4">

                                <i class="bi bi-calendar-check"></i>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- DITIMBANG -->
                <div class="col-6 col-xl">

                    <div class="stat-card h-100">

                        <div class="d-flex justify-content-between align-items-center">

                            <div>

                                <div class="stat-label">
                                    Ditimbang
                                </div>

                                <div class="stat-value">
                                    <%= Number(
                                        safeSummary.ditimbang || 0
                                    ).toLocaleString("id-ID") %>
                                </div>

                            </div>

                            <div
                                class="stat-icon"
                                style="background:#f0eaff;color:#7355c7">

                                <i class="bi bi-speedometer2"></i>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- SELESAI -->
                <div class="col-6 col-xl">

                    <div class="stat-card h-100">

                        <div class="d-flex justify-content-between align-items-center">

                            <div>

                                <div class="stat-label">
                                    Selesai
                                </div>

                                <div class="stat-value">
                                    <%= Number(
                                        safeSummary.selesai || 0
                                    ).toLocaleString("id-ID") %>
                                </div>

                            </div>

                            <div
                                class="stat-icon"
                                style="background:#e9f8ee;color:#22a447">

                                <i class="bi bi-check-circle"></i>

                            </div>

                        </div>

                    </div>

                </div>


            </div>

        </div>


        <!-- ========================================================
            FILTER
        ========================================================= -->
        <div class="content-card card mb-4">

            <div class="section-card-header d-flex flex-wrap justify-content-between align-items-center gap-3">

                <div>

                    <div class="section-title">

                        <i class="bi bi-sliders me-1 text-secondary"></i>

                        Pencarian & Filter

                    </div>

                    <div class="section-subtitle">

                        Cari pickup berdasarkan kode, nasabah, alamat atau status.

                    </div>

                </div>


                <div
                    id="collectionResultCount"
                    class="section-subtitle">

                    <%= collectionRows.length %> data

                </div>

            </div>


            <div class="p-3 p-md-4">

                <form
                    id="collectionFilterForm"
                    method="get"
                    action="">

                    <div class="row g-2">


                        <!-- SEARCH -->
                        <div class="col-lg-4">

                            <div class="search-box">

                                <i class="bi bi-search"></i>

                                <input
                                    type="text"
                                    id="collectionSearch"
                                    name="keyword"
                                    autocomplete="off"
                                    class="form-control"
                                    placeholder="Cari kode, nasabah, alamat..."
                                    value="<%= safeFilters.keyword || '' %>"
                                >

                                <button
                                    type="button"
                                    id="clearCollectionSearch"
                                    class="search-clear">

                                    <i class="bi bi-x"></i>

                                </button>

                            </div>

                        </div>


                        <!-- STATUS -->
                        <div class="col-lg-2 col-md-4">

                            <select
                                class="form-select"
                                id="collectionStatus"
                                name="status">

                                <option value="">
                                    Semua Status
                                </option>

                                <% safeStatusList.forEach(s => { %>

                                    <option
                                        value="<%= s %>"
                                        <%= String(safeFilters.status || "") === String(s) ? "selected" : "" %>>

                                        <%= statusText[s] || s %>

                                    </option>

                                <% }) %>

                            </select>

                        </div>


                        <!-- DATE -->
                        <div class="col-lg-2 col-md-4">

                            <input
                                type="date"
                                class="form-control"
                                id="collectionDate"
                                name="date"
                                value="<%= safeFilters.date || '' %>"
                            >

                        </div>


                        <!-- LIMIT -->
                        <div class="col-lg-2 col-md-4">

                            <select
                                class="form-select"
                                id="collectionLimit"
                                name="limit">

                                <option
                                    value="10"
                                    <%= String(safeFilters.limit || "10") === "10" ? "selected" : "" %>>
                                    10 Data
                                </option>

                                <option
                                    value="25"
                                    <%= String(safeFilters.limit || "") === "25" ? "selected" : "" %>>
                                    25 Data
                                </option>

                                <option
                                    value="50"
                                    <%= String(safeFilters.limit || "") === "50" ? "selected" : "" %>>
                                    50 Data
                                </option>

                            </select>

                        </div>


                        <!-- BUTTON -->
                        <div class="col-lg-2">

                            <button
                                type="submit"
                                class="btn btn-success w-100"
                                style="height:38px">

                                <i class="bi bi-search me-1"></i>
                                Filter

                            </button>

                        </div>


                    </div>

                </form>

            </div>

        </div>


        <!-- ========================================================
            DATA TABLE
        ========================================================= -->
        <div class="content-card card mb-4">

            <div class="table-wrap">

                <table class="table table-hover align-middle mb-0">

                    <thead>

                        <tr>

                            <th><i class="bi bi-upc me-1"></i> Kode</th>

                            <th><i class="bi bi-person me-1"></i> Nasabah</th>

                            <th><i class="bi bi-building me-1"></i> Perusahaan</th>

                            <th><i class="bi bi-calendar3 me-1"></i> Jadwal</th>

                            <th><i class="bi bi-speedometer2 me-1"></i> Berat</th>

                            <th><i class="bi bi-cash-stack me-1"></i> Nilai</th>

                            <th><i class="bi bi-toggle2-on me-1"></i> Status</th>

                            <th class="text-end"><i class="bi bi-three-dots-vertical me-1"></i> Aksi</th>

                        </tr>

                    </thead>


                    <tbody id="collectionTableBody">


                        <% collectionRows.forEach((r, index) => { %>

                            <%
                                const searchable =
                                    String(
                                        (r.code || "") + " " +
                                        (r.full_name || "") + " " +
                                        (r.address || "") + " " +
                                        (r.company_name || "") + " " +
                                        (r.phone || "") + " " +
                                        (r.status || "")
                                    ).toLowerCase();
                            %>


                            <tr
                                class="collection-row"
                                data-index="<%= index %>"
                                data-search="<%= searchable %>"
                            >


                                <!-- KODE -->
                                <td>

                                    <div class="code-badge">

                                        <%= r.code || "-" %>

                                    </div>

                                    <div class="address-text">

                                        <i class="bi bi-geo-alt me-1"></i>

                                        <%= r.address || "-" %>

                                    </div>

                                </td>


                                <!-- NASABAH -->
                                <td>

                                    <div class="customer-name">

                                        <%= r.full_name || "-" %>

                                    </div>

                                    <% if (r.phone) { %>

                                        <div class="phone-text">

                                            <i class="bi bi-telephone me-1"></i>

                                            <%= r.phone %>

                                        </div>

                                    <% } %>

                                </td>


                                <!-- PERUSAHAAN -->
                                <td>

                                    <div class="company-text">

                                        <i class="bi bi-building me-1"></i>

                                        <%= r.company_name || "-" %>

                                    </div>

                                </td>


                                <!-- JADWAL -->
                                <td>

                                    <div class="schedule-date">

                                        <i class="bi bi-calendar3 me-1 text-secondary"></i>

                                        <%= fmtDate(r.scheduled_date) %>

                                    </div>

                                    <div class="time-text">

                                        <i class="bi bi-clock me-1"></i>

                                        <%= r.scheduled_time
                                            ? String(r.scheduled_time).slice(0,5)
                                            : "-"
                                        %>

                                    </div>

                                </td>


                                <!-- BERAT -->
                                <td>

                                    <span class="weight-value">

                                        <%= fmtNumber(
                                            r.total_weight,
                                            3
                                        ) %>

                                        kg

                                    </span>

                                </td>


                                <!-- NILAI -->
                                <td>

                                    <span class="money-value">

                                        Rp
                                        <%= fmtNumber(
                                            r.total_value
                                        ) %>

                                    </span>

                                </td>


                                <!-- STATUS -->
                                <td>

                                    <span
                                        class="ios-status <%= statusClass(r.status) %>">

                                        <i class="bi <%= statusIcon(r.status) %>"></i>

                                        <%= statusText[r.status] || r.status || "-" %>

                                    </span>

                                </td>


                                <!-- AKSI -->
                                <td class="text-end">

                                    <div class="d-flex justify-content-end gap-1">


                                        <% if (isManager) { %>


                                            <!-- STATUS -->
                                            <button
                                                type="button"
                                                class="btn btn-sm btn-light border action-btn"
                                                title="Update Status"
                                                data-bs-toggle="modal"
                                                data-bs-target="#statusCollection<%= r.id %>">

                                                <i class="bi bi-arrow-repeat"></i>

                                            </button>


                                            <!-- TIMBANG -->
                                            <button
                                                type="button"
                                                class="btn btn-sm btn-light border action-btn"
                                                title="Tambah Hasil Timbang"
                                                data-bs-toggle="modal"
                                                data-bs-target="#itemCollection<%= r.id %>">

                                                <i class="bi bi-speedometer2"></i>

                                            </button>


                                            <!-- EDIT -->
                                            <button
                                                type="button"
                                                class="btn btn-sm btn-light border action-btn"
                                                title="Edit"
                                                data-bs-toggle="modal"
                                                data-bs-target="#editCollection<%= r.id %>">

                                                <i class="bi bi-pencil"></i>

                                            </button>

                                            <!-- TRACKING & PETA UNTUK ADMIN/PETUGAS --                                            <!-- TRACKING & PETA UNTUK ADMIN/PETUGAS -->
                                            <button
                                                type="button"
                                                class="btn btn-sm btn-light border action-btn text-success"
                                                title="Tracking & Peta Lokasi"
                                                data-bs-toggle="modal"
                                                data-bs-target="#trackingCollection<%= r.id %>">
                                                <i class="bi bi-geo-alt"></i>
                                            </button>

                                            <!-- STRUK THERMAL NOTA -->
                                            <button
                                                type="button"
                                                class="btn btn-sm btn-light border action-btn text-primary"
                                                title="Cetak Struk Nota Timbangan"
                                                onclick="openReceiptThermal(<%= r.id %>)">
                                                <i class="bi bi-printer"></i>
                                            </button>

                                        <% } else if (
                                            isNasabah &&
                                            Number(r.user_id) === Number(currentUser.id)
                                        ) { %>

                                            <!-- TRACKING NASABAH -->
                                            <button
                                                type="button"
                                                class="btn btn-sm btn-success tracking-btn"
                                                title="Lihat Tracking"
                                                data-bs-toggle="modal"
                                                data-bs-target="#trackingCollection<%= r.id %>">
                                                <i class="bi bi-geo-alt"></i>
                                                <span>Tracking</span>
                                            </button>

                                            <!-- EDIT NASABAH -->
                                            <button
                                                type="button"
                                                class="btn btn-sm btn-light border action-btn"
                                                title="Edit Pickup"
                                                data-bs-toggle="modal"
                                                data-bs-target="#editCollection<%= r.id %>">
                                                <i class="bi bi-pencil"></i>
                                            </button>

                                            <!-- STRUK NOTA NASABAH -->
                                            <button
                                                type="button"
                                                class="btn btn-sm btn-light border action-btn text-primary"
                                                title="Cetak Struk Nota Timbangan"
                                                onclick="openReceiptThermal(<%= r.id %>)">
                                                <i class="bi bi-printer"></i>
                                            </button>

                                        <% } %>%>


                                    </div>

                                </td>


                            </tr>

                        <% }) %>


                    </tbody>

                </table>

            </div>


            <!-- ====================================================
                EMPTY STATE
            ===================================================== -->
            <div
                id="collectionEmpty"
                class="empty-state"
                style="display: none;">

                <div class="empty-icon">

                    <i class="bi bi-search"></i>

                </div>

                <div class="empty-title">

                    Data tidak ditemukan

                </div>

                <div class="empty-text">

                    Tidak ada pengumpulan yang sesuai dengan pencarian atau filter.

                </div>

            </div>


            <!-- ====================================================
                PAGINATION
            ===================================================== -->
            <div
                id="collectionPagination"
                class="pagination-area d-flex flex-wrap justify-content-between align-items-center gap-3">

                <div
                    id="collectionPageInfo"
                    class="page-info">

                    Menampilkan data

                </div>

                <div
                    id="collectionPaginationButtons"
                    class="d-flex flex-wrap align-items-center gap-1">

                </div>

            </div>

        </div>

    </div>
</div>

<!-- ============================================================
     ALERT CONTAINER
============================================================ -->
<div
    id="collectionAlertContainer"
    class="alert-container">
</div>

<!-- ============================================================
     MODALS
     BOOTSTRAP STYLE
     ICON SEJAJAR DENGAN KOLOM INPUT
============================================================ -->

<% collectionRows.forEach(r => { %>

    <!-- ========================================================
         EDIT PICKUP
    ========================================================= -->
    <div
        class="modal fade"
        id="editCollection<%= r.id %>"
        tabindex="-1"
        aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered modal-lg">

            <form
                class="modal-content border-0 shadow"
                method="post"
                action="/collection/<%= r.id %>/edit">

                <!-- HEADER -->
                <div class="modal-header">

                    <div>

                        <h5 class="modal-title fw-semibold">

                            <i class="bi bi-pencil-square text-success me-2"></i>

                            Edit Pickup
                            <%= r.code || "" %>

                        </h5>

                        <div class="small text-secondary mt-1">
                            Perbarui detail pengumpulan.
                        </div>

                    </div>

                    <button
                        type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                    </button>

                </div>


                <!-- BODY -->
                <div class="modal-body">

                    <!-- ==================================================
                         ALAMAT PICKUP
                    =================================================== -->
                    <div class="mb-3">

                        <label class="form-label fw-semibold">
                            Alamat Pickup
                        </label>

                        <div class="input-group">

                            <span class="input-group-text bg-light">
                                <i class="bi bi-geo-alt text-success"></i>
                            </span>

                            <textarea
                                class="form-control"
                                name="address"
                                id="editAddress_<%= r.id %>"
                                rows="3"
                                required
                                oninput="checkCityInAddress(<%= r.id %>)"
                                placeholder="Masukkan alamat pickup..."><%= r.address || "" %></textarea>

                        </div>

                    </div>

                    <!-- KOORDINAT GPS (LATITUDE & LONGITUDE) -->
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold small text-muted">Latitude</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light"><i class="bi bi-compass text-success"></i></span>
                                <input type="text" class="form-control" name="latitude" id="editLat_<%= r.id %>" value="<%= r.latitude || '' %>" placeholder="-6.7320">
                            </div>
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold small text-muted">Longitude</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light"><i class="bi bi-compass text-success"></i></span>
                                <input type="text" class="form-control" name="longitude" id="editLng_<%= r.id %>" value="<%= r.longitude || '' %>" placeholder="108.5523">
                            </div>
                        </div>
                        <div class="col-12 mt-1 d-flex flex-wrap gap-2">
                            <button type="button" class="btn btn-sm btn-light border text-success fw-semibold" onclick="autoDetectCoords(<%= r.id %>)">
                                <i class="bi bi-geo-alt-fill me-1"></i> Deteksi Kota dari Alamat (e.g. Cirebon)
                            </button>
                            <button type="button" class="btn btn-sm btn-light border text-primary fw-semibold" onclick="useGpsLocation(<%= r.id %>)">
                                <i class="bi bi-crosshair me-1"></i> Gunakan GPS Saya
                            </button>
                        </div>
                    </div>


                    <!-- ==================================================
                         PERUSAHAAN + TANGGAL
                    =================================================== -->
                    <div class="row g-3">

                        <!-- PERUSAHAAN -->
                        <div class="col-md-6">

                            <label class="form-label fw-semibold">
                                Perusahaan
                            </label>

                            <div class="input-group">

                                <span class="input-group-text bg-light">
                                    <i class="bi bi-building text-success"></i>
                                </span>

                                <select
                                    class="form-select"
                                    name="company_id">

                                    <option value="">
                                        -
                                    </option>

                                    <% safeCompanies.forEach(c => { %>

                                        <option
                                            value="<%= c.id %>"
                                            <%= Number(r.company_id) === Number(c.id)
                                                ? "selected"
                                                : ""
                                            %>>

                                            <%= c.name %>

                                        </option>

                                    <% }) %>

                                </select>

                            </div>

                        </div>


                        <!-- TANGGAL -->
                        <div class="col-md-6">

                            <label class="form-label fw-semibold">
                                Tanggal
                            </label>

                            <div class="input-group">

                                <span class="input-group-text bg-light">
                                    <i class="bi bi-calendar3 text-success"></i>
                                </span>

                                <input
                                    class="form-control"
                                    type="date"
                                    name="scheduled_date"
                                    value="<%= r.scheduled_date
                                        ? String(r.scheduled_date).slice(0,10)
                                        : ''
                                    %>"
                                >

                            </div>

                        </div>

                    </div>


                    <!-- ==================================================
                         JAM PICKUP
                    =================================================== -->
                    <div class="mt-3">

                        <label class="form-label fw-semibold">
                            Jam Pickup
                        </label>

                        <div class="input-group">

                            <span class="input-group-text bg-light">
                                <i class="bi bi-clock text-success"></i>
                            </span>

                            <input
                                class="form-control"
                                type="time"
                                name="scheduled_time"
                                value="<%= r.scheduled_time
                                    ? String(r.scheduled_time).slice(0,5)
                                    : ''
                                %>"
                            >

                        </div>

                    </div>


                    <!-- ==================================================
                         CATATAN
                    =================================================== -->
                    <div class="mt-3">

                        <label class="form-label fw-semibold">
                            Catatan
                        </label>

                        <div class="input-group">

                            <span class="input-group-text bg-light align-items-start pt-2">
                                <i class="bi bi-sticky text-success"></i>
                            </span>

                            <textarea
                                class="form-control"
                                name="request_note"
                                rows="3"
                                placeholder="Masukkan catatan..."><%= r.request_note || "" %></textarea>

                        </div>

                    </div>

                </div>


                <!-- FOOTER -->
                <div class="modal-footer">

                    <button
                        type="button"
                        class="btn btn-light border"
                        data-bs-dismiss="modal">

                        <i class="bi bi-x-lg me-1"></i>

                        Batal

                    </button>

                    <button
                        type="submit"
                        class="btn btn-success">

                        <i class="bi bi-check-lg me-1"></i>

                        Simpan

                    </button>

                </div>

            </form>

        </div>

    </div>


    <% if (isManager) { %>


        <!-- ====================================================
             UPDATE STATUS
        ===================================================== -->
        <div
            class="modal fade"
            id="statusCollection<%= r.id %>"
            tabindex="-1"
            aria-hidden="true">

            <div class="modal-dialog modal-dialog-centered modal-lg">

                <form
                    class="modal-content border-0 shadow"
                    method="post"
                    action="/collection/<%= r.id %>/status">

                    <!-- HEADER -->
                    <div class="modal-header">

                        <div>

                            <h5 class="modal-title fw-semibold">

                                <i class="bi bi-arrow-repeat text-success me-2"></i>

                                Update Status

                            </h5>

                            <div class="small text-secondary mt-1">
                                <%= r.code || "" %>
                            </div>

                        </div>

                        <button
                            type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                        </button>

                    </div>


                    <!-- BODY -->
                    <div class="modal-body">

                        <!-- ==================================================
                             STATUS
                        =================================================== -->
                        <div class="mb-3">

                            <label class="form-label fw-semibold">
                                Status
                            </label>

                            <div class="input-group">

                                <span class="input-group-text bg-light">
                                    <i class="bi bi-toggle2-on text-success"></i>
                                </span>

                                <select
                                    class="form-select"
                                    name="status">

                                    <% safeStatusList.forEach(s => { %>

                                        <option
                                            value="<%= s %>"
                                            <%= r.status === s
                                                ? "selected"
                                                : ""
                                            %>>

                                            <%= statusText[s] || s %>

                                        </option>

                                    <% }) %>

                                </select>

                            </div>

                        </div>


                        <!-- ==================================================
                             PETUGAS
                        =================================================== -->
                        <div class="mb-3">

                            <label class="form-label fw-semibold">
                                Petugas
                            </label>

                            <div class="input-group">

                                <span class="input-group-text bg-light">
                                    <i class="bi bi-person-badge text-success"></i>
                                </span>

                                <select
                                    class="form-select"
                                    name="assigned_to">

                                    <option value="">
                                        Petugas tetap
                                    </option>

                                    <% safeCollectors.forEach(c => { %>

                                        <option
                                            value="<%= c.id %>"
                                            <%= Number(r.assigned_to) === Number(c.id)
                                                ? "selected"
                                                : ""
                                            %>>

                                            <%= c.full_name %>

                                        </option>

                                    <% }) %>

                                </select>

                            </div>

                        </div>


                        <!-- ==================================================
                             ALASAN PENOLAKAN
                        =================================================== -->
                        <div>

                            <label class="form-label fw-semibold">
                                Alasan Penolakan
                            </label>

                            <div class="input-group">

                                <span class="input-group-text bg-light align-items-start pt-2">

                                    <i class="bi bi-exclamation-triangle text-danger"></i>

                                </span>

                                <textarea
                                    class="form-control"
                                    name="rejected_reason"
                                    rows="3"
                                    placeholder="Isi jika pickup ditolak..."><%= r.rejected_reason || "" %></textarea>

                            </div>

                        </div>

                    </div>


                    <!-- FOOTER -->
                    <div class="modal-footer">

                        <button
                            type="button"
                            class="btn btn-light border"
                            data-bs-dismiss="modal">

                            <i class="bi bi-x-lg me-1"></i>

                            Batal

                        </button>

                        <button
                            type="submit"
                            class="btn btn-success">

                            <i class="bi bi-check-lg me-1"></i>

                            Simpan Status

                        </button>

                    </div>

                </form>

            </div>

        </div>


        <!-- ====================================================
             HASIL TIMBANG
        ===================================================== -->
        <div
            class="modal fade"
            id="itemCollection<%= r.id %>"
            tabindex="-1"
            aria-hidden="true">

            <div class="modal-dialog modal-dialog-centered modal-lg">

                <form
                    class="modal-content border-0 shadow"
                    method="post"
                    enctype="multipart/form-data"
                    action="/collection/<%= r.id %>/items">

                    <!-- HEADER -->
                    <div class="modal-header">

                        <div>

                            <h5 class="modal-title fw-semibold">

                                <i class="bi bi-speedometer2 text-success me-2"></i>

                                Tambah Hasil Timbang

                            </h5>

                            <div class="small text-secondary mt-1">

                                Pickup <%= r.code || "" %>

                            </div>

                        </div>

                        <button
                            type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                        </button>

                    </div>


                    <!-- BODY -->
                    <div class="modal-body">

                        <!-- ==================================================
                             JENIS SAMPAH
                        =================================================== -->
                        <div class="mb-3">

                            <label class="form-label fw-semibold">
                                Jenis Sampah
                            </label>

                            <div class="input-group">

                                <span class="input-group-text bg-light">

                                    <i class="bi bi-trash3 text-success"></i>

                                </span>

                                <select
                                    class="form-select"
                                    name="waste_type_id"
                                    required>

                                    <option value="">
                                        Pilih jenis sampah
                                    </option>

                                    <% safeTypes.forEach(t => { %>

                                        <option
                                            value="<%= t.id %>">

                                            <%= t.code %>
                                            —
                                            <%= t.name %>
                                            ·
                                            Rp <%= Number(
                                                t.price_per_unit || 0
                                            ).toLocaleString("id-ID") %>
                                            /
                                            <%= t.unit %>

                                        </option>

                                    <% }) %>

                                </select>

                            </div>

                        </div>


                        <!-- ==================================================
                             BERAT + HARGA
                        =================================================== -->
                        <div class="row g-3">

                            <!-- BERAT -->
                            <div class="col-md-6">

                                <label class="form-label fw-semibold">
                                    Berat
                                </label>

                                <div class="input-group">

                                    <span class="input-group-text bg-light">

                                        <i class="bi bi-speedometer2 text-success"></i>

                                    </span>

                                    <input
                                        class="form-control"
                                        type="number"
                                        step="0.001"
                                        min="0.001"
                                        name="weight"
                                        placeholder="0.000"
                                        required
                                    >

                                    <span class="input-group-text">
                                        kg
                                    </span>

                                </div>

                            </div>


                            <!-- HARGA -->
                            <div class="col-md-6">

                                <label class="form-label fw-semibold">
                                    Harga / Unit
                                </label>

                                <div class="input-group">

                                    <span class="input-group-text bg-light">

                                        <i class="bi bi-cash-stack text-success"></i>

                                    </span>

                                    <input
                                        class="form-control"
                                        type="number"
                                        step="0.01"
                                        name="price_per_unit"
                                        placeholder="0"
                                    >

                                </div>

                            </div>

                        </div>


                        <!-- ==================================================
                             CATATAN
                        =================================================== -->
                        <div class="mt-3">

                            <label class="form-label fw-semibold">
                                Catatan
                            </label>

                            <div class="input-group">

                                <span class="input-group-text bg-light align-items-start pt-2">

                                    <i class="bi bi-sticky text-success"></i>

                                </span>

                                <textarea
                                    class="form-control"
                                    name="notes"
                                    rows="3"
                                    placeholder="Catatan item timbang..."></textarea>

                            </div>

                        </div>

                        <!-- ==================================================
                             FOTO SAMPAH / BUKTI TIMBANG
                        =================================================== -->
                        <div class="mt-3">

                            <label class="form-label fw-semibold">
                                Foto Sampah / Bukti Timbang
                            </label>

                            <div class="input-group">

                                <span class="input-group-text bg-light">
                                    <i class="bi bi-camera text-success"></i>
                                </span>

                                <input
                                    class="form-control"
                                    type="file"
                                    name="waste_photo"
                                    accept="image/*"
                                    capture="environment"
                                >

                            </div>

                            <div class="form-text">
                                Unggah foto sampah atau penimbangan (JPG, PNG, WEBP). Bisa langsung gunakan kamera HP.
                            </div>

                        </div>

                    </div>


                    <!-- FOOTER -->
                    <div class="modal-footer">

                        <button
                            type="button"
                            class="btn btn-light border"
                            data-bs-dismiss="modal">

                            <i class="bi bi-x-lg me-1"></i>

                            Batal

                        </button>

                        <button
                            type="submit"
                            class="btn btn-success">

                            <i class="bi bi-check-lg me-1"></i>

                            Simpan Timbangan

                        </button>

                    </div>

                </form>

            </div>

        </div>


    <% } %>


<% }) %>


<% /* TRACKING MODAL UNTUK SEMUA ROLE (ADMIN, PETUGAS & NASABAH) */ %>
<% collectionRows.forEach(r => { %>

<!-- ========================================================
     TRACKING PICKUP MODAL
======================================================== -->
<div
    class="modal fade ios-tracking-modal"
    id="trackingCollection<%= r.id %>"
    tabindex="-1"
    aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-lg">

        <div class="modal-content">

            <!-- =================================================
                 HEADER
            ================================================== -->
            <div class="ios-tracking-header">

                <div class="ios-tracking-header-inner">

                    <div class="ios-tracking-title-wrap">

                        <h5 class="ios-tracking-title">
                            <i class="bi bi-truck"></i>
                            Tracking Pengiriman
                        </h5>

                        <div class="ios-tracking-subtitle">
                            Pantau proses pickup
                            <strong><%= r.code || "-" %></strong>
                        </div>

                    </div>

                    <button
                        type="button"
                        class="ios-close-btn"
                        data-bs-dismiss="modal"
                        aria-label="Close">

                        <i class="bi bi-x-lg"></i>

                    </button>

                </div>

            </div>


            <!-- =================================================
                 BODY
            ================================================== -->
            <div class="ios-tracking-body">

                <%
                    const trackingStatus =
                        String(r.status || "").toLowerCase();

                    const trackingIndex =
                        trackingStageIndex(trackingStatus);

                    const trackingPercent =
                        trackingProgress(trackingStatus);

                    const trackingStages = [
                        {
                            key: "diajukan",
                            title: "Pickup Diajukan",
                            desc: "Permintaan pickup sudah diterima sistem."
                        },
                        {
                            key: "dijadwalkan",
                            title: "Pickup Dijadwalkan",
                            desc: "Jadwal pengambilan sudah ditentukan."
                        },
                        {
                            key: "diambil",
                            title: "Sampah Diambil",
                            desc: "Petugas sudah melakukan pengambilan."
                        },
                        {
                            key: "ditimbang",
                            title: "Sedang / Sudah Ditimbang",
                            desc: "Hasil pengambilan sedang diproses dan ditimbang."
                        },
                        {
                            key: "selesai",
                            title: "Proses Selesai",
                            desc: "Pengumpulan sudah selesai diproses."
                        }
                    ];
                %>


                <!-- =================================================
                     SUMMARY
                ================================================== -->
                <div class="ios-tracking-summary">

                    <div class="d-flex flex-wrap justify-content-between align-items-start">

                        <div>

                            <div class="ios-code-label">
                                Kode Pickup
                            </div>

                            <div class="ios-tracking-code">

                                <i class="bi bi-upc"></i>

                                <%= r.code || "-" %>

                            </div>

                            <div class="ios-company">

                                <i class="bi bi-building me-1"></i>

                                <%= r.company_name || "Perusahaan belum dipilih" %>

                            </div>

                        </div>


                        <!-- STATUS -->
                        <span class="ios-status <%= statusClass(r.status) %>">

                            <i class="bi <%= statusIcon(r.status) %>"></i>

                            <%= statusText[r.status] || r.status || "Belum ada status" %>

                        </span>

                    </div>


                    <!-- =================================================
                         PROGRESS
                    ================================================== -->
                    <div class="ios-progress-section">

                        <div class="d-flex justify-content-between align-items-center">

                            <span class="ios-progress-label">
                                Progress proses
                            </span>

                            <strong class="ios-progress-percent">
                                <%= trackingPercent %>%
                            </strong>

                        </div>


                        <div class="ios-progress">

                            <div
                                style="width:<%= trackingPercent %>%">
                            </div>

                        </div>

                    </div>


                    <!-- =================================================
                         TIMELINE
                    ================================================== -->
                    <div class="ios-timeline">

                        <% trackingStages.forEach((stage, stageIndex) => { %>

                            <%
                                const stageClass =
                                    trackingStageClass(
                                        r.status,
                                        stage.key
                                    );

                                const isCurrent =
                                    trackingStageIndex(r.status) === stageIndex;

                                const normalizedStageClass =
                                    String(stageClass || "").toLowerCase();

                                const isCompleted =
                                    normalizedStageClass.includes("completed") ||
                                    normalizedStageClass.includes("complete") ||
                                    normalizedStageClass.includes("done");

                            %>

                            <div
                                class="ios-timeline-step
                                    <%= isCompleted ? 'completed' : '' %>
                                    <%= isCurrent ? 'current' : '' %>">

                                <% if (stageIndex < trackingStages.length - 1) { %>

                                    <div class="ios-timeline-line"></div>

                                <% } %>


                                <!-- ICON -->
                                <div class="ios-timeline-icon">

                                    <i class="bi <%= trackingStageIcon(stage.key) %>"></i>

                                </div>


                                <!-- CONTENT -->
                                <div class="ios-timeline-content">

                                    <div class="ios-step-title">

                                        <%= stage.title %>

                                        <% if (isCurrent) { %>

                                            <span class="ios-current-badge">

                                                Posisi Sekarang

                                            </span>

                                        <% } %>

                                    </div>


                                    <div class="ios-step-desc">

                                        <%= stage.desc %>

                                    </div>

                                </div>

                            </div>

                        <% }) %>

                    </div>

                </div>


                <!-- =================================================
                     REJECTED
                ================================================== -->
                <% if (trackingStatus === "ditolak") { %>

                    <div class="ios-alert rejected mt-3">

                        <div class="fw-semibold">

                            <i class="bi bi-x-circle me-1"></i>

                            Pickup ini ditolak.

                        </div>

                        <% if (r.rejected_reason) { %>

                            <div class="mt-1">

                                Alasan:
                                <%= r.rejected_reason %>

                            </div>

                        <% } %>

                    </div>

                <% } %>


                <!-- =================================================
                     CANCELLED
                ================================================== -->
                <% if (trackingStatus === "dibatalkan") { %>

                    <div class="ios-alert cancelled mt-3">

                        <i class="bi bi-slash-circle me-1"></i>

                        Pickup ini dibatalkan dan proses tidak dilanjutkan.

                    </div>

                <% } %>


                <!-- =================================================
                     INFORMATION CARDS
                ================================================== -->
                <div class="row g-2 mt-2">


                    <!-- TANGGAL -->
                    <div class="col-6 col-md-3">

                        <div class="ios-info-card">

                            <div class="ios-info-label">
                                Tanggal Pickup
                            </div>

                            <div class="ios-info-value">

                                <i class="bi bi-calendar3 me-1"></i>

                                <%= fmtDate(r.scheduled_date) %>

                            </div>

                        </div>

                    </div>


                    <!-- JAM -->
                    <div class="col-6 col-md-3">

                        <div class="ios-info-card">

                            <div class="ios-info-label">
                                Jam Pickup
                            </div>

                            <div class="ios-info-value">

                                <i class="bi bi-clock me-1"></i>

                                <%= r.scheduled_time
                                    ? String(r.scheduled_time).slice(0,5)
                                    : "-" %>

                            </div>

                        </div>

                    </div>


                    <!-- BERAT -->
                    <div class="col-6 col-md-3">

                        <div class="ios-info-card">

                            <div class="ios-info-label">
                                Berat
                            </div>

                            <div class="ios-info-value">

                                <i class="bi bi-box-seam me-1"></i>

                                <%= fmtNumber(r.total_weight, 3) %> kg

                            </div>

                        </div>

                    </div>


                    <!-- NILAI -->
                    <div class="col-6 col-md-3">

                        <div class="ios-info-card">

                            <div class="ios-info-label">
                                Nilai
                            </div>

                            <div class="ios-info-value">

                                <i class="bi bi-cash-stack me-1"></i>

                                Rp <%= fmtNumber(r.total_value) %>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     PETA LOKASI PENJEMPUTAN & KURIR (LEAFLET)
                ================================================== -->
                <div class="mt-3 p-3 bg-white border rounded-3 shadow-sm">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div class="fw-bold text-dark" style="font-size:13px;">
                            <i class="bi bi-geo-alt-fill text-danger me-1"></i> Peta Titik Penjemputan
                        </div>
                        <span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size:11px;">
                            <i class="bi bi-pin-map me-1"></i> <%= r.address ? (r.address.length > 30 ? r.address.slice(0, 30) + '...' : r.address) : 'Lokasi Terpetakan' %>
                        </span>
                    </div>

                    <div
                        id="trackingMap_<%= r.id %>"
                        class="leaflet-tracking-map"
                        data-id="<%= r.id %>"
                        data-lat="<%= r.latitude || '-6.2088' %>"
                        data-lng="<%= r.longitude || '106.8456' %>"
                        data-code="<%= r.code || '-' %>"
                        data-nasabah="<%= r.full_name || '-' %>"
                        data-address="<%= r.address || 'Alamat Pickup' %>"
                        data-status="<%= r.status || 'diajukan' %>"
                        data-collector="<%= r.collector_name || 'Petugas Pengumpulan' %>"
                        style="height: 230px; width: 100%; border-radius: 10px; border: 1px solid #e2e8f0; z-index: 1;"
                    ></div>

                    <div class="d-flex justify-content-between align-items-center mt-2 text-muted" style="font-size:11px;">
                        <div>
                            <i class="bi bi-geo text-danger"></i> Titik Koordinat: <strong><%= r.latitude ? (Number(r.latitude).toFixed(4) + ', ' + Number(r.longitude).toFixed(4)) : 'Standar Wilayah' %></strong>
                        </div>
                        <div>
                            <i class="bi bi-truck text-success"></i> Kurir: <strong><%= r.collector_name || 'Menunggu Penugasan' %></strong>
                        </div>
                    </div>
                </div>


                <!-- =================================================
                     FOTO & RINCIAN HASIL TIMBANG / SAMPAH
                ================================================== -->
                <% if (r.items && r.items.length) { %>
                    <div class="mt-3">
                        <div class="fw-semibold small text-dark mb-2 d-flex align-items-center gap-1">
                            <i class="bi bi-camera-fill text-success"></i>
                            <span>Dokumentasi Sampah & Rincian Timbang (<%= r.items.length %> item)</span>
                        </div>
                        <div class="row g-2">
                            <% r.items.forEach(it => { %>
                                <div class="col-12 col-md-6">
                                    <div class="border rounded-3 p-2 bg-white d-flex align-items-center gap-2 shadow-sm">
                                        <% if (it.photo_url) { %>
                                            <a href="<%= it.photo_url %>" target="_blank" title="Klik untuk perbesar foto" class="flex-shrink-0">
                                                <img src="<%= it.photo_url %>" alt="Foto Sampah" class="rounded border" style="width: 58px; height: 58px; object-fit: cover;">
                                            </a>
                                        <% } else { %>
                                            <div class="rounded border bg-light text-muted d-grid place-items-center flex-shrink-0" style="width: 58px; height: 58px;">
                                                <i class="bi bi-trash3 text-success fs-5"></i>
                                            </div>
                                        <% } %>
                                        <div class="flex-grow-1 overflow-hidden">
                                            <div class="fw-bold text-truncate text-dark" style="font-size: 13px;"><%= it.waste_name %></div>
                                            <div class="text-success fw-semibold" style="font-size: 11px;">
                                                <%= fmtNumber(it.weight, 3) %> <%= it.unit || 'kg' %> · Rp <%= fmtNumber(it.subtotal) %>
                                            </div>
                                            <% if (it.notes) { %>
                                                <div class="small text-muted text-truncate" style="font-size: 11px;"><%= it.notes %></div>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                <% } else if (r.photo_url) { %>
                    <div class="mt-3 border rounded-3 p-3 bg-white text-center shadow-sm">
                        <div class="fw-semibold small text-dark mb-2 text-start d-flex align-items-center gap-1">
                            <i class="bi bi-camera-fill text-success"></i>
                            <span>Foto Dokumentasi Pengumpulan</span>
                        </div>
                        <a href="<%= r.photo_url %>" target="_blank" title="Klik untuk lihat ukuran penuh">
                            <img src="<%= r.photo_url %>" alt="Foto Pickup" class="img-fluid rounded border" style="max-height: 220px; object-fit: contain;">
                        </a>
                    </div>
                <% } %>


                <!-- =================================================
                     NOTE
                ================================================== -->
                <div class="alert alert-light border rounded-4 mt-3 mb-0 d-flex align-items-start gap-2" role="alert">
                    <i class="bi bi-info-circle-fill text-success fs-5 flex-shrink-0"></i>
                    <span class="small text-secondary">
                        Mohon pantau aktivitas pickup ini melalui informasi status yang ditampilkan.
                        Informasi tracking akan menunjukkan perkembangan dan status pickup yang sedang berlangsung.
                    </span>
                </div>

            </div>


            <!-- =================================================
                 FOOTER
            ================================================== -->
            <div class="ios-tracking-footer">

                <button
                    type="button"
                    class="ios-btn-close"
                    data-bs-dismiss="modal">

                    <i class="bi bi-x-lg me-1"></i>

                    Tutup

                </button>

            </div>

        </div>

    </div>

</div>

<% }) %>

