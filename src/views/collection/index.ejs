<%
/* ============================================================
   UI-ONLY TRACKING HELPERS
   Tidak membuat / mengubah database. Tracking hanya membaca
   status pickup yang sudah tersedia pada data `r`.
============================================================ */

function trackingStageIndex(status) {
    const s = String(status || "").toLowerCase();
    const stages = ["diajukan", "dijadwalkan", "diambil", "ditimbang", "selesai"];
    const idx = stages.indexOf(s);
    return idx >= 0 ? idx : -1;
}

function trackingProgress(status) {
    const idx = trackingStageIndex(status);
    if (idx < 0) return 0;
    return Math.round(((idx + 1) / 5) * 100);
}

function trackingStageClass(status, stage) {
    const current = trackingStageIndex(status);
    const target = trackingStageIndex(stage);
    if (current < 0 || target < 0) return "";
    if (target < current) return "completed";
    if (target === current) return "current";
    return "pending";
}

function trackingStageIcon(stage) {
    switch (stage) {
        case "diajukan": return "bi-send";
        case "dijadwalkan": return "bi-calendar-check";
        case "diambil": return "bi-truck";
        case "ditimbang": return "bi-speedometer2";
        case "selesai": return "bi-check-circle";
        default: return "bi-circle";
    }
}
