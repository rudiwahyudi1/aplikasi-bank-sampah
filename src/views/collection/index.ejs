/* ============================================================
   SAFE DATA
============================================================ */

const collectionRows =
    (typeof rows !== "undefined" && Array.isArray(rows))
        ? rows
        : [];

const currentUser =
    (typeof user !== "undefined" && user)
        ? user
        : null;

const isNasabah =
    currentUser?.role === "nasabah";

const isManager =
    [
        "superadmin",
        "admin_pengelola",
        "petugas_pengumpulan"
    ].includes(currentUser?.role);

const statusText = {
    diajukan: "Diajukan",
    dijadwalkan: "Dijadwalkan",
    diambil: "Diambil",
    ditimbang: "Ditimbang",
    selesai: "Selesai",
    ditolak: "Ditolak",
    dibatalkan: "Dibatalkan"
};

const safeStatusList =
    (typeof statusList !== "undefined" && Array.isArray(statusList))
        ? statusList
        : Object.keys(statusText);

const safeCompanies =
    (typeof companies !== "undefined" && Array.isArray(companies))
        ? companies
        : [];

const safeCollectors =
    (typeof collectors !== "undefined" && Array.isArray(collectors))
        ? collectors
        : [];

const safeTypes =
    (typeof types !== "undefined" && Array.isArray(types))
        ? types
        : [];

const safeSummary =
    (typeof summary !== "undefined" && summary)
        ? summary
        : {};

const safeFilters =
    (typeof filters !== "undefined" && filters)
        ? filters
        : {
            keyword: "",
            status: "",
            date: "",
            limit: 10
        };


/* ============================================================
   HELPERS
============================================================ */

function fmtDate(v) {

    if (!v) return "-";

    const s = String(v).slice(0, 10);

    const a = s.split("-");

    if (a.length === 3) {

        return `${a[2]}-${a[1]}-${a[0]}`;

    }

    try {

        return new Date(v).toLocaleDateString("id-ID");

    } catch (e) {

        return "-";

    }
}


function fmtNumber(v, decimals = 0) {

    return Number(v || 0).toLocaleString(
        "id-ID",
        {
            maximumFractionDigits: decimals
        }
    );

}


function statusClass(status) {

    switch (String(status || "").toLowerCase()) {

        case "diajukan":
            return "status-requested";

        case "dijadwalkan":
            return "status-scheduled";

        case "diambil":
            return "status-picked";

        case "ditimbang":
            return "status-weighed";

        case "selesai":
            return "status-done";

        case "ditolak":
            return "status-rejected";

        case "dibatalkan":
            return "status-cancelled";

        default:
            return "status-default";

    }

}


function statusIcon(status) {

    switch (String(status || "").toLowerCase()) {

        case "diajukan":
            return "bi-send";

        case "dijadwalkan":
            return "bi-calendar-check";

        case "diambil":
            return "bi-truck";

        case "ditimbang":
            return "bi-speedometer2";

        case "selesai":
            return "bi-check-circle";

        case "ditolak":
            return "bi-x-circle";

        case "dibatalkan":
            return "bi-slash-circle";

        default:
            return "bi-circle";

    }

}
