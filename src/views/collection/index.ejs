let currentReceiptData = null;

async function openReceiptThermal(id) {
    try {
        const res = await fetch('/collection/api/receipt/' + id);
        const json = await res.json();
        if (!json.success || !json.receipt) {
            alert("Gagal mengambil data struk timbangan: " + (json.message || "Data tidak ditemukan"));
            return;
        }

        const r = json.receipt;
        currentReceiptData = r;

        document.getElementById("receiptBankName").textContent = r.settings.bank_name;
        document.getElementById("receiptOfficeAddr").textContent = r.settings.office_address;
        document.getElementById("receiptPhone").textContent = "WA: " + r.settings.contact_whatsapp;
        document.getElementById("receiptCode").textContent = r.code || ('#CR-' + r.id);
        
        const dateStr = r.scheduled_date ? new Date(r.scheduled_date).toLocaleDateString('id-ID', { day: '2-digit', month: '2-digit', year: 'numeric' }) : new Date(r.created_at).toLocaleDateString('id-ID');
        document.getElementById("receiptDate").textContent = dateStr + " " + (r.scheduled_time ? String(r.scheduled_time).slice(0,5) : "");
        document.getElementById("receiptCustomer").textContent = r.customer_name || "-";
        document.getElementById("receiptCustomerPhone").textContent = r.customer_phone || "-";
        document.getElementById("receiptCollector").textContent = r.collector_name || "Petugas Lapangan";

        // Render items
        const tbody = document.getElementById("receiptItemsBody");
        tbody.innerHTML = "";

        let totalWeight = 0;
        let totalVal = 0;

        if (r.items && r.items.length > 0) {
            r.items.forEach(it => {
                const w = Number(it.weight || 0);
                const sub = Number(it.subtotal || 0);
                totalWeight += w;
                totalVal += sub;

                const tr = document.createElement("tr");
                tr.innerHTML = `
                    <td style="padding: 2px 0;">${it.waste_name || it.waste_code || 'Sampah'}</td>
                    <td style="text-align: right; padding: 2px 0;">${w.toLocaleString('id-ID', { maximumFractionDigits: 2 })} ${it.waste_unit || 'kg'}</td>
                    <td style="text-align: right; padding: 2px 0;">${Number(it.price_per_unit || 0).toLocaleString('id-ID')}</td>
                    <td style="text-align: right; padding: 2px 0; font-weight: bold;">${sub.toLocaleString('id-ID')}</td>
                `;
                tbody.appendChild(tr);
            });
        } else {
            totalWeight = Number(r.total_weight || 0);
            totalVal = Number(r.total_value || 0);
            const tr = document.createElement("tr");
            tr.innerHTML = `
                <td style="padding: 2px 0;">Setoran Sampah</td>
                <td style="text-align: right; padding: 2px 0;">${totalWeight.toLocaleString('id-ID', { maximumFractionDigits: 2 })} kg</td>
                <td style="text-align: right; padding: 2px 0;">-</td>
                <td style="text-align: right; padding: 2px 0; font-weight: bold;">${totalVal.toLocaleString('id-ID')}</td>
            `;
            tbody.appendChild(tr);
        }

        document.getElementById("receiptTotalWeight").textContent = totalWeight.toLocaleString('id-ID', { maximumFractionDigits: 2 }) + " kg";
        document.getElementById("receiptTotalValue").textContent = "Rp " + totalVal.toLocaleString('id-ID');
        document.getElementById("receiptCustomerBalance").textContent = "Rp " + Number(r.customer_balance || 0).toLocaleString('id-ID');
        document.getElementById("receiptStatus").textContent = (r.status === 'selesai' ? 'LUNAS (MASUK SALDO)' : r.status.toUpperCase());

        const modal = new bootstrap.Modal(document.getElementById("modalReceiptThermal"));
        modal.show();
    } catch (err) {
        alert("Gagal memuat struk: " + err.message);
    }
}

function printThermalReceipt() {
    window.print();
}

function sendReceiptWhatsApp() {
    if (!currentReceiptData) return;
    const r = currentReceiptData;
    let text = `🧾 *NOTA SETORAN BANK SAMPAH*\n*${r.settings.bank_name}*\n${r.settings.office_address}\n--------------------------------\n`;
    text += `No. Nota : ${r.code || ('#CR-' + r.id)}\n`;
    text += `Tanggal  : ${r.scheduled_date ? new Date(r.scheduled_date).toLocaleDateString('id-ID') : new Date().toLocaleDateString('id-ID')}\n`;
    text += `Nasabah  : ${r.customer_name}\n`;
    text += `Petugas  : ${r.collector_name || 'Petugas Lapangan'}\n`;
    text += `--------------------------------\n`;
    
    if (r.items && r.items.length > 0) {
        r.items.forEach((it, idx) => {
            text += `${idx + 1}. ${it.waste_name}: ${Number(it.weight).toLocaleString('id-ID')} kg @Rp ${Number(it.price_per_unit).toLocaleString('id-ID')} = Rp ${Number(it.subtotal).toLocaleString('id-ID')}\n`;
        });
    } else {
        text += `Total Berat: ${Number(r.total_weight || 0).toLocaleString('id-ID')} kg\n`;
    }
    
    text += `--------------------------------\n`;
    text += `*TOTAL NILAI*: Rp ${Number(r.total_value || 0).toLocaleString('id-ID')}\n`;
    text += `*SALDO TERKINI*: Rp ${Number(r.customer_balance || 0).toLocaleString('id-ID')}\n`;
    text += `--------------------------------\n`;
    text += `Terima kasih telah memilah sampah dan merawat kelestarian lingkungan hidup bersama kami! 🌱`;

    const phone = r.customer_phone ? r.customer_phone.replace(/^0/, '62').replace(/[^0-9]/g, '') : '';
    const url = phone ? `https://api.whatsapp.com/send?phone=${phone}&text=${encodeURIComponent(text)}` : `https://api.whatsapp.com/send?text=${encodeURIComponent(text)}`;
    window.open(url, '_blank');
}

/* ================================================================
   FITUR: SCANNER KAMERA QR CODE
================================================================ */
let html5QrScanner = null;

function openQrScannerModal() {
    const modalEl = document.getElementById("modalQrScanner");
    const modal = new bootstrap.Modal(modalEl);
    modal.show();

    document.getElementById("scanResultCard").style.display = "none";
    document.getElementById("scanErrorMessage").style.display = "none";

    // Muat script HTML5-QRCode jika belum ada
    if (typeof Html5Qrcode === "undefined") {
        const script = document.createElement("script");
        script.src = "https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js";
        script.onload = () => startScanner();
        document.body.appendChild(script);
    } else {
        startScanner();
    }
}

function startScanner() {
    try {
        if (html5QrScanner) {
            html5QrScanner.stop().catch(() => {}).then(() => {
                initScannerInstance();
            });
        } else {
            initScannerInstance();
        }
    } catch (e) {
        console.error("Scanner error:", e);
    }
}

function initScannerInstance() {
    html5QrScanner = new Html5Qrcode("qrVideoRegion");
    const config = { fps: 10, qrbox: { width: 220, height: 220 } };

    html5QrScanner.start(
        { facingMode: "environment" },
        config,
        (decodedText) => {
            onQrCodeSuccess(decodedText);
        },
        (errorMessage) => {}
    ).catch(err => {
        document.getElementById("scanErrorMessage").style.display = "block";
        document.getElementById("scanErrorMessage").textContent = "Tidak dapat mengakses kamera: " + err;
    });
}

function stopScanner() {
    if (html5QrScanner) {
        html5QrScanner.stop().then(() => {
            html5QrScanner = null;
        }).catch(() => {});
    }
}

async function onQrCodeSuccess(decodedText) {
    stopScanner();

    try {
        // Ekstrak ID atau format BS-2026-XXXX
        let query = decodedText.trim();
        const match = query.match(/BS-\d{4}-\d+/i);
        if (match) query = match[0];

        // Cari di input search
        const searchInput = document.getElementById("collectionSearch");
        if (searchInput) {
            searchInput.value = query;
        }

        // Tampilkan result di modal
        document.getElementById("scanResultCard").style.display = "block";
        document.getElementById("scannedCodeBadge").textContent = decodedText;

        // Auto submit filter untuk menyaring pickup nasabah ini
        const filterForm = document.getElementById("collectionFilterForm");
        document.getElementById("btnApplyScanFilter").onclick = () => {
            if (filterForm) filterForm.submit();
        };

    } catch (e) {
        console.error("Scan processing error:", e);
    }
}

document.getElementById("modalQrScanner")?.addEventListener("hidden.bs.modal", () => {
    stopScanner();
});
</script>

