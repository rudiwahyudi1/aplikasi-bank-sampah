<script>
function setColExportAction(mode) {
    const form = document.getElementById("collectionExportForm");
    if (!form) return;
    if (mode === "pdf") {
        form.action = "/collection/export/preview-pdf";
        form.target = "_blank";
    } else {
        form.action = "/collection/export/excel";
        form.target = "_self";
    }
}
</script>

<script>

document.addEventListener(
    "DOMContentLoaded",
    function () {


        /* ====================================================
           ELEMENTS
        ==================================================== */

        const rows =
            Array.from(
                document.querySelectorAll(
                    ".collection-row"
                )
            );

        const searchInput =
            document.getElementById(
                "collectionSearch"
            );

        const clearButton =
            document.getElementById(
                "clearCollectionSearch"
            );

        const statusInput =
            document.getElementById(
                "collectionStatus"
            );

        const dateInput =
            document.getElementById(
                "collectionDate"
            );

        const limitInput =
            document.getElementById(
                "collectionLimit"
            );

        const emptyState =
            document.getElementById(
                "collectionEmpty"
            );

        const pagination =
            document.getElementById(
                "collectionPagination"
            );

        const pageInfo =
            document.getElementById(
                "collectionPageInfo"
            );

        const paginationButtons =
            document.getElementById(
                "collectionPaginationButtons"
            );

        const resultCount =
            document.getElementById(
                "collectionResultCount"
            );


        /* ====================================================
           CONFIG
        ==================================================== */

        let currentPage = 1;

        let pageSize =
            parseInt(
                limitInput?.value || 10,
                10
            );

        let filteredRows = [...rows];


        /* ====================================================
           ALERT
        ==================================================== */

        function showAlert(
            message,
            type = "warning",
            icon = "bi-exclamation-circle"
        ) {

            const container =
                document.getElementById(
                    "collectionAlertContainer"
                );

            if (!container) return;


            const alertId =
                "collectionAlert_" +
                Date.now();


            container.insertAdjacentHTML(
                "beforeend",
                `
                    <div
                        id="${alertId}"
                        class="alert alert-${type} alert-dismissible fade show collection-alert d-flex align-items-center gap-2"
                        role="alert">

                        <i class="bi ${icon} fs-5"></i>

                        <div>
                            ${message}
                        </div>

                        <button
                            type="button"
                            class="btn-close ms-auto"
                            data-bs-dismiss="alert">
                        </button>

                    </div>
                `
            );


            setTimeout(
                function () {

                    const element =
                        document.getElementById(
                            alertId
                        );

                    if (element) {

                        const alert =
                            bootstrap.Alert
                                .getOrCreateInstance(
                                    element
                                );

                        alert.close();

                    }

                },
                3500
            );

        }


        /* ====================================================
           ESCAPE HTML
        ==================================================== */

        function escapeHtml(value) {

            return String(value)

                .replace(
                    /&/g,
                    "&amp;"
                )

                .replace(
                    /</g,
                    "&lt;"
                )

                .replace(
                    />/g,
                    "&gt;"
                )

                .replace(
                    /"/g,
                    "&quot;"
                )

                .replace(
                    /'/g,
                    "&#039;"
                );

        }


        /* ====================================================
           FILTER LOCAL
        ==================================================== */

        function applyLocalFilter(
            showEmptyAlert = false
        ) {

            const keyword =
                String(
                    searchInput?.value || ""
                )
                .trim()
                .toLowerCase();


            const status =
                String(
                    statusInput?.value || ""
                )
                .trim()
                .toLowerCase();


            /* Clear button */

            if (clearButton) {

                clearButton.style.display =
                    keyword
                        ? "flex"
                        : "none";

            }


            filteredRows =
                rows.filter(
                    function (row) {

                        const searchData =
                            String(
                                row.dataset.search || ""
                            )
                            .toLowerCase();


                        /* Search */

                        if (
                            keyword &&
                            !searchData.includes(
                                keyword
                            )
                        ) {

                            return false;

                        }


                        /* Status */

                        if (status) {

                            const rowStatus =
                                String(
                                    row.dataset.search || ""
                                ).toLowerCase();

                            /*
                             * Status ada di search dataset,
                             * tetapi kita cek dari text status
                             * agar lebih aman.
                             */

                            const statusElement =
                                row.querySelector(
                                    ".ios-status"
                                );

                            const currentStatus =
                                String(
                                    statusElement?.textContent || ""
                                )
                                .trim()
                                .toLowerCase();


                            const selectedStatusText =
                                String(
                                    document.querySelector(
                                        "#collectionStatus option:checked"
                                    )?.textContent || ""
                                )
                                .trim()
                                .toLowerCase();


                            if (
                                selectedStatusText &&
                                selectedStatusText !==
                                    "semua status" &&
                                !currentStatus.includes(
                                    selectedStatusText
                                )
                            ) {

                                return false;

                            }

                        }


                        return true;

                    }
                );


            currentPage = 1;


            render();


            /* Alert jika search kosong */

            if (
                showEmptyAlert &&
                keyword &&
                filteredRows.length === 0
            ) {

                showAlert(
                    `Data pengumpulan dengan kata kunci "<strong>${escapeHtml(keyword)}</strong>" tidak ditemukan.`,
                    "warning",
                    "bi-search"
                );

            }


            /* Alert jika filter status kosong */

            if (
                showEmptyAlert &&
                status &&
                filteredRows.length === 0
            ) {

                const selectedText =
                    document.querySelector(
                        "#collectionStatus option:checked"
                    )?.textContent?.trim() ||
                    "status tersebut";


                showAlert(
                    `Tidak ada data dengan status <strong>${escapeHtml(selectedText)}</strong>.`,
                    "warning",
                    "bi-funnel"
                );

            }

        }


        /* ====================================================
           RENDER
        ==================================================== */

        function render() {

            rows.forEach(
                function (row) {

                    row.style.display =
                        "none";

                }
            );


            /* EMPTY */

            if (
                filteredRows.length === 0
            ) {

                if (emptyState) {

                    emptyState.style.display =
                        "block";

                }

                if (pagination) {

                    pagination.style.display =
                        "none";

                }

                if (pageInfo) {

                    pageInfo.textContent =
                        "Tidak ada data";

                }

                if (resultCount) {

                    resultCount.textContent =
                        "0 data";

                }

                return;

            }


            /* SHOW EMPTY OFF */

            if (emptyState) {

                emptyState.style.display =
                    "none";

            }

            if (pagination) {

                pagination.style.display =
                    "flex";

            }


            const totalPages =
                Math.ceil(
                    filteredRows.length /
                    pageSize
                );


            if (
                currentPage >
                totalPages
            ) {

                currentPage =
                    totalPages;

            }


            const start =
                (currentPage - 1) *
                pageSize;


            const end =
                start + pageSize;


            const pageRows =
                filteredRows.slice(
                    start,
                    end
                );


            pageRows.forEach(
                function (row) {

                    row.style.display =
                        "";

                }
            );


            /* INFO */

            const from =
                start + 1;

            const to =
                Math.min(
                    end,
                    filteredRows.length
                );


            if (pageInfo) {

                pageInfo.textContent =
                    `Menampilkan ${from}-${to} dari ${filteredRows.length} data`;

            }


            if (resultCount) {

                resultCount.textContent =
                    `${filteredRows.length} data`;

            }


            renderPagination(
                totalPages
            );

        }


        /* ====================================================
           PAGINATION
        ==================================================== */

        function renderPagination(
            totalPages
        ) {

            if (!paginationButtons) {
                return;
            }


            paginationButtons.innerHTML =
                "";


            /* PREVIOUS */

            const previous =
                document.createElement(
                    "button"
                );

            previous.type =
                "button";

            previous.className =
                "btn btn-sm btn-light border page-btn";

            previous.innerHTML =
                '<i class="bi bi-chevron-left"></i>';

            previous.disabled =
                currentPage === 1;


            previous.addEventListener(
                "click",
                function () {

                    if (
                        currentPage > 1
                    ) {

                        currentPage--;

                        render();

                    }

                }
            );


            paginationButtons.appendChild(
                previous
            );


            /* PAGE NUMBERS */

            let startPage =
                Math.max(
                    1,
                    currentPage - 2
                );

            let endPage =
                Math.min(
                    totalPages,
                    startPage + 4
                );


            if (
                endPage - startPage < 4
            ) {

                startPage =
                    Math.max(
                        1,
                        endPage - 4
                    );

            }


            for (
                let page = startPage;
                page <= endPage;
                page++
            ) {

                const button =
                    document.createElement(
                        "button"
                    );


                button.type =
                    "button";


                button.className =
                    "btn btn-sm btn-light border page-btn" +
                    (
                        page === currentPage
                            ? " active"
                            : ""
                    );


                button.textContent =
                    page;


                button.addEventListener(
                    "click",
                    function () {

                        currentPage =
                            page;

                        render();

                    }
                );


                paginationButtons.appendChild(
                    button
                );

            }


            /* NEXT */

            const next =
                document.createElement(
                    "button"
                );


            next.type =
                "button";


            next.className =
                "btn btn-sm btn-light border page-btn";


            next.innerHTML =
                '<i class="bi bi-chevron-right"></i>';


            next.disabled =
                currentPage === totalPages;


            next.addEventListener(
                "click",
                function () {

                    if (
                        currentPage <
                        totalPages
                    ) {

                        currentPage++;

                        render();

                    }

                }
            );


            paginationButtons.appendChild(
                next
            );

        }


        /* ====================================================
           SEARCH INPUT
        ==================================================== */

        if (searchInput) {

            searchInput.addEventListener(
                "input",
                function () {

                    applyLocalFilter(
                        false
                    );

                }
            );


            searchInput.addEventListener(
                "keydown",
                function (event) {

                    if (
                        event.key ===
                        "Enter"
                    ) {

                        event.preventDefault();

                        applyLocalFilter(
                            true
                        );

                    }

                }
            );

        }


        /* ====================================================
           STATUS CHANGE
        ==================================================== */

        if (statusInput) {

            statusInput.addEventListener(
                "change",
                function () {

                    applyLocalFilter(
                        true
                    );

                }
            );

        }


        /* ====================================================
           CLEAR SEARCH
        ==================================================== */

        if (clearButton) {

            clearButton.addEventListener(
                "click",
                function () {

                    if (searchInput) {

                        searchInput.value =
                            "";

                    }

                    applyLocalFilter(
                        false
                    );

                    searchInput?.focus();

                }
            );

        }


        /* ====================================================
           LIMIT
        ==================================================== */

        if (limitInput) {

            limitInput.addEventListener(
                "change",
                function () {

                    pageSize =
                        parseInt(
                            limitInput.value ||
                            10,
                            10
                        );

                    currentPage = 1;

                    render();

                }
            );

        }


        /* ====================================================
           DATE FILTER
        ==================================================== */

        if (dateInput) {

            dateInput.addEventListener(
                "change",
                function () {

                    /*
                     * Tanggal tetap diproses server
                     * ketika tombol Filter ditekan.
                     */

                    const form =
                        document.getElementById(
                            "collectionFilterForm"
                        );

                    if (form) {

                        form.requestSubmit();

                    }

                }
            );

        }


        /* ====================================================
           FORM FILTER
        ==================================================== */

        const filterForm =
            document.getElementById(
                "collectionFilterForm"
            );


        if (filterForm) {

            filterForm.addEventListener(
                "submit",
                function (event) {

                    /*
                     * Jika hanya search/status,
                     * kita tetap submit ke server
                     * supaya filter backend ikut sinkron.
                     *
                     * Jika hasil server kosong,
                     * server akan menampilkan empty state.
                     */

                }
            );

        }


        /* ====================================================
           INITIAL RENDER
        ==================================================== */

        render();


        /* ====================================================
           SERVER EMPTY DATA
        ==================================================== */

        if (
            rows.length === 0
        ) {

            showAlert(
                "Belum ada data pengumpulan sampah.",
                "info",
                "bi-info-circle"
            );
        }

        /* ====================================================
           LEAFLET TRACKING MAP INITIALIZER
        ==================================================== */
        const trackingModals = document.querySelectorAll(".ios-tracking-modal");
        const initializedMaps = {};

        function setupTrackingMap(modal) {
            const mapEl = modal.querySelector(".leaflet-tracking-map");
            if (!mapEl) return;

            const id = mapEl.getAttribute("data-id");
            const lat = parseFloat(mapEl.getAttribute("data-lat")) || -6.2088;
            const lng = parseFloat(mapEl.getAttribute("data-lng")) || 106.8456;
            const code = mapEl.getAttribute("data-code") || "-";
            const nasabah = mapEl.getAttribute("data-nasabah") || "-";
            const address = mapEl.getAttribute("data-address") || "Lokasi Penjemputan";
            const status = mapEl.getAttribute("data-status") || "diajukan";
            const collector = mapEl.getAttribute("data-collector") || "Petugas";

            if (!initializedMaps[id] && typeof L !== "undefined") {
                try {
                    // Check if already initialized by Leaflet
                    if (mapEl._leaflet_id) {
                        return;
                    }

                    const map = L.map(mapEl.id, {
                        center: [lat, lng],
                        zoom: 15,
                        zoomControl: true
                    });

                    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
                        maxZoom: 19,
                        attribution: '&copy; <a href="https://www.openstreetmap.org/">OpenStreetMap</a>'
                    }).addTo(map);

                    const userIcon = L.divIcon({
                        html: '<div style="background-color:#16a34a;color:#fff;width:34px;height:34px;border-radius:50%;display:flex;align-items:center;justify-content:center;box-shadow:0 3px 10px rgba(0,0,0,0.35);border:2px solid #fff;"><i class="bi bi-geo-alt-fill" style="font-size:18px;"></i></div>',
                        className: 'custom-map-icon',
                        iconSize: [34, 34],
                        iconAnchor: [17, 34],
                        popupAnchor: [0, -32]
                    });

                    const marker = L.marker([lat, lng], { icon: userIcon }).addTo(map);
                    marker.bindPopup(`
                        <div style="font-family:sans-serif;min-width:180px;font-size:12px;">
                            <strong style="color:#16a34a;font-size:13px;">${code}</strong><br>
                            <span style="font-weight:600;">Nasabah: ${nasabah}</span><br>
                            <small style="color:#64748b;">${address}</small><br>
                            <span class="badge bg-light text-dark border mt-1" style="font-size:10px;">Status: ${status}</span>
                        </div>
                    `).openPopup();

                    if (status === 'diambil' || status === 'ditimbang' || status === 'dijadwalkan' || status === 'diajukan') {
                        const courierLat = lat + 0.0035;
                        const courierLng = lng + 0.0040;
                        const courierIcon = L.divIcon({
                            html: '<div style="background-color:#2563eb;color:#fff;width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;box-shadow:0 3px 10px rgba(0,0,0,0.35);border:2px solid #fff;"><i class="bi bi-truck" style="font-size:16px;"></i></div>',
                            className: 'custom-courier-icon',
                            iconSize: [32, 32],
                            iconAnchor: [16, 32],
                            popupAnchor: [0, -30]
                        });
                        const courierMarker = L.marker([courierLat, courierLng], { icon: courierIcon }).addTo(map);
                        courierMarker.bindPopup(`<b>${collector}</b><br><small>Menuju titik penjemputan</small>`);

                        L.polyline([[courierLat, courierLng], [lat, lng]], {
                            color: '#16a34a',
                            dashArray: '6, 8',
                            weight: 3,
                            opacity: 0.8
                        }).addTo(map);
                    }

                    initializedMaps[id] = map;
                } catch (e) {
                    console.error("Leaflet map init error:", e);
                }
            }

            if (initializedMaps[id]) {
                setTimeout(() => {
                    initializedMaps[id].invalidateSize();
                }, 200);
                setTimeout(() => {
                    initializedMaps[id].invalidateSize();
                }, 600);
            }
        }

        trackingModals.forEach(function (modal) {
            modal.addEventListener("shown.bs.modal", function () {
                setupTrackingMap(modal);
            });
        });

        // Trigger on direct click of tracking button as fallback
        document.querySelectorAll("[data-bs-target^='#trackingCollection']").forEach(btn => {
            btn.addEventListener("click", function () {
                const targetSelector = btn.getAttribute("data-bs-target");
                const modal = document.querySelector(targetSelector);
                if (modal) {
                    setTimeout(() => setupTrackingMap(modal), 300);
                }
            });
        });

    }
);

