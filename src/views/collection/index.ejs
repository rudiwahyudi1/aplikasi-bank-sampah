function findCoordsByAddress(address) {
    if (!address) return null;
    const lower = String(address).toLowerCase();
    for (const item of INDO_CITIES_COORDS) {
        if (item.keys.some(k => lower.includes(k))) {
            return { lat: item.lat, lng: item.lng };
        }
    }
    return null;
}

function checkCityInAddress(id) {
    const addr = document.getElementById("editAddress_" + id)?.value;
    const coords = findCoordsByAddress(addr);
    if (coords) {
        const latEl = document.getElementById("editLat_" + id);
        const lngEl = document.getElementById("editLng_" + id);
        if (latEl && lngEl) {
            latEl.value = coords.lat;
            lngEl.value = coords.lng;
        }
    }
}

function autoDetectCoords(id) {
    const addr = document.getElementById("editAddress_" + id)?.value;
    const coords = findCoordsByAddress(addr);
    const latEl = document.getElementById("editLat_" + id);
    const lngEl = document.getElementById("editLng_" + id);
    if (coords && latEl && lngEl) {
