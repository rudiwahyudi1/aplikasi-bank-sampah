/* Auto-resize textarea */
const chatInput = document.getElementById("chatInputText");
chatInput.addEventListener("input", function() {
    autoResizeTextarea(this);
});

function autoResizeTextarea(el) {
    el.style.height = "auto";
    el.style.height = Math.min(el.scrollHeight, 120) + "px";
}

chatInput.addEventListener("keydown", function(e) {
    if (e.key === "Enter" && !e.shiftKey) {
        e.preventDefault();
        sendCurrentMessage();
    }
});

chatInput.addEventListener("focus", function() {
    document.body.classList.add("is-chat-typing");
    const bottomNav = document.getElementById("appBottomNav");
    if (bottomNav) bottomNav.style.setProperty("display", "none", "important");

    // Kunci posisi scroll window ke paling atas agar header tetap anteng & tidak jalan
    window.scrollTo(0, 0);
    document.documentElement.scrollTop = 0;
    document.body.scrollTop = 0;

    // Sesuaikan tinggi container dengan visualViewport HP
    if (window.visualViewport && window.innerWidth <= 767) {
        const chatWrapper = document.getElementById("chatApp");
        if (chatWrapper) chatWrapper.style.height = `${window.visualViewport.height}px`;
    }

    // Auto-scroll riwayat pesan di dalam container ke paling bawah saat keyboard hp terbuka
    setTimeout(function() {
        window.scrollTo(0, 0);
        document.documentElement.scrollTop = 0;
        document.body.scrollTop = 0;
        const container = document.getElementById("messagesContainer");
        if (container) container.scrollTop = container.scrollHeight;
    }, 200);
});

chatInput.addEventListener("blur", function() {
    setTimeout(function() {
        document.body.classList.remove("is-chat-typing");
        window.scrollTo(0, 0);
        document.documentElement.scrollTop = 0;
        document.body.scrollTop = 0;
        if (!document.body.classList.contains("in-active-chat")) {
            const bottomNav = document.getElementById("appBottomNav");
            if (bottomNav) bottomNav.style.removeProperty("display");
        }
        if (window.visualViewport && window.innerWidth <= 767 && document.body.classList.contains("in-active-chat")) {
            const chatWrapper = document.getElementById("chatApp");
            if (chatWrapper) chatWrapper.style.height = `${window.visualViewport.height}px`;
        }
    }, 150);
});

/* Attachment Handling */
function triggerFileInput() {
    document.getElementById("chatFileInput").click();
}

async function handleFileSelect(e) {
    const file = e.target.files[0];
    if (!file) return;

    if (file.size > 5 * 1024 * 1024) {
        alert("Ukuran file maksimal 5MB!");
        e.target.value = "";
        return;
    }

    const formData = new FormData();
    formData.append("file", file);

    // Show loading state on bar
    const bar = document.getElementById("stagedAttachmentBar");
    bar.style.display = "flex";
    document.getElementById("stagedFileName").innerHTML = `<span class="spinner-border spinner-border-sm text-success me-1"></span> Mengunggah ${file.name}...`;
    document.getElementById("stagedFileSize").innerText = `${Math.round(file.size / 1024)} KB`;

    try {
        const response = await fetch("/chat/api/upload", {
            method: "POST",
            body: formData
        });
        const result = await response.json();

        if (result.success) {
            stagedAttachment = result;
            document.getElementById("stagedFileName").innerText = result.filename || file.name;
            document.getElementById("stagedFileSize").innerText = `${Math.round(result.size / 1024)} KB`;
        } else {
            alert("Gagal mengunggah file: " + (result.message || "Kesalahan server"));
            clearStagedAttachment();
        }
    } catch (err) {
        alert("Gagal menghubungi server untuk upload file");
        clearStagedAttachment();
    }
}

function clearStagedAttachment() {
    stagedAttachment = null;
    document.getElementById("stagedAttachmentBar").style.display = "none";
    document.getElementById("chatFileInput").value = "";
}

/* Send Message Action */
async function sendCurrentMessage() {
    if (!activeTargetId) {
        alert("Pilih kontak terlebih dahulu!");
        return;
    }

    const input = document.getElementById("chatInputText");
    const text = input.value.trim();
    const attachmentUrl = stagedAttachment ? stagedAttachment.fileUrl : null;

    if (!text && !attachmentUrl) {
        return;
    }

    const sendBtn = document.getElementById("sendMessageBtn");
    const sendIcon = document.getElementById("sendBtnIcon");
    sendBtn.disabled = true;
    sendIcon.className = "spinner-border spinner-border-sm";

    try {
        const response = await fetch("/chat/api/send", {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify({
                receiver_id: activeTargetId,
                message: text,
                attachment_url: attachmentUrl
            })
        });

        const result = await response.json();
        if (result.success) {
            // Reset input and attachments
            input.value = "";
            autoResizeTextarea(input);
            clearStagedAttachment();

            // Update snippet on contact item
            const snippet = document.getElementById(`snippet-${activeTargetId}`);
            if (snippet) {
                snippet.innerText = text || "Lampiran file";
            }
            const timeEl = document.getElementById(`time-${activeTargetId}`);
            if (timeEl) {
                timeEl.innerText = new Date().toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' });
            }

            // Immediately fetch messages to show newly sent message
            await loadMessages(activeTargetId, false);
            const container = document.getElementById("messagesContainer");
            container.scrollTop = container.scrollHeight;
        } else {
            alert("Gagal mengirim pesan: " + (result.message || "Terjadi kesalahan"));
        }
    } catch (err) {
        alert("Kesalahan jaringan saat mengirim pesan");
    } finally {
        sendBtn.disabled = false;
        sendIcon.className = "bi bi-send-fill fs-6";
        input.focus();
    }
}

/* Delete Message */
async function deleteMessage(messageId) {
    if (!confirm("Hapus pesan ini? Pesan tidak akan terlihat lagi.")) {
        return;
    }

    try {
        const response = await fetch(`/chat/api/messages/${messageId}`, {
            method: "DELETE"
        });
        const result = await response.json();

        if (result.success) {
            const row = document.getElementById(`msg-row-${messageId}`);
            if (row) {
                row.remove();
            }
        } else {
            alert("Gagal menghapus pesan: " + (result.message || ""));
        }
    } catch (err) {
        alert("Kesalahan jaringan saat menghapus pesan");
    }
}

/* Manual Refresh */
async function manualRefresh() {
    const icon = document.getElementById("refreshIcon");
    icon.classList.add("spin-animation");
    if (activeTargetId) {
        await loadMessages(activeTargetId, false);
    }
    setTimeout(() => {
        icon.classList.remove("spin-animation");
    }, 600);
}

/* =========================================================
   CLEAR CHAT LOGIC (HAPUS SEMUA CHAT)
========================================================= */
let pendingClearAction = null; // { type: 'conversation'|'all', targetId: ... }

function confirmClearActiveConversation() {
    if (!activeTargetId) return;
    pendingClearAction = { type: 'conversation', targetId: activeTargetId };
    
    const isPublic = (activeTargetId === '0' || activeTargetId === 'general');
    document.getElementById("clearChatModalTitle").innerText = isPublic ? "Bersihkan Obrolan Umum" : "Hapus Percakapan Ini";
    document.getElementById("clearChatModalDesc").innerText = isPublic 
        ? "Apakah Anda yakin ingin membersihkan riwayat pesan di Ruang Diskusi Umum? Pesan yang dihapus tidak dapat dipulihkan."
        : `Apakah Anda yakin ingin menghapus semua pesan dalam percakapan dengan ${activeTargetName}? Tindakan ini permanen.`;
    
    const modal = new bootstrap.Modal(document.getElementById("clearChatConfirmModal"));
    modal.show();
}

function confirmClearAllMyChats() {
    pendingClearAction = { type: 'all' };
    document.getElementById("clearChatModalTitle").innerText = "Hapus Semua Riwayat Chat";
    document.getElementById("clearChatModalDesc").innerText = "PERINGATAN: Seluruh riwayat percakapan Anda (termasuk direct message) akan dibersihkan secara permanen. Apakah Anda yakin ingin melanjutkan?";
    
    const modal = new bootstrap.Modal(document.getElementById("clearChatConfirmModal"));
    modal.show();
}

document.getElementById("confirmClearChatBtn")?.addEventListener("click", async () => {
    if (!pendingClearAction) return;

    const btn = document.getElementById("confirmClearChatBtn");
    const origHtml = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = `<span class="spinner-border spinner-border-sm me-1"></span> Menghapus...`;

    try {
        let endpoint = "";
        if (pendingClearAction.type === 'conversation') {
            endpoint = `/chat/api/conversation/${pendingClearAction.targetId}`;
        } else {
            endpoint = `/chat/api/clear-all`;
        }

        const response = await fetch(endpoint, {
            method: "POST",
            headers: {
                "Accept": "application/json",
                "Content-Type": "application/json"
            }
        });

        let result = {};
        try {
            result = await response.json();
        } catch (_) {
            result = { success: response.ok, message: response.statusText };
        }

        // Close modal
        const modalEl = document.getElementById("clearChatConfirmModal");
        const modal = bootstrap.Modal.getInstance(modalEl);
        if (modal) modal.hide();

        if (result.success) {
            if (pendingClearAction.type === 'conversation') {
                const container = document.getElementById("messagesContainer");
                container.innerHTML = `
                    <div class="chat-empty-state" style="background:transparent;">
                        <i class="bi bi-chat-check fs-1 text-success opacity-75 mb-2"></i>
                        <div class="fw-semibold text-dark small">Percakapan telah dibersihkan.</div>
                        <div class="text-muted" style="font-size:0.75rem;">Mulai percakapan baru dengan mengetik pesan di bawah.</div>
                    </div>
                `;
                const snippet = document.getElementById(`snippet-${pendingClearAction.targetId}`);
                if (snippet) snippet.innerText = "Percakapan dibersihkan.";
            } else {
                const container = document.getElementById("messagesContainer");
                container.innerHTML = `
                    <div class="chat-empty-state" style="background:transparent;">
                        <i class="bi bi-chat-check fs-1 text-success opacity-75 mb-2"></i>
                        <div class="fw-semibold text-dark small">Seluruh riwayat obrolan Anda telah dibersihkan.</div>
                    </div>
                `;
                document.querySelectorAll(".contact-snippet").forEach(el => {
                    el.innerText = "Belum ada pesan.";
                });
                document.querySelectorAll(".unread-badge").forEach(el => {
                    el.style.display = "none";
                    el.innerText = "0";
                });
            }
        } else {
            alert("Gagal membersihkan obrolan: " + (result.message || ""));
        }
    } catch (err) {
        alert("Terjadi kesalahan jaringan saat menghapus obrolan.");
    } finally {
        btn.disabled = false;
        btn.innerHTML = origHtml;
        pendingClearAction = null;
    }
});

/* =========================================================
   REALTIME LIVE CHAT EVENT HANDLERS (SSE)
========================================================= */
function handleIncomingRealtimeChat(msg) {
    if (!msg) return;

    const isPublicMsg = (!msg.receiver_id || msg.receiver_id === 0);
    const targetKey = isPublicMsg ? '0' : (msg.sender_id === CURRENT_USER_ID ? msg.receiver_id : msg.sender_id);

    // Update snippet and time in contact item
    const snippetEl = document.getElementById(`snippet-${targetKey}`) || (isPublicMsg ? document.getElementById("snippet-general") : null);
    if (snippetEl) {
        const senderPrefix = (isPublicMsg && msg.sender_id !== CURRENT_USER_ID) ? `${msg.sender_name}: ` : '';
        snippetEl.innerText = `${senderPrefix}${msg.message || 'Mengirim lampiran'}`;
    }

    const timeEl = document.getElementById(`time-${targetKey}`) || (isPublicMsg ? document.getElementById("time-general") : null);
    if (timeEl) {
        timeEl.innerText = new Date(msg.created_at || Date.now()).toLocaleTimeString("id-ID", { hour: "2-digit", minute: "2-digit" });
    }

    // Move contact item to top of list
    const contactItem = document.getElementById(`contact-${targetKey}`) || (isPublicMsg ? document.getElementById("contact-general") : null);
    const container = document.getElementById("contactsContainer");
    if (contactItem && container && contactItem.parentElement === container) {
        if (container.firstElementChild !== contactItem) {
            container.insertBefore(contactItem, container.firstElementChild);
        }
    }

    // Check if message belongs to active open chat room
    const isActiveConversation = (
        (isPublicMsg && (activeTargetId === '0' || activeTargetId === 'general')) ||
        (!isPublicMsg && (activeTargetId == msg.sender_id || (msg.sender_id === CURRENT_USER_ID && activeTargetId == msg.receiver_id)))
    );

    if (isActiveConversation) {
        loadMessages(activeTargetId, false);
    } else {
        if (msg.sender_id !== CURRENT_USER_ID) {
            playIncomingSound();
            const badge = document.getElementById(`unread-${targetKey}`);
            if (badge) {
                const cur = parseInt(badge.innerText || "0", 10) || 0;
                badge.innerText = (cur + 1) > 99 ? '99+' : (cur + 1);
                badge.style.display = "inline-block";
            }
        }
    }
}

function handleRealtimeChatClear(data) {
    if (!data) return;
    if (data.isAll) {
        if (data.clearedBy === CURRENT_USER_ID) {
            const container = document.getElementById("messagesContainer");
            if (container) {
                container.innerHTML = `
                    <div class="chat-empty-state" style="background:transparent;">
                        <i class="bi bi-chat-check fs-1 text-success opacity-75 mb-2"></i>
                        <div class="fw-semibold text-dark small">Seluruh riwayat chat telah dibersihkan.</div>
                    </div>
                `;
            }
        }
        return;
    }

    const matchesActive = (
        (data.targetId === '0' && (activeTargetId === '0' || activeTargetId === 'general')) ||
        (data.targetId == activeTargetId) ||
        (data.clearedBy == activeTargetId)
    );

    if (matchesActive) {
        const container = document.getElementById("messagesContainer");
        if (container) {
            container.innerHTML = `
                <div class="chat-empty-state" style="background:transparent;">
                    <i class="bi bi-chat-check fs-1 text-success opacity-75 mb-2"></i>
                    <div class="fw-semibold text-dark small">Percakapan telah dibersihkan.</div>
                    <div class="text-muted" style="font-size:0.75rem;">Mulai percakapan baru dengan mengetik pesan di bawah.</div>
                </div>
            `;
        }
        const snippet = document.getElementById(`snippet-${data.targetId}`);
        if (snippet) snippet.innerText = "Percakapan dibersihkan.";
    }
}

function handleRealtimeChatDelete(data) {
    if (!data || !data.messageId) return;
    const row = document.getElementById(`msg-row-${data.messageId}`);
    if (row) {
        row.style.transition = "all 0.3s ease";
        row.style.opacity = "0";
        row.style.transform = "scale(0.9)";
        setTimeout(() => row.remove(), 300);
    }
}

window.addEventListener("pilahkita:chat", (e) => handleIncomingRealtimeChat(e.detail));
window.addEventListener("pilahkita:chat_clear", (e) => handleRealtimeChatClear(e.detail));
window.addEventListener("pilahkita:chat_delete", (e) => handleRealtimeChatDelete(e.detail));

/* VisualViewport listener untuk sinkronisasi tinggi saat virtual keyboard HP buka/tutup */
if (window.visualViewport) {
    const syncMobileViewport = () => {
        if (document.body.classList.contains("in-active-chat") && window.innerWidth <= 767) {
            const chatWrapper = document.getElementById("chatApp");
            if (chatWrapper) {
                chatWrapper.style.height = `${window.visualViewport.height}px`;
            }
            if (window.scrollY !== 0 || document.documentElement.scrollTop !== 0 || document.body.scrollTop !== 0) {
                window.scrollTo(0, 0);
                document.documentElement.scrollTop = 0;
                document.body.scrollTop = 0;
            }
        }
    };
    window.visualViewport.addEventListener("resize", syncMobileViewport);
    window.visualViewport.addEventListener("scroll", () => {
        if (document.body.classList.contains("in-active-chat") && window.innerWidth <= 767) {
            window.scrollTo(0, 0);
            document.documentElement.scrollTop = 0;
            document.body.scrollTop = 0;
        }
    });
}

/* Auto select general room on initial desktop load */
document.addEventListener("DOMContentLoaded", () => {
    if (window.innerWidth > 767) {
        selectChatTarget('0', 'Ruang Diskusi Umum', 'Umum', '');
    }
});
</script>

