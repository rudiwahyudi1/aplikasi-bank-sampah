    font-size: 0.95rem;
}

.chat-search-box input {
    width: 100%;
    padding: 0.6rem 2.25rem 0.6rem 2.4rem;
    background: #f1f5f9;
    border: 1px solid transparent;
    border-radius: 999px;
    font-size: 0.875rem;
    outline: none;
    transition: all 0.2s ease;
}

.chat-search-box input:focus {
    background: #ffffff;
    border-color: #16a34a;
    box-shadow: 0 0 0 3px rgba(22, 163, 74, 0.15);
}

.chat-search-box .clear-search {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    color: #94a3b8;
    cursor: pointer;
    display: none;
    font-size: 0.85rem;
}

/* Category Filter Tabs */
.chat-category-tabs {
    display: flex;
    gap: 0.4rem;
    padding: 0.6rem 1rem;
    background: #ffffff;
    border-bottom: 1px solid #f1f5f9;
