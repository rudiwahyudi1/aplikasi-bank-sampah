================================================================ -->
<script>
/* Global state */
const CURRENT_USER_ID = <%= currentUser.id %>;
let activeTargetId = null;
let activeTargetName = "";
let activeTargetRole = "";
let soundEnabled = true;
let stagedAttachment = null; // { fileUrl, filename, size, mimetype }
let pollingInterval = null;
let lastKnownMessageCount = 0;

/* Sound Generator using Web Audio API (Soft Chime) */
function playIncomingSound() {
    if (!soundEnabled) return;
    try {
        const AudioContext = window.AudioContext || window.webkitAudioContext;
        if (!AudioContext) return;
        const ctx = new AudioContext();
        
        const now = ctx.currentTime;
        const osc1 = ctx.createOscillator();
        const osc2 = ctx.createOscillator();
        const gainNode = ctx.createGain();

        osc1.type = 'sine';
        osc1.frequency.setValueAtTime(587.33, now); // D5
        osc1.frequency.exponentialRampToValueAtTime(880, now + 0.15); // A5

        osc2.type = 'triangle';
        osc2.frequency.setValueAtTime(880, now);
        osc2.frequency.exponentialRampToValueAtTime(1174.66, now + 0.25); // D6

        gainNode.gain.setValueAtTime(0.15, now);
        gainNode.gain.exponentialRampToValueAtTime(0.001, now + 0.35);

        osc1.connect(gainNode);
        osc2.connect(gainNode);
        gainNode.connect(ctx.destination);

        osc1.start(now);
        osc2.start(now);
        osc1.stop(now + 0.35);
        osc2.stop(now + 0.35);
    } catch (e) {
        // Fallback silently if audio blocked by browser policy
    }
}

function toggleSoundAlert() {
    soundEnabled = !soundEnabled;
    const btn = document.getElementById("soundToggleBtn");
    const icon = document.getElementById("soundIcon");
    if (soundEnabled) {
        icon.className = "bi bi-volume-up-fill text-success";
        btn.title = "Notifikasi Suara: Aktif";
    } else {
        icon.className = "bi bi-volume-mute-fill text-secondary";
        btn.title = "Notifikasi Suara: Dimatikan";
    }
}

/* Category Filter for Contacts */
document.querySelectorAll(".cat-pill").forEach(btn => {
    btn.addEventListener("click", () => {
        document.querySelectorAll(".cat-pill").forEach(b => b.classList.remove("active"));
        btn.classList.add("active");
        const filter = btn.getAttribute("data-filter");
        filterContacts(filter, document.getElementById("contactSearchInput").value);
    });
});

/* Search Filter */
const searchInput = document.getElementById("contactSearchInput");
const clearSearchBtn = document.getElementById("clearSearchBtn");

searchInput.addEventListener("input", (e) => {
    const query = e.target.value.trim().toLowerCase();
    clearSearchBtn.style.display = query ? "block" : "none";
    const activeFilter = document.querySelector(".cat-pill.active")?.getAttribute("data-filter") || "all";
    filterContacts(activeFilter, query);
});

clearSearchBtn.addEventListener("click", () => {
    searchInput.value = "";
    clearSearchBtn.style.display = "none";
    const activeFilter = document.querySelector(".cat-pill.active")?.getAttribute("data-filter") || "all";
    filterContacts(activeFilter, "");
    searchInput.focus();
});

function filterContacts(category, query) {
    query = (query || "").toLowerCase();
    const items = document.querySelectorAll(".contact-item");
    let visibleCount = 0;

    items.forEach(item => {
        const itemCat = item.getAttribute("data-category") || "other";
        const name = (item.getAttribute("data-name") || "").toLowerCase();
        const role = (item.getAttribute("data-role") || "").toLowerCase();

        const matchCat = (category === "all") || (itemCat === category);
        const matchQuery = !query || name.includes(query) || role.includes(query);

        if (matchCat && matchQuery) {
            item.style.display = "flex";
            visibleCount++;
        } else {
            item.style.display = "none";
        }
    });

    document.getElementById("noContactsFound").style.display = visibleCount === 0 ? "block" : "none";
}

/* Target Selection */
function onUserItemClick(el) {
    const id = el.getAttribute("data-id");
    const name = el.getAttribute("data-name");
    const role = el.getAttribute("data-role");
    const phone = el.getAttribute("data-phone") || "";
    selectChatTarget(id, name, role, phone);
}

function selectChatTarget(targetId, targetName, targetRole, phone) {
    activeTargetId = targetId;
    activeTargetName = targetName;
    activeTargetRole = targetRole;

    // Highlight contact item
    document.querySelectorAll(".contact-item").forEach(el => el.classList.remove("active"));
    const selectedItem = document.getElementById(`contact-${targetId}`);
    if (selectedItem) {
        selectedItem.classList.add("active");
        // Hide unread badge for this contact
        const unread = document.getElementById(`unread-${targetId}`);
        if (unread) unread.style.display = "none";
    }

    // Toggle view from empty state to active chat
    document.getElementById("emptyStateView").style.display = "none";
    const activeChat = document.getElementById("activeChatView");
    activeChat.style.display = "flex";

    // Set Header
    document.getElementById("activeTargetName").innerText = targetName;
    document.getElementById("activeTargetRole").innerText = targetRole;
    
    // Initials & Avatar
    const avatarEl = document.getElementById("activeTargetAvatar");
    if (targetId === "0" || targetId === "general") {
        avatarEl.style.background = "linear-gradient(135deg, #0284c7, #0369a1)";
        avatarEl.innerHTML = '<i class="bi bi-globe2 fs-5"></i>';
        document.getElementById("activeTargetStatus").innerHTML = '<i class="bi bi-people-fill text-primary" style="font-size:11px;"></i> Ruang Diskusi Terbuka';
    } else {
        const initials = targetName.substring(0, 2).toUpperCase();
        avatarEl.style.background = targetRole.toLowerCase().includes("admin") ? "linear-gradient(135deg, #8b5cf6, #7c3aed)" : (targetRole.toLowerCase().includes("petugas") ? "linear-gradient(135deg, #10b981, #059669)" : "linear-gradient(135deg, #14b8a6, #0f766e)");
        avatarEl.innerHTML = initials;
        document.getElementById("activeTargetStatus").innerHTML = '<span class="online-indicator-dot me-1"></span> Online • Realtime Sync';
    }

    // WhatsApp Button
    const waBtn = document.getElementById("waDirectBtn");
    if (phone && phone.trim().length >= 8 && targetId !== "0") {
        let cleanPhone = phone.replace(/[^0-9]/g, "");
        if (cleanPhone.startsWith("0")) cleanPhone = "62" + cleanPhone.substring(1);
        waBtn.href = `https://wa.me/${cleanPhone}`;
        waBtn.classList.remove("d-none");
        waBtn.classList.add("d-inline-flex");
    } else {
        waBtn.classList.add("d-none");
        waBtn.classList.remove("d-inline-flex");
    }

    // Mobile responsive switch
    if (window.innerWidth <= 767) {
        document.getElementById("chatSidebar").classList.add("mobile-hidden");
        document.getElementById("chatMainPane").classList.remove("mobile-hidden");
        document.body.classList.add("in-active-chat");
        window.scrollTo(0, 0);
        document.documentElement.scrollTop = 0;
        document.body.scrollTop = 0;
        const bottomNav = document.getElementById("appBottomNav");
        if (bottomNav) bottomNav.style.setProperty("display", "none", "important");
        if (window.visualViewport) {
            const chatWrapper = document.getElementById("chatApp");
            if (chatWrapper) chatWrapper.style.height = `${window.visualViewport.height}px`;
        }
    }

    // Load messages
    lastKnownMessageCount = 0;
    loadMessages(targetId, true);

    // Setup polling
    if (pollingInterval) clearInterval(pollingInterval);
    pollingInterval = setInterval(() => {
        if (activeTargetId) {
            loadMessages(activeTargetId, false);
        }
    }, 3000);

    // Focus input only on desktop (prevent sudden keyboard popup on mobile)
    if (window.innerWidth > 767) {
        setTimeout(() => {
            const inp = document.getElementById("chatInputText");
            if (inp) inp.focus();
        }, 150);
    }
}

function backToMobileContacts() {
    document.getElementById("chatSidebar").classList.remove("mobile-hidden");
    document.getElementById("chatMainPane").classList.add("mobile-hidden");
    document.body.classList.remove("in-active-chat");
    document.body.classList.remove("is-chat-typing");
    const bottomNav = document.getElementById("appBottomNav");
    if (bottomNav) bottomNav.style.removeProperty("display");
    const chatWrapper = document.getElementById("chatApp");
    if (chatWrapper) chatWrapper.style.removeProperty("height");
    window.scrollTo(0, 0);
    document.documentElement.scrollTop = 0;
    document.body.scrollTop = 0;
}

/* Load Messages via AJAX */
async function loadMessages(targetId, isInitial = false) {
    const container = document.getElementById("messagesContainer");
    if (isInitial) {
        container.innerHTML = `
            <div class="text-center py-5 text-muted small">
                <div class="spinner-border spinner-border-sm text-success me-2" role="status"></div>
                Memuat riwayat obrolan...
            </div>
        `;
    }

    try {
        const response = await fetch(`/chat/api/messages/${targetId}`);
        const data = await response.json();

        if (!data.success) {
            if (isInitial) {
                container.innerHTML = `<div class="alert alert-danger mx-3 my-4 small">Gagal memuat pesan: ${data.message || 'Kesalahan server'}</div>`;
            }
            return;
        }

        const messages = data.messages || [];

        // Check if there are new incoming messages
        if (!isInitial && messages.length > lastKnownMessageCount) {
            const newMessages = messages.slice(lastKnownMessageCount);
            const hasIncoming = newMessages.some(m => m.sender_id !== CURRENT_USER_ID);
            if (hasIncoming) {
                playIncomingSound();
            }
        }
        lastKnownMessageCount = messages.length;

        // Render messages
        renderMessages(messages, container, isInitial);

    } catch (err) {
        if (isInitial) {
            container.innerHTML = `<div class="alert alert-warning mx-3 my-4 small">Gagal terhubung ke server live chat.</div>`;
        }
    }
}

/* Render Messages List */
function renderMessages(messages, container, forceScrollBottom = false) {
    if (!messages || messages.length === 0) {
        container.innerHTML = `
            <div class="chat-empty-state" style="background:transparent;">
                <i class="bi bi-chat-dots fs-1 text-secondary opacity-50 mb-2"></i>
                <div class="fw-semibold text-muted small">Belum ada percakapan.</div>
                <div class="text-muted" style="font-size:0.75rem;">Ketik pesan pertama di bawah untuk memulai!</div>
            </div>
        `;
        return;
    }

    // Keep scroll position check
    const isNearBottom = (container.scrollHeight - container.scrollTop - container.clientHeight) < 120;

    let html = "";
    let lastDate = "";

    messages.forEach(msg => {
        const isOutgoing = (msg.sender_id === CURRENT_USER_ID);
        const msgDate = new Date(msg.created_at);
        const dateStr = formatDateDivider(msgDate);

        if (dateStr !== lastDate) {
            html += `
                <div class="chat-date-divider">
                    <span>${dateStr}</span>
                </div>
            `;
            lastDate = dateStr;
        }

        const timeStr = msgDate.toLocaleTimeString("id-ID", { hour: "2-digit", minute: "2-digit" });

        // Attachment HTML
        let attachmentHtml = "";
        if (msg.attachment_url) {
            const isImage = /\.(jpg|jpeg|png|webp|gif)$/i.test(msg.attachment_url);
            if (isImage) {
                attachmentHtml = `
                    <img src="${msg.attachment_url}" class="msg-attachment-img" onclick="openLightbox('${msg.attachment_url}')" alt="Lampiran Foto" loading="lazy">
                `;
            } else {
                const fname = msg.attachment_url.split("/").pop();
                attachmentHtml = `
                    <a href="${msg.attachment_url}" target="_blank" download class="msg-attachment-file">
                        <i class="bi bi-file-earmark-pdf-fill fs-5 text-danger"></i>
                        <span class="text-truncate" style="max-width:180px;">${fname}</span>
                        <i class="bi bi-download ms-auto"></i>
                    </a>
                `;
            }
        }

        // Sender tag if incoming and in general room
        let senderTag = "";
        if (!isOutgoing && (activeTargetId === "0" || activeTargetId === "general")) {
            const roleBadgeColor = (msg.sender_role || "").toLowerCase().includes("admin") ? "#7c3aed" : ((msg.sender_role || "").toLowerCase().includes("petugas") ? "#16a34a" : "#0284c7");
            senderTag = `
                <div class="msg-sender-name">
                    <span>${escapeHtml(msg.sender_name || msg.sender_username || "Pengguna")}</span>
                    <span class="badge rounded-pill" style="background:${roleBadgeColor}; font-size:9px; padding:2px 6px; color:#fff;">
                        ${escapeHtml(msg.sender_role || 'User')}
                    </span>
                </div>
            `;
        }

        // Text formatting (line breaks & links)
        const formattedText = linkify(escapeHtml(msg.message || ""));

        html += `
            <div class="chat-msg-row ${isOutgoing ? 'outgoing' : 'incoming'}" id="msg-row-${msg.id}">
                <div class="msg-bubble">
                    ${senderTag}
                    ${attachmentHtml}
                    ${formattedText ? `<div class="msg-content">${formattedText}</div>` : ''}
                    <div class="msg-time-status">
                        <span>${timeStr}</span>
                        ${isOutgoing ? (msg.is_read ? '<i class="bi bi-check2-all" style="color:#67e8f9; font-size:12px;" title="Telah dibaca"></i>' : '<i class="bi bi-check2 text-white-50" style="font-size:12px;" title="Terkirim"></i>') : ''}
                        ${isOutgoing ? `
                            <button type="button" class="msg-actions-btn" title="Hapus pesan" onclick="deleteMessage(${msg.id})">
                                <i class="bi bi-trash3"></i>
                            </button>
                        ` : ''}
                    </div>
                </div>
            </div>
        `;
    });

    container.innerHTML = html;

    // Auto scroll to bottom
    if (forceScrollBottom || isNearBottom) {
        container.scrollTop = container.scrollHeight;
    }
}

/* Helpers */
function formatDateDivider(date) {
    const today = new Date();
    const yesterday = new Date(today);
    yesterday.setDate(yesterday.getDate() - 1);

    if (date.toDateString() === today.toDateString()) {
        return "Hari ini";
    } else if (date.toDateString() === yesterday.toDateString()) {
        return "Kemarin";
    }
    return date.toLocaleDateString("id-ID", { day: "numeric", month: "short", year: "numeric" });
}

function escapeHtml(text) {
    if (!text) return "";
    return text
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
}

function linkify(text) {
    if (!text) return "";
    const urlPattern = /(\b(https?|ftp):\/\/[-A-Z0-9+&@#\/%?=~_|!:,.;]*[-A-Z0-9+&@#\/%=~_|])/gim;
    return text.replace(urlPattern, '<a href="$1" target="_blank" rel="noopener noreferrer" class="text-decoration-underline text-reset fw-semibold">$1</a>')
               .replace(/\n/g, '<br>');
}

function openLightbox(imgUrl) {
    document.getElementById("lightboxImage").src = imgUrl;
    const modal = new bootstrap.Modal(document.getElementById("imageLightboxModal"));
    modal.show();
}

