}

.contact-name-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.25rem;
}

.contact-name {
    font-size: 0.9rem;
    font-weight: 600;
    color: #1e293b;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.contact-time {
    font-size: 0.725rem;
    color: #94a3b8;
    flex-shrink: 0;
}

.contact-meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
}

.contact-snippet {
    font-size: 0.8rem;
    color: #64748b;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 190px;
}

.contact-item.active .contact-snippet {
    color: #166534;
}

.unread-badge {
    background: #16a34a;
    color: #ffffff;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 2px 7px;
    border-radius: 999px;
    box-shadow: 0 2px 6px rgba(22, 163, 74, 0.35);
}

/* Chat Main Pane */
.chat-main-pane {
    flex: 1;
    display: flex;
    flex-direction: column;
    background: #ffffff;
    position: relative;
    min-width: 0;
}

/* App Bar Header */
.chat-main-header {
    padding: 0.75rem 1.25rem;
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid #eef2f6;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    z-index: 10;
    min-height: 62px;
    flex-shrink: 0;
}

.header-left {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    min-width: 0;
}

.mobile-back-btn {
    display: none;
    background: #f1f5f9;
    border: none;
    font-size: 1.15rem;
    color: #1e293b;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    cursor: pointer;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: all 0.15s ease;
}
.mobile-back-btn:hover, .mobile-back-btn:active {
    background: #e2e8f0;
    transform: scale(0.95);
}

.header-target-meta {
    min-width: 0;
}

.header-target-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: #0f172a;
    line-height: 1.2;
}

.header-target-status {
    font-size: 0.75rem;
    color: #64748b;
    margin-top: 2px;
    display: flex;
    align-items: center;
    gap: 5px;
}

.online-indicator-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #22c55e;
    display: inline-block;
    box-shadow: 0 0 0 2px rgba(34, 197, 94, 0.2);
}

.header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.btn-chat-action {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid #e2e8f0;
    background: #ffffff;
    color: #475569;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
}
.btn-chat-action:hover {
    background: #f8fafc;
    border-color: #cbd5e1;
    color: #0f172a;
}
.btn-chat-action.whatsapp-action {
    background: #dcfce7;
    border-color: #86efac;
    color: #166534;
    width: auto;
    padding: 0 12px;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 600;
    gap: 5px;
    text-decoration: none;
}
.btn-chat-action.whatsapp-action:hover {
    background: #bbf7d0;
}

/* Messages Wallpaper & Container */
.messages-container {
    flex: 1;
    overflow-y: auto;
    padding: 1.25rem;
    background-color: #f8fafc;
    background-image: radial-gradient(rgba(148, 163, 184, 0.2) 1.2px, transparent 1.2px);
    background-size: 20px 20px;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
}

/* Floating Date Divider */
.chat-date-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0.85rem 0;
}

.chat-date-divider span {
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(8px);
    color: #64748b;
    font-size: 0.725rem;
    font-weight: 600;
    padding: 0.3rem 0.95rem;
    border-radius: 999px;
    letter-spacing: 0.3px;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06);
    border: 1px solid rgba(226, 232, 240, 0.9);
}

/* Message Bubbles */
.chat-msg-row {
    display: flex;
    align-items: flex-end;
    gap: 0.5rem;
    max-width: 78%;
    animation: fadeInMsg 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

@keyframes fadeInMsg {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
}

.chat-msg-row.outgoing {
    align-self: flex-end;
    flex-direction: row-reverse;
}

.chat-msg-row.incoming {
    align-self: flex-start;
}

.msg-bubble {
    padding: 0.75rem 1rem;
    border-radius: 1.15rem;
    position: relative;
    word-break: break-word;
    font-size: 0.9rem;
    line-height: 1.48;
}

.chat-msg-row.outgoing .msg-bubble {
    background: linear-gradient(135deg, #16a34a, #15803d);
    color: #ffffff;
    border-radius: 18px 18px 4px 18px;
    box-shadow: 0 2px 8px rgba(22, 163, 74, 0.22);
}

.chat-msg-row.incoming .msg-bubble {
    background: #ffffff;
    color: #1e293b;
    border-radius: 18px 18px 18px 4px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
    border: 1px solid #edf2f7;
}

.msg-sender-name {
    font-size: 0.75rem;
    font-weight: 700;
    color: #15803d;
    margin-bottom: 0.3rem;
    display: flex;
    align-items: center;
    gap: 0.35rem;
}

.msg-time-status {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.35rem;
    font-size: 0.685rem;
    margin-top: 0.35rem;
}

.chat-msg-row.outgoing .msg-time-status {
    color: rgba(255, 255, 255, 0.82);
}

.chat-msg-row.incoming .msg-time-status {
    color: #94a3b8;
}

/* Attachment in bubble */
.msg-attachment-img {
    max-width: 280px;
    max-height: 220px;
    border-radius: 0.85rem;
    cursor: pointer;
    margin-bottom: 0.4rem;
    display: block;
    object-fit: cover;
    border: 2px solid rgba(255, 255, 255, 0.2);
    transition: transform 0.2s ease;
}

.msg-attachment-img:hover {
    transform: scale(1.02);
}

.msg-attachment-file {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.6rem 0.85rem;
    border-radius: 0.85rem;
    margin-bottom: 0.35rem;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.825rem;
    transition: all 0.2s ease;
}

.chat-msg-row.outgoing .msg-attachment-file {
    background: rgba(255, 255, 255, 0.18);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.3);
}

.chat-msg-row.incoming .msg-attachment-file {
    background: #f1f5f9;
    color: #0f172a;
    border: 1px solid #e2e8f0;
}

.msg-actions-btn {
    opacity: 0;
    background: none;
    border: none;
    color: rgba(255, 255, 255, 0.7);
    padding: 0.15rem 0.3rem;
    cursor: pointer;
    font-size: 0.8rem;
    transition: opacity 0.2s;
    border-radius: 4px;
}
.chat-msg-row:hover .msg-actions-btn {
    opacity: 1;
}
.msg-actions-btn:hover {
    color: #ffffff;
    background: rgba(0, 0, 0, 0.15);
}

/* Quick Replies Chips */
.quick-replies-bar {
    display: flex;
    gap: 0.45rem;
    padding: 0.55rem 1.15rem;
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(8px);
    border-top: 1px solid #f1f5f9;
    overflow-x: auto;
    scrollbar-width: none;
}
.quick-replies-bar::-webkit-scrollbar {
    display: none;
}

.quick-chip {
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    background: #f1f5f9;
    border: 1px solid #e2e8f0;
    color: #475569;
    font-size: 0.75rem;
    font-weight: 500;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s ease;
}

.quick-chip:hover, .quick-chip:active {
    background: #dcfce7;
    color: #166534;
    border-color: #86efac;
    transform: translateY(-1px);
}

/* Staged Attachment Preview */
.staged-attachment-bar {
    display: none;
    align-items: center;
    justify-content: space-between;
    padding: 0.55rem 1.15rem;
    background: #f0fdf4;
