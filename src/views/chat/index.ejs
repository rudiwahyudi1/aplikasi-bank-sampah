        padding: calc(6px + env(safe-area-inset-top, 0px)) 10px 8px 10px !important;
        gap: 6px !important;
        touch-action: none !important;
    }

    .header-left {
        flex: 1 1 auto !important;
        min-width: 0 !important;
        gap: 8px !important;
    }

    .mobile-back-btn {
        display: inline-flex !important;
