    background: #f8fafc;
    border: 1px solid #e2e8f0;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s ease;
}

.cat-pill:hover {
    background: #f1f5f9;
    color: #1e293b;
}

.cat-pill.active {
    background: #16a34a;
    color: #ffffff;
    border-color: #16a34a;
    box-shadow: 0 2px 8px rgba(22, 163, 74, 0.3);
}

/* Contact List */
.contacts-scrollable {
    flex: 1;
    overflow-y: auto;
    padding: 0.5rem;
}

.contact-item {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.75rem 0.85rem;
    border-radius: 1rem;
    cursor: pointer;
    transition: all 0.2s ease;
    border: 1px solid transparent;
    margin-bottom: 0.25rem;
    position: relative;
    background: #ffffff;
}

.contact-item:hover {
    background: #f8fafc;
    transform: translateY(-1px);
}

.contact-item.active {
    background: #eafaf1;
    border-color: #86efac;
    box-shadow: 0 4px 14px rgba(22, 163, 74, 0.08);
}

.contact-avatar {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
