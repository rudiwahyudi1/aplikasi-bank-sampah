<!-- ============================================================
     PENGGUNA (SATU CARD UTAMA)
============================================================ -->
<div class="card bg-white border-0 p-3 p-md-4 rounded-4 shadow-sm">
    <div class="users-page">
        <!-- ====================================================
             HEADER
        ===================================================== -->
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
            <div class="d-flex align-items-center gap-2">
                <div style="width:38px; height:38px; border-radius:12px; background:#e9f8ef; color:#16a34a; display:grid; place-items:center; font-size:18px;">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div>
                    <h5 class="mb-0 fw-bold" style="color: #202939; letter-spacing: 0.5px;">MANAJEMEN PENGGUNA</h5>
                    <div class="small mt-1" style="color: #16a34a; font-size: 11px;">
                        Kelola data akun, peran akses, kontak, dan status keaktifan pengguna sistem.
                    </div>
                </div>
            </div>

            <% if (canCreateUser) { %>
                <button
                    type="button"
                    class="btn btn-success fw-bold d-inline-flex align-items-center gap-2 px-3 py-2 rounded-3 shadow-sm"
                    data-bs-toggle="modal"
                    data-bs-target="#add"
                >
                    <i class="bi bi-plus-lg"></i>
                    <span>Tambah Pengguna</span>
                </button>
            <% } %>
        </div>


        <!-- ====================================================
             STATISTICS
        ===================================================== -->
        <div class="users-stats">

            <!-- TOTAL -->
            <div class="users-stat">

                <div class="users-stat-icon total">
                    <i class="bi bi-people"></i>
                </div>

                <div>

                    <div class="users-stat-value">
                        <%= totalUsers %>
                    </div>

                    <div class="users-stat-label">
                        Total Pengguna
                    </div>

                </div>

            </div>


            <!-- ACTIVE -->
            <div class="users-stat">

                <div class="users-stat-icon active">
                    <i class="bi bi-person-check"></i>
                </div>

                <div>

                    <div class="users-stat-value">
                        <%= activeUsers %>
                    </div>

                    <div class="users-stat-label">
                        Pengguna Aktif
                    </div>

                </div>

            </div>


            <!-- INACTIVE -->
            <div class="users-stat">

                <div class="users-stat-icon inactive">
                    <i class="bi bi-person-x"></i>
                </div>

                <div>

                    <div class="users-stat-value">
                        <%= inactiveUsers %>
                    </div>

                    <div class="users-stat-label">
                        Tidak Aktif
                    </div>

                </div>

            </div>


            <!-- SALDO -->
            <div class="users-stat">

                <div class="users-stat-icon wallet">
                    <i class="bi bi-wallet2"></i>
                </div>

                <div>

                    <div class="users-stat-value users-money">
                        Rp <%= Number(totalBalance).toLocaleString('id-ID') %>
                    </div>

                    <div class="users-stat-label">
                        Total Saldo
                    </div>

                </div>

            </div>

        </div>


        <!-- ====================================================
             TABLE
        ===================================================== -->
        <div class="users-table-wrap p-3">

            <div class="users-table-rounded">

                <table class="users-table">

                    <thead>

                        <tr>
                            <th>User</th>
                            <th>Kontak</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th>Saldo</th>
                            <th>Login Terakhir</th>
                            <th class="text-end">Aksi</th>
                        </tr>

                    </thead>

                    <tbody>

                        <% if (!userRows.length) { %>

                            <tr>

                                <td
                                    colspan="7"
                                    class="users-empty-cell"
                                >

                                    <div class="users-empty">

                                        <div class="users-empty-icon">
                                            <i class="bi bi-people"></i>
                                        </div>

                                        <div class="users-empty-title">
                                            Belum Ada Pengguna
                                        </div>

                                        <div class="users-empty-text">
                                            Belum ada pengguna yang tersedia.
                                        </div>

                                    </div>

                                </td>

                            </tr>

                        <% } else { %>

                            <% userRows.forEach(u => { %>

                                <%
                                    const statusText =
                                        u.status || "-";

                                    const statusClass =
                                        String(statusText)
                                            .toLowerCase() === "active"
                                            ? "status-active"
                                            : "status-inactive";
                                %>

                                <tr>

                                    <!-- USER -->
                                    <td>

                                        <div class="users-user">

                                            <div class="users-avatar">
                                                <i class="bi bi-person-fill"></i>
                                            </div>

                                            <div class="users-user-info">

                                                <div class="users-user-name">
                                                    <%= u.full_name || "-" %>
                                                </div>

                                                <div class="users-user-meta">
                                                    @<%= u.username || "-" %>

                                                    <% if (u.email) { %>
                                                        · <%= u.email %>
                                                    <% } %>
                                                </div>

                                                <% if (u.ktp_number || u.bank_account_number) { %>
                                                    <div class="d-flex flex-wrap gap-1 mt-1">
                                                        <% if (u.ktp_number) { %>
                                                            <span class="badge bg-light text-secondary border px-1 py-0" style="font-size:9.5px; font-weight:600;" title="No. KTP">
                                                                <i class="bi bi-person-vcard text-primary me-1"></i><%= u.ktp_number %><% if (u.age) { %> (<%= u.age %> th)<% } %>
                                                            </span>
                                                        <% } %>
                                                        <% if (u.bank_name && u.bank_account_number) { %>
                                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-1 py-0" style="font-size:9.5px; font-weight:600;" title="Rekening Pembayaran Sales">
                                                                <i class="bi bi-bank me-1"></i><%= u.bank_name %>: <%= u.bank_account_number %>
                                                            </span>
                                                        <% } %>
                                                    </div>
                                                <% } %>

                                            </div>

                                        </div>

                                    </td>


                                    <!-- KONTAK -->
                                    <td>

                                        <div class="users-contact">

                                            <i class="bi bi-telephone"></i>

                                            <span>
                                                <%= u.phone || "-" %>
                                            </span>

                                        </div>

                                        <% if (u.address) { %>
                                            <div class="small text-muted mt-1 text-truncate" style="max-width:180px; font-size:10px;" title="<%= u.address %>">
                                                <i class="bi bi-geo-alt me-1"></i><%= u.address %>
                                            </div>
                                        <% } %>

                                    </td>


                                    <!-- ROLE -->
                                    <td>

                                        <span class="users-role">

                                            <i class="bi bi-shield-check me-1"></i>

                                            <%= u.roles || "-" %>

                                        </span>

                                    </td>


                                    <!-- STATUS -->
                                    <td>

                                        <span
                                            class="users-status <%= statusClass %>"
                                        >

                                            <i class="bi bi-circle-fill"></i>

                                            <%= statusText %>

                                        </span>

                                    </td>


                                    <!-- SALDO -->
                                    <td>

                                        <div class="users-balance">

                                            <i class="bi bi-wallet2"></i>

                                            <span>
                                                Rp <%= Number(
                                                    u.wallet_balance || 0
                                                ).toLocaleString('id-ID') %>
                                            </span>

                                        </div>

                                    </td>


                                    <!-- LOGIN -->
                                    <td>

                                        <div class="users-login">

                                            <% if (u.last_login_at) { %>

                                                <div class="users-login-date">

                                                    <%= new Date(
                                                        u.last_login_at
                                                    ).toLocaleDateString(
                                                        'id-ID'
                                                    ) %>

                                                </div>

                                                <div class="users-login-time">

                                                    <i class="bi bi-clock me-1"></i>

                                                    <%= new Date(
                                                        u.last_login_at
                                                    ).toLocaleTimeString(
                                                        'id-ID',
                                                        {
                                                            hour: '2-digit',
                                                            minute: '2-digit'
                                                        }
                                                    ) %>

                                                </div>

                                            <% } else { %>

                                                <span class="users-muted">
                                                    Belum login
                                                </span>

                                            <% } %>

                                        </div>

                                    </td>


                                    <!-- ACTION -->
                                    <td class="text-end">

                                        <div class="users-actions">

                                            <% if (canUpdateUser) { %>

                                                <button
                                                    type="button"
                                                    class="users-action-btn edit"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#edit<%= u.id %>"
                                                    title="Edit Pengguna"
                                                >
                                                    <i class="bi bi-pencil"></i>
                                                </button>

                                            <% } %>


                                            <% if (canDeleteUser) { %>

                                                <form
                                                    class="d-inline"
                                                    method="post"
                                                    action="/admin/users/<%= u.id %>/delete"
                                                    onsubmit="return confirm('Hapus user ini?')"
                                                >

                                                    <button
                                                        type="submit"
                                                        class="users-action-btn delete"
                                                        title="Hapus Pengguna"
                                                    >
                                                        <i class="bi bi-trash"></i>
                                                    </button>

                                                </form>

                                            <% } %>

                                        </div>

                                    </td>

                                </tr>

                            <% }) %>

                        <% } %>

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>
</div>

<!-- ============================================================
     MODAL TAMBAH
============================================================ -->
<% if (canCreateUser) { %>

<div
    class="modal fade users-modal"
    id="add"
    tabindex="-1"
    aria-hidden="true"
>

    <div class="modal-dialog modal-dialog-centered modal-lg">

        <form
            class="modal-content"
            method="post"
            action="/admin/users/add"
        >

            <div class="modal-header users-modal-header">

                <div class="users-modal-title-wrap">

                    <div class="users-modal-icon add">
                        <i class="bi bi-person-plus"></i>
                    </div>

                    <div>

                        <h5 class="modal-title">
                            Tambah Pengguna
                        </h5>

                        <div class="users-modal-subtitle">
                            Tambahkan pengguna baru ke sistem.
                        </div>

                    </div>

                </div>

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="modal"
                    aria-label="Close"
                ></button>

            </div>


            <div class="modal-body users-modal-body">

                <%- include('../partials/form-user', {
                    u: null,
                    roles
                }) %>

            </div>


            <div class="modal-footer users-modal-footer">

                <button
                    type="button"
                    class="users-cancel-btn"
                    data-bs-dismiss="modal"
                >
                    Batal
                </button>

                <button
                    type="submit"
                    class="users-save-btn"
                >
                    <i class="bi bi-check-lg me-1"></i>
                    Simpan Pengguna
                </button>

            </div>

        </form>

    </div>

</div>

<% } %>


<!-- ============================================================
     MODAL EDIT
============================================================ -->
<% userRows.forEach(u => { %>

    <% if (canUpdateUser) { %>

    <div
        class="modal fade users-modal"
        id="edit<%= u.id %>"
        tabindex="-1"
        aria-hidden="true"
    >

        <div class="modal-dialog modal-dialog-centered modal-lg">

            <form
                class="modal-content"
                method="post"
                action="/admin/users/<%= u.id %>/update"
            >

                <div class="modal-header users-modal-header">

                    <div class="users-modal-title-wrap">

                        <div class="users-modal-icon edit">
                            <i class="bi bi-pencil-square"></i>
                        </div>

                        <div>

                            <h5 class="modal-title">
                                Edit Pengguna
                            </h5>

                            <div class="users-modal-subtitle">
                                Perbarui informasi pengguna.
                            </div>

                        </div>

                    </div>

                    <button
                        type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"
                    ></button>

                </div>


                <div class="modal-body users-modal-body">

                    <%- include('../partials/form-user', {
                        u,
                        roles
                    }) %>

                </div>


                <div class="modal-footer users-modal-footer">

                    <button
                        type="button"
                        class="users-cancel-btn"
                        data-bs-dismiss="modal"
                    >
                        Batal
                    </button>

                    <button
                        type="submit"
                        class="users-save-btn"
                    >
                        <i class="bi bi-check-lg me-1"></i>
                        Simpan Perubahan
                    </button>

                </div>

            </form>

        </div>

    </div>

    <% } %>

<% }) %>

<script>
function toggleUserPasswordVisibility(inputId, btn) {
    const input = document.getElementById(inputId);
    if (!input) return;
    const icon = btn.querySelector('i');
    if (input.type === 'password') {
        input.type = 'text';
        if (icon) {
            icon.classList.remove('bi-eye');
            icon.classList.add('bi-eye-slash');
        }
    } else {
        input.type = 'password';
        if (icon) {
            icon.classList.remove('bi-eye-slash');
            icon.classList.add('bi-eye');
        }
    }
}
</script>

