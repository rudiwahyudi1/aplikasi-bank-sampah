<%
/* ============================================================
   SAFE DATA
============================================================ */
const userRows =
    (typeof users !== "undefined" && Array.isArray(users))
        ? users
        : [];

const permissionList =
    (typeof permissions !== "undefined" && Array.isArray(permissions))
        ? permissions
        : [];

const isSuperadmin =
    user?.role === "superadmin";

const canCreateUser =
    permissionList.includes("users.create") || isSuperadmin;

const canUpdateUser =
    permissionList.includes("users.update") || isSuperadmin;

const canDeleteUser =
    permissionList.includes("users.delete") || isSuperadmin;

const totalUsers = userRows.length;

const activeUsers = userRows.filter(u =>
    String(u.status || "").toLowerCase() === "active"
).length;

const inactiveUsers = userRows.filter(u =>
    String(u.status || "").toLowerCase() !== "active"
).length;

const totalBalance = userRows.reduce((sum, u) => {
    return sum + Number(u.wallet_balance || 0);
}, 0);
%>

<style>

/* ============================================================
   USERS PAGE
============================================================ */

.users-page {
    width: 100%;
}


/* ============================================================
   MAIN CARD
============================================================ */

.users-card {
    background: #fff;
    border: 1px solid #e8e8ed;
    border-radius: 22px;
    overflow: hidden;

    box-shadow:
        0 10px 30px rgba(31, 41, 55, .06);
}


/* ============================================================
   HEADER
============================================================ */

.users-header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 15px;

    padding: 20px 22px;

    border-bottom: 1px solid #e8e8ed;

    background:
        linear-gradient(
            180deg,
            #fff 0%,
            #fbfbfd 100%
        );
}

.users-header-left {
    display: flex;
    align-items: center;
    gap: 12px;
}

.users-title-icon {
    width: 38px;
    height: 38px;
    min-width: 38px;

    display: grid;
    place-items: center;

    border-radius: 12px;

    background: #eaf8ef;
    color: #16a34a;

    font-size: 17px;
}

.users-title {
    margin: 0;

    color: #172033;

    font-size: 16px;
    font-weight: 800;
}

.users-subtitle {
    margin-top: 2px;

    color: #8b94a4;

    font-size: 12px;
}

.users-add-btn {
    height: 39px;

    padding: 0 14px;

    border: 0;
    border-radius: 11px;

    background: #16a34a;
    color: #fff;

    font-size: 12px;
    font-weight: 700;

    box-shadow:
        0 5px 14px rgba(22, 163, 74, .15);

    transition: all .2s ease;
}

.users-add-btn:hover {
    background: #15803d;
    transform: translateY(-1px);
}


/* ============================================================
   STATS
============================================================ */

.users-stats {
    display: grid;
    grid-template-columns:
        repeat(4, minmax(0, 1fr));

    gap: 12px;

    padding: 18px 22px 8px;
}

.users-stat {
    min-height: 78px;

    display: flex;
    align-items: center;

    gap: 12px;

    padding: 14px;

    border: 1px solid #e8e8ed;
    border-radius: 16px;

    background: #fff;
}

.users-stat-icon {
    width: 38px;
    height: 38px;
    min-width: 38px;

    display: grid;
    place-items: center;

    border-radius: 12px;

    font-size: 16px;
}

.users-stat-icon.total {
    background: #eaf8ef;
    color: #16a34a;
}

.users-stat-icon.active {
    background: #edf8f0;
    color: #22a052;
}

.users-stat-icon.inactive {
    background: #fff2f2;
    color: #dc5a5a;
}

.users-stat-icon.wallet {
    background: #fff7df;
    color: #c88700;
}

.users-stat-value {
    color: #172033;

    font-size: 22px;
    line-height: 1;

    font-weight: 800;
}

.users-money {
    font-size: 17px;
}

.users-stat-label {
    margin-top: 5px;

    color: #8b94a4;

    font-size: 10px;
}


/* ============================================================
   TABLE
============================================================ */

.users-table-wrap {
    width: 100%;
    overflow-x: auto;

    margin-top: 10px;
}

.users-table {
    width: 100%;

    min-width: 950px;

    border-collapse: separate;
    border-spacing: 0;
}

.users-table thead th {
    padding: 12px 22px;

    border-top: 1px solid #e8e8ed;
    border-bottom: 1px solid #e8e8ed;

    background: #fbfbfd;

    color: #8b94a4;

    font-size: 10px;
    font-weight: 800;

    letter-spacing: .45px;
    text-transform: uppercase;

    white-space: nowrap;
}

.users-table tbody td {
    padding: 14px 22px;

    border-bottom: 1px solid #edf0f4;

    color: #566071;

    font-size: 12px;

    vertical-align: middle;
}

.users-table tbody tr {
    transition: background .2s ease;
}

.users-table tbody tr:hover {
    background: #fbfcfd;
}

.users-table tbody tr:last-child td {
    border-bottom: 0;
}


/* ============================================================
   USER
============================================================ */

.users-user {
    display: flex;
    align-items: center;

    gap: 11px;

    min-width: 220px;
}

.users-avatar {
    width: 38px;
    height: 38px;
    min-width: 38px;

    display: grid;
    place-items: center;

    border-radius: 12px;

    background: #eaf8ef;
    color: #16a34a;

    font-size: 15px;
}

.users-user-info {
    min-width: 0;
}

.users-user-name {
    color: #172033;

    font-size: 12px;
    font-weight: 750;
}

.users-user-meta {
    margin-top: 3px;

    color: #9aa3b1;

    font-size: 10px;

    white-space: nowrap;
}


/* ============================================================
   CONTACT
============================================================ */

.users-contact {
    display: inline-flex;
    align-items: center;

    gap: 7px;

    color: #667085;
}

.users-contact i {
    color: #8b94a4;
}


/* ============================================================
   ROLE
============================================================ */

.users-role {
    display: inline-flex;
    align-items: center;

    padding: 6px 9px;

    border-radius: 9px;

    background: #f4f6f8;

    color: #596273;

    font-size: 10px;
    font-weight: 650;
}


/* ============================================================
   STATUS
============================================================ */

.users-status {
    display: inline-flex;
    align-items: center;

    gap: 6px;

    padding: 6px 9px;

    border-radius: 9px;

    font-size: 10px;
    font-weight: 700;
}

.users-status i {
    font-size: 6px;
}

.users-status.status-active {
    background: #eaf8ef;
    color: #16813d;
}

.users-status.status-inactive {
    background: #f1f3f5;
    color: #7b8492;
}


/* ============================================================
   BALANCE
============================================================ */

.users-balance {
    display: inline-flex;
    align-items: center;

    gap: 7px;

    color: #172033;

    font-weight: 700;
}

.users-balance i {
    color: #16a34a;
}


/* ============================================================
   LOGIN
============================================================ */

.users-login-date {
    color: #566071;

    font-size: 11px;
}

.users-login-time {
    margin-top: 3px;

    color: #9aa3b1;

    font-size: 9px;
}

.users-muted {
    color: #9aa3b1;
    font-size: 10px;
}


/* ============================================================
   ACTION
============================================================ */

.users-actions {
    display: inline-flex;
    align-items: center;

    gap: 6px;
}

.users-action-btn {
    width: 33px;
    height: 33px;

    display: inline-grid;
    place-items: center;

    padding: 0;

    border: 1px solid #e3e7ec;
    border-radius: 10px;

    background: #fff;

    color: #667085;

    font-size: 12px;

    transition: all .2s ease;
}

.users-action-btn:hover {
    background: #f7f8fa;
    transform: translateY(-1px);
}

.users-action-btn.edit:hover {
    color: #16a34a;
    border-color: #cde8d4;
}

.users-action-btn.delete {
    color: #dc5a5a;
}

.users-action-btn.delete:hover {
    background: #fff5f5;
    border-color: #f2cccc;
}


/* ============================================================
   EMPTY
============================================================ */

.users-empty-cell {
    padding: 0 !important;
}

.users-empty {
    padding: 60px 20px;

    text-align: center;
}

.users-empty-icon {
    width: 58px;
    height: 58px;

    margin: 0 auto 14px;

    display: grid;
    place-items: center;

    border-radius: 17px;

    background: #f1f8f3;
    color: #16a34a;

    font-size: 22px;
}

.users-empty-title {
    color: #172033;

    font-size: 14px;
    font-weight: 800;
}

.users-empty-text {
    margin-top: 5px;

    color: #8b94a4;

    font-size: 11px;
}


/* ============================================================
   MODAL (IDENTIK DENGAN JENIS SAMPAH)
============================================================ */

.users-modal .modal-dialog {
    max-width: 720px;
}

.users-modal .modal-content {
    border: 0;
    border-radius: 22px;
    overflow: hidden;
    box-shadow: 0 25px 70px rgba(15, 23, 42, .18);
}

.users-modal-header {
    padding: 20px 22px;
    border-bottom: 1px solid #edf0f4;
    background: #ffffff;
}

.users-modal-title-wrap {
    display: flex;
    align-items: center;
    gap: 12px;
}

.users-modal-icon {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
}

.users-modal-icon.add {
    background: #edf9f1;
    color: #16a34a;
}

.users-modal-icon.edit {
    background: #edf9f1;
    color: #16a34a;
}

.users-modal .modal-title {
    margin: 0;
    color: #172033;
    font-size: 16px;
    font-weight: 800;
}

.users-modal-subtitle {
    margin-top: 3px;
    color: #9aa2af;
    font-size: 11px;
}

.users-modal-body {
    padding: 22px;
}

.users-modal-footer {
    display: flex;
    justify-content: flex-end;

    gap: 8px;

    padding: 14px 20px;

    border-top: 1px solid #e8e8ed;

    background: #fbfbfd;
}

.users-cancel-btn {
    height: 38px;

    padding: 0 14px;

    border: 1px solid #e1e6ed;
    border-radius: 11px;

    background: #fff;

    color: #667085;

    font-size: 11px;
    font-weight: 650;
}

.users-save-btn {
    height: 38px;

    padding: 0 15px;

    border: 0;
    border-radius: 11px;

    background: #16a34a;
    color: #fff;

    font-size: 11px;
    font-weight: 700;
}

.users-save-btn:hover {
    background: #15803d;
}


/* ============================================================
   MOBILE
============================================================ */

@media (max-width: 991.98px) {

    .users-stats {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
    }

}


@media (max-width: 767.98px) {

    .users-card {
        border-radius: 18px;
    }

    .users-header {
        padding: 17px 16px;
    }

    .users-add-btn {
        height: 36px;

        padding: 0 10px;

        font-size: 10px;
    }

    .users-stats {
        padding: 14px 16px 7px;

        gap: 8px;
    }

    .users-stat {
        min-height: 68px;

        padding: 11px;

        border-radius: 14px;
    }

    .users-stat-icon {
        width: 34px;
        height: 34px;
        min-width: 34px;

        border-radius: 10px;
    }

    .users-stat-value {
        font-size: 19px;
    }

    .users-money {
        font-size: 14px;
    }

    .users-table thead th,
    .users-table tbody td {
        padding-left: 16px;
        padding-right: 16px;
    }

    .users-modal-body {
        padding: 16px;
    }

}


@media (max-width: 480px) {

    .users-header {
        align-items: flex-start;
    }

    .users-header-left {
        min-width: 0;
    }

    .users-title {
        font-size: 14px;
    }

    .users-subtitle {
        font-size: 10px;
    }

    .users-add-btn {
        white-space: nowrap;
    }

    .users-stat-icon {
        display: none;
    }

    .users-stat-value {
        font-size: 18px;
    }

}

