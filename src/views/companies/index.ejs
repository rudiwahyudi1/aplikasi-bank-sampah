<!-- ============================================================
     PERUSAHAAN
     BOOTSTRAP STYLE — COLLECTION LOOK
============================================================= -->

<style>
/* ============================================================
   COMPANY PAGE
============================================================ */

.company-page {
    color: #212529;
    font-size: 13px;
}

/* ============================================================
   PAGE HEADER
============================================================ */

.company-page .page-icon {
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: #e9f8ef;
    color: #16a34a;
    display: grid;
    place-items: center;
    flex: 0 0 34px;
}

.company-page .page-title {
    font-size: 18px;
    font-weight: 700;
    line-height: 1.2;
    margin: 0;
    color: #202939;
}

.company-page .page-subtitle {
    color: #16a34a;
    font-size: 10px;
    margin-top: 4px;
}

/* ============================================================
   CONTENT CARD
============================================================ */

.company-page .content-card {
    border: 1px solid #edf0f3 !important;
    border-radius: 16px !important;
    background: #fff;
    box-shadow: 0 1px 3px rgba(16, 24, 40, .04);
}

/* ============================================================
   SECTION HEADER
============================================================ */

.company-page .section-card-header {
    padding: 16px 18px;
    border-bottom: 1px solid #edf0f3;
    background: #fff;
    border-radius: 16px 16px 0 0;
}

.company-page .section-title {
    color: #202939;
    font-size: 13px;
    font-weight: 700;
}

.company-page .section-subtitle {
    color: #929baa;
    font-size: 10px;
    margin-top: 4px;
}

/* Buttons */
.btn-ios-success {
    border: 0;
    background: #22a447;
    color: #fff;
    border-radius: 12px;
    padding: 9px 14px;
    font-size: 13px;
    font-weight: 600;
    box-shadow: 0 3px 10px rgba(34,164,71,.18);
    transition: .2s ease;
}

.btn-ios-success:hover {
    background: #1d963f;
    color: #fff;
    transform: translateY(-1px);
}

/* ============================================================
   TABLE
============================================================ */

.company-page .table-wrap {
    width: 100%;
    overflow-x: auto;
}

.company-page .table {
    min-width: 900px;
    margin-bottom: 0;
}

.company-page .table thead th {
    background: #f8f9fa;
    color: #6c757d;
    border-bottom: 1px solid #e9ecef;
    font-size: 10px;
    font-weight: 700;
    white-space: nowrap;
    padding: 12px 14px;
}

.company-page .table tbody td {
    padding: 13px 14px;
    border-color: #f0f2f4;
    font-size: 11px;
    vertical-align: middle;
}

.company-page .table tbody tr:hover {
    background: #fafcfb;
}

/* ============================================================
   COMPANY NAME
============================================================ */

.company-page .company-name {
    color: #202939;
    font-size: 11px;
    font-weight: 700;
}

.company-page .company-meta {
    color: #8a93a1;
    font-size: 9px;
    margin-top: 4px;
}

/* ============================================================
   CONTACT TEXT
============================================================ */

.company-page .contact-text {
    color: #596273;
    font-size: 10px;
}

.company-page .contact-text i {
    color: #16a34a;
    margin-right: 5px;
}

/* ============================================================
   STATUS
============================================================ */

.company-page .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 5px 9px;
    border-radius: 999px;
    font-size: 9px;
    font-weight: 700;
    white-space: nowrap;
    background: #e9f8ee;
    color: #16803c;
}

.company-page .status-badge.inactive {
    background: #f2f4f7;
    color: #667085;
}

.company-page .status-badge i {
    font-size: 8px;
}

/* ============================================================
   ACTION BUTTON
============================================================ */

.company-page .action-btn {
    width: 31px;
    height: 31px;
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 9px;
    font-size: 12px;
}

.company-page .action-btn:hover {
    background: #f4f6f8;
}

/* ============================================================
   EMPTY STATE
============================================================ */

.company-page .empty-state {
    padding: 50px 20px;
    text-align: center;
}

.company-page .empty-icon {
    width: 58px;
    height: 58px;
    border-radius: 18px;
    background: #f4f6f8;
    color: #9ba4b2;
    display: grid;
    place-items: center;
    margin: 0 auto 12px;
    font-size: 23px;
}

.company-page .empty-title {
    color: #4c5668;
    font-size: 13px;
    font-weight: 700;
}

.company-page .empty-text {
    color: #9aa2af;
    font-size: 10px;
    margin-top: 4px;
}

/* ============================================================
   BUTTON
============================================================ */

.company-page .btn {
    font-size: 11px;
    border-radius: 9px;
}

/* ============================================================
   MODAL
============================================================ */

.company-page .modal-content {
    border: 0;
    border-radius: 16px;
    box-shadow: 0 18px 55px rgba(16, 24, 40, .18);
    overflow: hidden;
}

.company-page .modal-header {
    padding: 16px 18px;
    border-bottom: 1px solid #edf0f3;
    background: #fff;
}

.company-page .modal-title {
    color: #202939;
    font-size: 15px;
    font-weight: 700;
}

.company-page .modal-subtitle {
    color: #929baa;
    font-size: 10px;
    margin-top: 4px;
}

.company-page .modal-body {
    padding: 18px;
}

.company-page .modal-footer {
    padding: 14px 18px;
    border-top: 1px solid #edf0f3;
    background: #fff;
}

/* ============================================================
   FORM
============================================================ */

.company-page .form-label {
    color: #596273;
    font-size: 11px;
    font-weight: 600;
    margin-bottom: 6px;
}

.company-page .form-control,
.company-page .form-select {
    min-height: 38px;
    border-color: #dfe4ea;
    border-radius: 0 10px 10px 0;
    font-size: 11px;
    box-shadow: none;
}

.company-page textarea.form-control {
    border-radius: 0 10px 10px 0;
}

.company-page .form-control:focus,
.company-page .form-select:focus {
    border-color: #86b7fe;
    box-shadow: 0 0 0 .15rem rgba(13, 110, 253, .08);
}

.company-page .input-group {
    width: 100%;
}

.company-page .input-group-text {
    min-width: 42px;
    justify-content: center;
    border-color: #dfe4ea;
    background: #f8f9fa;
    color: #6c757d;
    border-radius: 10px 0 0 10px;
}

.company-page .input-group-text i {
    font-size: 14px;
}

.company-page .form-help {
    color: #9aa2af;
    font-size: 9px;
    margin-top: 5px;
}

/* ============================================================
   MODAL HEADER ICON
============================================================ */

.company-page .modal-heading-icon {
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: #e9f8ef;
    color: #16a34a;
    display: grid;
    place-items: center;
    flex: 0 0 34px;
}

/* ============================================================
   RESPONSIVE
============================================================ */

@media (max-width: 767.98px) {

    .company-page .page-title {
        font-size: 16px;
    }

    .company-page .table {
        min-width: 850px;
    }

    .company-page .modal-body {
        padding: 15px;
    }

    .company-page .modal-header {
        padding: 14px 15px;
    }

    .company-page .modal-footer {
        padding: 12px 15px;
    }
}
</style>


<!-- ============================================================
     MAIN CARD
============================================================= -->

<div class="card bg-white border-0 p-3 p-md-4 rounded-4 shadow-sm">

    <div class="company-page">

        <!-- ====================================================
             PAGE HEADER
        ===================================================== -->

        <div class="mb-4">

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">

                <!-- TITLE -->

                <div class="d-flex align-items-center gap-2">

                    <div class="page-icon">
                        <i class="bi bi-building"></i>
                    </div>

                    <div>

                        <h5 class="mb-0">
                            PERUSAHAAN
                        </h5>

                    </div>

                </div>


                <!-- ACTION -->

                <% if (canManage) { %>

                    <button
                        type="button"
                        class="btn-ios-success"
                        data-bs-toggle="modal"
                        data-bs-target="#addCompanyModal">

                        <i class="bi bi-plus-lg me-1"></i>

                        Tambah Perusahaan

                    </button>

                <% } %>

            </div>

        </div>


        <!-- ====================================================
             DATA CARD
        ===================================================== -->

        <div class="content-card card mb-4">


            <!-- SECTION HEADER -->

            <div class="section-card-header d-flex flex-wrap justify-content-between align-items-center gap-3">

                <div>

                    <div class="section-title">

                        <i class="bi bi-building me-1 text-success"></i>

                        Daftar Perusahaan

                    </div>

                    <div class="section-subtitle">

                        Kelola data perusahaan yang terdaftar pada sistem.

                    </div>

                </div>


                <div class="section-subtitle">

                    <strong>
                        <%= rows.length %>
                    </strong>
                    perusahaan

                </div>

            </div>


            <!-- =================================================
                 TABLE
            ================================================== -->

            <div class="table-wrap">

                <table class="table table-hover align-middle mb-0">

                    <thead>

                        <tr>

                            <th>
                                <i class="bi bi-building me-1"></i>
                                Nama
                            </th>

                            <th>
                                <i class="bi bi-geo-alt me-1"></i>
                                Alamat
                            </th>

                            <th>
                                <i class="bi bi-telephone me-1"></i>
                                Telepon
                            </th>

                            <th>
                                <i class="bi bi-envelope me-1"></i>
                                Email
                            </th>

                            <th>
                                <i class="bi bi-toggle2-on me-1"></i>
                                Status
                            </th>

                            <th class="text-end">
                                <i class="bi bi-three-dots-vertical me-1"></i>
                                Aksi
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        <% if (rows.length > 0) { %>

                            <% rows.forEach(r => { %>

                                <tr>

                                    <!-- =================================
                                         NAMA
                                    ================================== -->

                                    <td>

                                        <div class="company-name">

                                            <i class="bi bi-building me-1 text-success"></i>

                                            <%= r.name || "-" %>

                                        </div>

                                        <div class="company-meta">

                                            ID:
                                            <%= r.id %>

                                        </div>

                                    </td>


                                    <!-- =================================
                                         ALAMAT
                                    ================================== -->

                                    <td>

                                        <div class="contact-text">

                                            <i class="bi bi-geo-alt"></i>

                                            <%= r.address || "-" %>

                                        </div>

                                    </td>


                                    <!-- =================================
                                         TELEPON
                                    ================================== -->

                                    <td>

                                        <div class="contact-text">

                                            <i class="bi bi-telephone"></i>

                                            <%= r.phone || "-" %>

                                        </div>

                                    </td>


                                    <!-- =================================
                                         EMAIL
                                    ================================== -->

                                    <td>

                                        <div class="contact-text">

                                            <i class="bi bi-envelope"></i>

                                            <%= r.email || "-" %>

                                        </div>

                                    </td>


                                    <!-- =================================
                                         STATUS
                                    ================================== -->

                                    <td>

                                        <% if (
                                            String(r.status || "").toLowerCase() === "active" ||
                                            String(r.status || "").toLowerCase() === "aktif"
                                        ) { %>

                                            <span class="status-badge">

                                                <i class="bi bi-check-circle-fill"></i>

                                                <%= r.status %>

                                            </span>

                                        <% } else { %>

                                            <span class="status-badge inactive">

                                                <i class="bi bi-dash-circle-fill"></i>

                                                <%= r.status || "-" %>

                                            </span>

                                        <% } %>

                                    </td>


                                    <!-- =================================
                                         AKSI
                                    ================================== -->

                                    <td class="text-end">

                                        <% if (canManage) { %>

                                            <div class="d-flex justify-content-end gap-1">

                                                <!-- EDIT -->

                                                <button
                                                    type="button"
                                                    class="btn btn-sm btn-light border action-btn"
                                                    title="Edit Perusahaan"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#editCompany<%= r.id %>">

                                                    <i class="bi bi-pencil"></i>

                                                </button>


                                                <!-- DELETE -->

                                                <form
                                                    method="post"
                                                    action="/companies/<%= r.id %>/delete"
                                                    class="d-inline"
                                                    onsubmit="return confirm('Hapus perusahaan ini?')">

                                                    <button
                                                        type="submit"
                                                        class="btn btn-sm btn-light border action-btn text-danger"
                                                        title="Hapus Perusahaan">

                                                        <i class="bi bi-trash"></i>

                                                    </button>

                                                </form>

                                            </div>

                                        <% } %>

                                    </td>

                                </tr>

                            <% }) %>

                        <% } else { %>

                            <!-- =====================================
                                 EMPTY
                            ====================================== -->

                            <tr>

                                <td colspan="6">

                                    <div class="empty-state">

                                        <div class="empty-icon">

                                            <i class="bi bi-building"></i>

                                        </div>

                                        <div class="empty-title">

                                            Belum Ada Data Perusahaan

                                        </div>

                                        <div class="empty-text">

                                            Belum terdapat perusahaan yang tersimpan pada database.

                                        </div>

                                    </div>

                                </td>

                            </tr>

                        <% } %>

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>



<!-- ============================================================
     MODAL TAMBAH PERUSAHAAN
============================================================= -->

<% if (canManage) { %>

<div
    class="modal fade"
    id="addCompanyModal"
    tabindex="-1"
    aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-lg">

        <form
            class="modal-content border-0 shadow"
            method="post"
            action="/companies/add">


            <!-- =================================================
                 HEADER
            ================================================== -->

            <div class="modal-header">

                <div class="d-flex align-items-center gap-2">

                    <div class="modal-heading-icon">

                        <i class="bi bi-building-add"></i>

                    </div>

                    <div>

                        <h5 class="modal-title mb-0">

                            Tambah Perusahaan

                        </h5>

                        <div class="modal-subtitle">

                            Tambahkan perusahaan baru ke database.

                        </div>

                    </div>

                </div>


                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="modal"
                    aria-label="Close">
                </button>

            </div>


            <!-- =================================================
                 BODY
            ================================================== -->

            <div class="modal-body">

                <!-- =============================================
                     NAMA PERUSAHAAN
                ============================================== -->

                <div class="mb-3">

                    <label class="form-label">
                        Nama Perusahaan
                    </label>

                    <div class="input-group">

                        <span class="input-group-text bg-light">

                            <i class="bi bi-building text-success"></i>

                        </span>

                        <input
                            type="text"
                            name="name"
                            class="form-control"
                            placeholder="Masukkan nama perusahaan"
                            required>

                    </div>

                    <div class="form-help">

                        Nama perusahaan yang akan ditampilkan pada sistem.

                    </div>

                </div>


                <!-- =============================================
                     ALAMAT
                ============================================== -->

                <div class="mb-3">

                    <label class="form-label">
                        Alamat
                    </label>

                    <div class="input-group">

                        <span class="input-group-text bg-light align-items-start pt-2">

                            <i class="bi bi-geo-alt text-success"></i>

                        </span>

                        <textarea
                            name="address"
                            class="form-control"
                            rows="3"
                            placeholder="Masukkan alamat perusahaan..."></textarea>

                    </div>

                </div>


                <!-- =============================================
                     TELEPON + EMAIL
                ============================================== -->

                <div class="row g-3">

                    <!-- TELEPON -->

                    <div class="col-md-6">

                        <label class="form-label">
                            Telepon
                        </label>

                        <div class="input-group">

                            <span class="input-group-text bg-light">

                                <i class="bi bi-telephone text-success"></i>

                            </span>

                            <input
                                type="text"
                                name="phone"
                                class="form-control"
                                placeholder="08xxxxxxxxxx">

                        </div>

                    </div>


                    <!-- EMAIL -->

                    <div class="col-md-6">

                        <label class="form-label">
                            Email
                        </label>

                        <div class="input-group">

                            <span class="input-group-text bg-light">

                                <i class="bi bi-envelope text-success"></i>

                            </span>

                            <input
                                type="email"
                                name="email"
                                class="form-control"
                                placeholder="email@perusahaan.com">

                        </div>

                    </div>

                </div>


                <!-- =============================================
                     STATUS
                ============================================== -->

                <div class="mt-3">

                    <label class="form-label">
                        Status
                    </label>

                    <div class="input-group">

                        <span class="input-group-text bg-light">

                            <i class="bi bi-toggle2-on text-success"></i>

                        </span>

                        <select
                            name="status"
                            class="form-select">

                            <option value="active">
                                Active
                            </option>

                            <option value="inactive">
                                Inactive
                            </option>

                        </select>

                    </div>

                </div>

            </div>


            <!-- =================================================
                 FOOTER
            ================================================== -->

            <div class="modal-footer">

                <button
                    type="button"
                    class="btn btn-light border"
                    data-bs-dismiss="modal">

                    <i class="bi bi-x-lg me-1"></i>

                    Batal

                </button>


                <button
                    type="submit"
                    class="btn btn-success">

                    <i class="bi bi-check-lg me-1"></i>

                    Simpan

                </button>

            </div>

        </form>

    </div>

</div>


<!-- ============================================================
     MODAL EDIT PERUSAHAAN
============================================================= -->

<% rows.forEach(r => { %>

<div
    class="modal fade"
    id="editCompany<%= r.id %>"
    tabindex="-1"
    aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-lg">

        <form
            class="modal-content border-0 shadow"
            method="post"
            action="/companies/<%= r.id %>/update">


            <!-- =================================================
                 HEADER
            ================================================== -->

            <div class="modal-header">

                <div class="d-flex align-items-center gap-2">

                    <div class="modal-heading-icon">

                        <i class="bi bi-pencil-square"></i>

                    </div>

                    <div>

                        <h5 class="modal-title mb-0">

                            Edit Perusahaan

                        </h5>

                        <div class="modal-subtitle">

                            Perbarui informasi perusahaan.

                        </div>

                    </div>

                </div>


                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="modal"
                    aria-label="Close">
                </button>

            </div>


            <!-- =================================================
                 BODY
            ================================================== -->

            <div class="modal-body">

                <!-- =============================================
                     NAMA PERUSAHAAN
                ============================================== -->

                <div class="mb-3">

                    <label class="form-label">
                        Nama Perusahaan
                    </label>

                    <div class="input-group">

                        <span class="input-group-text bg-light">

                            <i class="bi bi-building text-success"></i>

                        </span>

                        <input
                            type="text"
                            name="name"
                            class="form-control"
                            value="<%= r.name || '' %>"
                            placeholder="Masukkan nama perusahaan"
                            required>

                    </div>

                </div>


                <!-- =============================================
                     ALAMAT
                ============================================== -->

                <div class="mb-3">

                    <label class="form-label">
                        Alamat
                    </label>

                    <div class="input-group">

                        <span class="input-group-text bg-light align-items-start pt-2">

                            <i class="bi bi-geo-alt text-success"></i>

                        </span>

                        <textarea
                            name="address"
                            class="form-control"
                            rows="3"
                            placeholder="Masukkan alamat perusahaan..."><%= r.address || "" %></textarea>

                    </div>

                </div>


                <!-- =============================================
                     TELEPON + EMAIL
                ============================================== -->

                <div class="row g-3">

                    <!-- TELEPON -->

                    <div class="col-md-6">

                        <label class="form-label">
                            Telepon
                        </label>

                        <div class="input-group">

                            <span class="input-group-text bg-light">

                                <i class="bi bi-telephone text-success"></i>

                            </span>

                            <input
                                type="text"
                                name="phone"
                                class="form-control"
                                value="<%= r.phone || '' %>"
                                placeholder="08xxxxxxxxxx">

                        </div>

                    </div>


                    <!-- EMAIL -->

                    <div class="col-md-6">

                        <label class="form-label">
                            Email
                        </label>

                        <div class="input-group">

                            <span class="input-group-text bg-light">

                                <i class="bi bi-envelope text-success"></i>

                            </span>

                            <input
                                type="email"
                                name="email"
                                class="form-control"
                                value="<%= r.email || '' %>"
                                placeholder="email@perusahaan.com">

                        </div>

                    </div>

                </div>


                <!-- =============================================
                     STATUS
                ============================================== -->

                <div class="mt-3">

                    <label class="form-label">
                        Status
                    </label>

                    <div class="input-group">

                        <span class="input-group-text bg-light">

                            <i class="bi bi-toggle2-on text-success"></i>

                        </span>

                        <select
                            name="status"
                            class="form-select">

                            <option
                                value="active"
                                <%= String(r.status || "").toLowerCase() === "active"
                                    || String(r.status || "").toLowerCase() === "aktif"
                                    ? "selected"
                                    : "" %>>

                                Active

                            </option>

                            <option
                                value="inactive"
                                <%= String(r.status || "").toLowerCase() === "inactive"
                                    || String(r.status || "").toLowerCase() === "nonaktif"
                                    ? "selected"
                                    : "" %>>

                                Inactive

                            </option>

                        </select>

                    </div>

                </div>

            </div>


            <!-- =================================================
                 FOOTER
            ================================================== -->

            <div class="modal-footer">

                <button
                    type="button"
                    class="btn btn-light border"
                    data-bs-dismiss="modal">

                    <i class="bi bi-x-lg me-1"></i>

                    Batal

                </button>


                <button
                    type="submit"
                    class="btn btn-success">

                    <i class="bi bi-check-lg me-1"></i>

                    Simpan Perubahan

                </button>

            </div>

        </form>

    </div>

</div>

<% }) %>

<% } %>