<div class="mb-3"><label class="form-label">Nama</label><input class="form-control" name="name" required value="<%=r?.name||''%>"></div><div class="row"><div class="col-md-6 mb-3"><label class="form-label">Tipe</label><select class="form-select" name="type"><option value="perorangan" <%=r?.type==='perorangan'?'selected':''%>>Perorangan</option><option value="perusahaan" <%=r?.type==='perusahaan'?'selected':''%>>Perusahaan</option></select></div><div class="col-md-6 mb-3"><label class="form-label">Perusahaan</label><input class="form-control" name="company" value="<%=r?.company||''%>"></div></div><div class="row"><div class="col-md-6 mb-3"><label class="form-label">Telepon</label><input class="form-control" name="phone" value="<%=r?.phone||''%>"></div><div class="col-md-6 mb-3"><label class="form-label">Email</label><input class="form-control" name="email" value="<%=r?.email||''%>"></div></div><div class="mb-3"><label class="form-label">Alamat</label><textarea class="form-control" name="address"><%=r?.address||''%></textarea></div><div class="mb-3"><label class="form-label">NPWP</label><input class="form-control" name="npwp" value="<%=r?.npwp||''%>"></div><div><label class="form-label">Status</label><select class="form-select" name="status"><option value="active" <%=r?.status==='active'?'selected':''%>>Aktif</option><option value="inactive" <%=r?.status==='inactive'?'selected':''%>>Nonaktif</option></select></div>