<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title><%= title %> - <%= appName %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        @page {
            size: A4 landscape;
            margin: 12mm 10mm 12mm 10mm;
        }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            font-size: 12px;
            color: #1f2937;
            background: #fff;
        }
        .header-box {
            border-bottom: 2px solid #047857;
            padding-bottom: 12px;
            margin-bottom: 20px;
        }
        .app-brand {
            font-size: 20px;
            font-weight: 800;
            color: #047857;
            letter-spacing: -0.5px;
        }
        .doc-title {
            font-size: 15px;
            font-weight: 700;
            color: #111827;
            margin-top: 2px;
        }
        .badge-status {
            display: inline-block;
            padding: 3px 8px;
            border-radius: 6px;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
        }
        .badge-paid { background-color: #dcfce7; color: #15803d; }
        .badge-pending { background-color: #fef9c3; color: #a16207; }
        .badge-cancelled { background-color: #fee2e2; color: #b91c1c; }

        .stat-card {
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            padding: 12px;
            text-align: center;
            background: #f9fafb;
            height: 100%;
        }
        .stat-card .val {
            font-size: 14px;
            font-weight: 700;
            margin-top: 4px;
        }
        .pdf-table-responsive {
            width: 100%;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
            border-radius: 12px;
            border: 1px solid #e5e7eb;
            margin-top: 15px;
            background: #fff;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin: 0;
            min-width: 800px;
        }
        th {
            background-color: #047857 !important;
            color: white !important;
            font-weight: 600;
            padding: 10px 12px;
            font-size: 11px;
            text-align: left;
            border: 1px solid #047857;
        }
        td {
            padding: 8px 12px;
            font-size: 11px;
            border: 1px solid #e5e7eb;
        }
        tr:nth-child(even) {
            background-color: #f9fafb;
        }
        tfoot td {
            background-color: #f3f4f6 !important;
            font-weight: 700;
            border-top: 2px solid #047857;
        }
        .no-print {
            background: #ffffff;
            border-bottom: 1px solid #e5e7eb;
            padding: 12px 16px;
            position: sticky;
            top: 0;
            z-index: 1000;
            box-shadow: 0 2px 8px rgba(0,0,0,0.04);
        }
        @media screen and (max-width: 767.98px) {
            body {
                background: #f8fafc;
                padding-bottom: 30px;
            }
            .no-print {
                padding: 10px 12px;
            }
            .header-box {
                flex-direction: column !important;
                align-items: flex-start !important;
                gap: 10px;
            }
            .header-box .text-end {
                text-align: left !important;
            }
            .doc-container {
                padding: 12px !important;
            }
            .doc-paper {
                background: #fff;
                border-radius: 18px;
                padding: 16px;
                border: 1px solid #edf0f4;
                box-shadow: 0 4px 20px rgba(0,0,0,0.04);
            }
        }
        @media print {
            .no-print { display: none !important; }
            .pdf-table-responsive {
                overflow: visible !important;
                border: none !important;
                border-radius: 0 !important;
                margin: 0 !important;
            }
            table {
                min-width: 100% !important;
            }
            .doc-paper {
                border: none !important;
                box-shadow: none !important;
                padding: 0 !important;
            }
        }
    </style>
</head>
<body>

<div class="no-print d-flex flex-wrap justify-content-between align-items-center gap-2">
    <div class="d-flex align-items-center gap-2">
        <a href="/sales" onclick="handlePdfBack(event, '/sales')" class="btn btn-sm btn-light border rounded-pill px-3 text-dark text-decoration-none d-inline-flex align-items-center shadow-sm">
            <i class="bi bi-arrow-left me-1"></i> Kembali
        </a>
        <span class="fw-bold text-dark d-none d-sm-inline">Pratinjau PDF Penjualan</span>
    </div>
    <div class="d-flex gap-2 w-100 w-sm-auto justify-content-end">
        <button onclick="window.print()" class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm">
            <i class="bi bi-printer me-1"></i> Cetak / Unduh PDF
        </button>
        <% if (typeof excelUrl !== 'undefined' && excelUrl) { %>
        <a href="<%= excelUrl %>" class="btn btn-sm btn-success rounded-pill px-3">
            <i class="bi bi-file-earmark-excel me-1"></i> Excel
        </a>
        <% } %>
    </div>
</div>

<div class="container-fluid doc-container px-3 px-md-4 py-3">
    <div class="doc-paper">
        <!-- Notifikasi Mobile View -->
        <div class="d-md-none alert alert-light border shadow-sm py-2 px-3 small rounded-3 mb-3 d-flex align-items-center gap-2 text-muted">
            <i class="bi bi-phone-flip text-success fs-6"></i>
            <span><strong>Mode Ponsel:</strong> Geser tabel ke samping untuk melihat seluruh kolom data, atau klik tombol cetak untuk cetak A4.</span>
        </div>

        <div class="header-box d-flex justify-content-between align-items-end">
            <div>
                <div class="app-brand"><i class="bi bi-recycle text-success"></i> <%= appName %></div>
                <div class="doc-title"><%= title %></div>
                <div class="text-muted small">Periode: <strong><%= periodText %></strong></div>
            </div>
            <div class="text-end small">
                <div>Dicetak oleh: <strong><%= printedBy %></strong></div>
                <div>Waktu Cetak: <strong><%= printDate %></strong></div>
            </div>
        </div>

        <!-- Ringkasan Statistik (2x2 di Mobile) -->
        <div class="row g-2 mb-3">
            <div class="col-6 col-md-3">
                <div class="stat-card">
                    <div class="text-muted small" style="font-size: 11px;">Total Transaksi</div>
                    <div class="val text-dark"><%= (rows && rows.length) ? rows.length : 0 %> Transaksi</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-card">
                    <div class="text-muted small" style="font-size: 11px;">Total Bobot Sampah</div>
                    <div class="val text-primary"><%= typeof formatWeight === 'function' ? formatWeight(summary.totalWeight || 0) : ((summary.totalWeight || 0).toLocaleString('id-ID') + ' kg') %></div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-card">
                    <div class="text-muted small" style="font-size: 11px;">Total Nilai Penjualan</div>
                    <div class="val text-success"><%= typeof formatRupiah === 'function' ? formatRupiah(summary.totalAmount || 0) : ('Rp ' + (summary.totalAmount || 0).toLocaleString('id-ID')) %></div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-card">
                    <div class="text-muted small" style="font-size: 11px;">Transaksi Lunas</div>
                    <div class="val text-info"><%= summary.paidCount || 0 %> Lunas</div>
                </div>
            </div>
        </div>

        <!-- Tabel Penjualan -->
        <div class="pdf-table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th style="width: 40px;" class="text-center">No</th>
                        <th style="width: 140px;">No. Invoice</th>
                        <th style="width: 130px;">Waktu Transaksi</th>
                        <th>Pengepul / Pembeli</th>
                        <th>Nasabah Terkait</th>
                        <th style="width: 100px;" class="text-end">Berat</th>
                        <th style="width: 130px;" class="text-end">Total Nilai</th>
                        <th style="width: 110px;" class="text-center">Status Bayar</th>
                        <th style="width: 120px;">Metode / Bank</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (rows && rows.length) { %>
                        <% rows.forEach((r, idx) => { 
                            const isPaid = (r.payment_status === 'paid' || r.status === 'paid');
                            const isCancelled = (r.status === 'cancelled');
                        %>
                            <tr>
                                <td class="text-center"><%= idx + 1 %></td>
                                <td><strong><%= r.invoice_number || ('#TRX-' + r.id) %></strong></td>
                                <td><%= formatDateTime(r.created_at) %></td>
                                <td><%= r.buyer_name || '-' %></td>
                                <td>
                                    <% if (r.nasabah_name) { %>
                                        <%= r.nasabah_name %>
                                        <% if (r.collection_code) { %>
                                            <span class="text-muted small d-block">(<%= r.collection_code %>)</span>
                                        <% } %>
                                    <% } else { %>
                                        <span class="text-muted">Langsung / Gudang</span>
                                    <% } %>
                                </td>
                                <td class="text-end"><%= typeof formatWeight === 'function' ? formatWeight(r.total_weight || 0) : ((r.total_weight || 0) + ' kg') %></td>
                                <td class="text-end fw-bold text-success"><%= typeof formatRupiah === 'function' ? formatRupiah(r.total_amount || 0) : ('Rp ' + (r.total_amount || 0).toLocaleString('id-ID')) %></td>
                                <td class="text-center">
                                    <% if (isPaid) { %>
                                        <span class="badge-status badge-paid">Lunas</span>
                                    <% } else if (isCancelled) { %>
                                        <span class="badge-status badge-cancelled">Dibatalkan</span>
                                    <% } else { %>
                                        <span class="badge-status badge-pending">Menunggu</span>
                                    <% } %>
                                </td>
                                <td>
                                    <% if (r.payment_method) { %>
                                        <span class="badge bg-light text-dark border"><%= (r.payment_method || '').toUpperCase() %></span>
                                        <% if (r.bank_name) { %>
                                            <span class="small text-muted ms-1"><%= r.bank_name %></span>
                                        <% } %>
                                    <% } else { %>
                                        <span class="text-muted">-</span>
                                    <% } %>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">
                                Tidak ada riwayat transaksi penjualan pada periode ini.
                            </td>
                        </tr>
                    <% } %>
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="5" class="text-end fw-bold">TOTAL KESELURUHAN</td>
                        <td class="text-end fw-bold"><%= typeof formatWeight === 'function' ? formatWeight(summary.totalWeight || 0) : ((summary.totalWeight || 0).toLocaleString('id-ID') + ' kg') %></td>
                        <td class="text-end fw-bold text-success"><%= typeof formatRupiah === 'function' ? formatRupiah(summary.totalAmount || 0) : ('Rp ' + (summary.totalAmount || 0).toLocaleString('id-ID')) %></td>
                        <td colspan="2"></td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <div class="row mt-4 pt-3">
            <div class="col-7 col-md-8 small text-muted">
                <p class="mb-1">Catatan Dokumen:</p>
                <ul class="ps-3 mb-0">
                    <li>Laporan digenerate secara otomatis oleh sistem <%= appName %>.</li>
                    <li>Seluruh data transaksi tervalidasi dan sah sebagai dokumen rekap operasional.</li>
                </ul>
            </div>
            <div class="col-5 col-md-4 text-center">
                <div class="small text-muted mb-4">Penanggung Jawab Keuangan,</div>
                <div class="fw-bold text-dark text-decoration-underline"><%= printedBy %></div>
                <div class="small text-muted">Petugas Administrasi</div>
            </div>
        </div>
    </div>
</div>

<script>
function handlePdfBack(e, fallbackUrl) {
    if (e) e.preventDefault();
    if (window.opener) {
        window.close();
        return;
    }
    if (window.history.length > 1 && document.referrer && document.referrer.includes(window.location.host)) {
        window.history.back();
        return;
    }
    window.location.href = fallbackUrl || '/sales';
}
</script>
</body>
</html>
