<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title><%= title %> - <%= appName %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        @page {
            size: A4 portrait;
            margin: 15mm 12mm 15mm 12mm;
        }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            font-size: 12px;
            color: #1f2937;
            background: #fff;
        }
        .header-box {
            border-bottom: 2px solid #047857;
            padding-bottom: 12px;
            margin-bottom: 20px;
        }
        .app-brand {
            font-size: 20px;
            font-weight: 800;
            color: #047857;
            letter-spacing: -0.5px;
        }
        .doc-title {
            font-size: 15px;
            font-weight: 700;
            color: #111827;
            margin-top: 2px;
        }
        .badge-kredit {
            background-color: #dcfce7;
            color: #15803d;
            padding: 3px 8px;
            border-radius: 6px;
            font-weight: 600;
        }
        .badge-debit {
            background-color: #fee2e2;
            color: #b91c1c;
            padding: 3px 8px;
            border-radius: 6px;
            font-weight: 600;
        }
        .stat-card {
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            padding: 12px;
            text-align: center;
            background: #f9fafb;
            height: 100%;
        }
        .stat-card .val {
            font-size: 14px;
            font-weight: 700;
            margin-top: 4px;
        }
        .pdf-table-responsive {
            width: 100%;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
            border-radius: 12px;
            border: 1px solid #e5e7eb;
            margin-top: 15px;
            background: #fff;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin: 0;
            min-width: 720px;
        }
        th {
            background-color: #047857 !important;
            color: white !important;
            font-weight: 600;
            padding: 10px 12px;
            font-size: 11px;
            text-align: left;
            border: 1px solid #047857;
        }
        td {
            padding: 8px 12px;
            font-size: 11px;
            border: 1px solid #e5e7eb;
        }
        tr:nth-child(even) {
            background-color: #f9fafb;
        }
        .no-print {
            background: #ffffff;
            border-bottom: 1px solid #e5e7eb;
            padding: 12px 16px;
            position: sticky;
            top: 0;
            z-index: 1000;
            box-shadow: 0 2px 8px rgba(0,0,0,0.04);
        }
        @media screen and (max-width: 767.98px) {
            body {
                background: #f8fafc;
                padding-bottom: 30px;
            }
            .no-print {
                padding: 10px 12px;
            }
            .header-box {
                flex-direction: column !important;
                align-items: flex-start !important;
                gap: 10px;
            }
            .header-box .text-end {
                text-align: left !important;
            }
            .doc-container {
                padding: 12px !important;
            }
            .doc-paper {
                background: #fff;
                border-radius: 18px;
                padding: 16px;
                border: 1px solid #edf0f4;
                box-shadow: 0 4px 20px rgba(0,0,0,0.04);
            }
        }
        @media print {
            .no-print { display: none !important; }
            .pdf-table-responsive {
                overflow: visible !important;
                border: none !important;
                border-radius: 0 !important;
                margin: 0 !important;
            }
            table {
                min-width: 100% !important;
            }
            .doc-paper {
                border: none !important;
                box-shadow: none !important;
                padding: 0 !important;
            }
        }
    </style>
</head>
<body>

<div class="no-print d-flex flex-wrap justify-content-between align-items-center gap-2">
    <div class="d-flex align-items-center gap-2">
        <a href="/wallet" onclick="handlePdfBack(event, '/wallet')" class="btn btn-sm btn-light border rounded-pill px-3 text-dark text-decoration-none d-inline-flex align-items-center shadow-sm">
            <i class="bi bi-arrow-left me-1"></i> Kembali
        </a>
        <span class="fw-bold text-dark d-none d-sm-inline">Pratinjau PDF Mutasi Dompet</span>
    </div>
    <div class="d-flex gap-2 w-100 w-sm-auto justify-content-end">
        <button onclick="window.print()" class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm">
            <i class="bi bi-printer me-1"></i> Cetak / Unduh PDF
        </button>
        <% if (typeof excelUrl !== 'undefined' && excelUrl) { %>
        <a href="<%= excelUrl %>" class="btn btn-sm btn-success rounded-pill px-3">
            <i class="bi bi-file-earmark-excel me-1"></i> Excel
        </a>
        <% } %>
    </div>
</div>

<div class="container-fluid doc-container px-3 px-md-4 py-3">
    <div class="doc-paper">
        <!-- Notifikasi Mobile View -->
        <div class="d-md-none alert alert-light border shadow-sm py-2 px-3 small rounded-3 mb-3 d-flex align-items-center gap-2 text-muted">
            <i class="bi bi-phone-flip text-success fs-6"></i>
            <span><strong>Mode Ponsel:</strong> Geser tabel ke samping untuk melihat seluruh data mutasi, atau klik tombol cetak untuk cetak A4.</span>
        </div>

        <div class="header-box d-flex justify-content-between align-items-end">
            <div>
                <div class="app-brand"><i class="bi bi-recycle text-success"></i> <%= appName %></div>
                <div class="doc-title"><%= title %></div>
                <div class="text-muted small">Periode: <strong><%= periodText %></strong></div>
            </div>
            <div class="text-end small">
                <div>Dicetak oleh: <strong><%= printedBy %></strong></div>
                <div>Waktu Cetak: <strong><%= printDate %></strong></div>
            </div>
        </div>

        <!-- Ringkasan Finansial -->
        <div class="row g-2 mb-3">
            <div class="col-12 col-md-4">
                <div class="stat-card">
                    <div class="text-muted small">Total Pemasukan (Kredit)</div>
                    <div class="val text-success">+ <%= formatRupiah(summary.totalCredit || 0) %></div>
                </div>
            </div>
            <div class="col-6 col-md-4">
                <div class="stat-card">
                    <div class="text-muted small">Total Penarikan (Debit)</div>
                    <div class="val text-danger">- <%= formatRupiah(summary.totalDebit || 0) %></div>
                </div>
            </div>
            <div class="col-6 col-md-4">
                <div class="stat-card">
                    <div class="text-muted small">Saldo Bersih Periode</div>
                    <div class="val text-primary"><%= formatRupiah((summary.totalCredit || 0) - (summary.totalDebit || 0)) %></div>
                </div>
            </div>
        </div>

        <!-- Tabel Mutasi -->
        <div class="pdf-table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th style="width: 40px;" class="text-center">No</th>
                        <th style="width: 130px;">Waktu Transaksi</th>
                        <th>Pengguna / Nasabah</th>
                        <th style="width: 110px;" class="text-center">Jenis Mutasi</th>
                        <th style="width: 130px;" class="text-end">Nominal</th>
                        <th>Keterangan</th>
                        <th style="width: 90px;" class="text-center">Status</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (rows && rows.length) { %>
                        <% rows.forEach((r, idx) => { %>
                            <tr>
                                <td class="text-center"><%= idx + 1 %></td>
                                <td><%= formatDateTime(r.created_at) %></td>
                                <td><strong><%= r.full_name || r.username || '-' %></strong></td>
                                <td class="text-center">
                                    <% if (r.type === 'credit') { %>
                                        <span class="badge-kredit">+ Kredit</span>
                                    <% } else { %>
                                        <span class="badge-debit">- Debit</span>
                                    <% } %>
                                </td>
                                <td class="text-end fw-bold <%= r.type === 'credit' ? 'text-success' : 'text-danger' %>">
                                    <%= r.type === 'credit' ? '+ ' : '- ' %><%= formatRupiah(r.amount) %>
                                </td>
                                <td><%= r.description || '-' %></td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border small"><%= (r.status || 'success').toUpperCase() %></span>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                Tidak ada riwayat mutasi transaksi pada periode ini.
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>

        <div class="row mt-4 pt-3">
            <div class="col-7 col-md-8 small text-muted">
                <p class="mb-1">Catatan Dokumen:</p>
                <ul class="ps-3 mb-0">
                    <li>Laporan diterbitkan secara otomatis oleh sistem buku besar digital <%= appName %>.</li>
                    <li>Seluruh mutasi tercatat resmi dan dapat dipertanggungjawabkan.</li>
                </ul>
            </div>
            <div class="col-5 col-md-4 text-center">
                <div class="small text-muted mb-4">Penanggung Jawab Keuangan,</div>
                <div class="fw-bold text-dark text-decoration-underline"><%= printedBy %></div>
                <div class="small text-muted">Petugas Verifikasi</div>
            </div>
        </div>
    </div>
</div>

<script>
function handlePdfBack(e, fallbackUrl) {
    if (e) e.preventDefault();
    if (window.opener) {
        window.close();
        return;
    }
    if (window.history.length > 1 && document.referrer && document.referrer.includes(window.location.host)) {
        window.history.back();
        return;
    }
    window.location.href = fallbackUrl || '/wallet';
}
</script>
</body>
</html>
