<!-- ========================================================
     MODAL EXPORT DATA MUTASI WALLET
========================================================= -->
<div class="modal fade" id="exportWalletModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-bottom">
                <div>
                    <h5 class="modal-title fw-bold text-dark">
                        <i class="bi bi-file-earmark-arrow-down text-success me-2"></i>Export Mutasi Dompet
                    </h5>
                    <div class="small text-muted">Pilih rentang tanggal untuk preview cetak PDF atau download file Excel.</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="walletExportForm" method="get" action="/wallet/export/preview-pdf" target="_blank">
                <div class="modal-body">
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold small">Dari Tanggal</label>
                            <input type="date" class="form-control" name="start_date">
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold small">Sampai Tanggal</label>
                            <input type="date" class="form-control" name="end_date">
                        </div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label fw-semibold small">Filter Jenis Mutasi</label>
                        <select name="type" class="form-select">
                            <option value="">Semua Mutasi (Kredit & Debit)</option>
                            <option value="credit">Hanya Pemasukan (Kredit)</option>
                            <option value="debit">Hanya Penarikan (Debit)</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-top bg-light d-flex flex-column-reverse flex-sm-row justify-content-between gap-2 p-3">
                    <button type="button" class="btn btn-secondary w-100 w-sm-auto rounded-3" data-bs-dismiss="modal">Batal</button>
                    <div class="d-flex flex-column flex-sm-row gap-2 w-100 w-sm-auto justify-content-end">
                        <button type="button" id="btnWalletPdf" class="btn btn-outline-primary fw-semibold w-100 w-sm-auto rounded-3 text-nowrap">
                            <i class="bi bi-file-earmark-pdf me-1"></i> Pratinjau PDF
                        </button>
                        <button type="button" id="btnWalletExcel" class="btn btn-success fw-semibold w-100 w-sm-auto rounded-3 text-nowrap">
                            <i class="bi bi-file-earmark-excel me-1"></i> Unduh Excel
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", function () {
    function formatRupiah(val) {
        return "Rp " + Number(val || 0).toLocaleString("id-ID");
    }

    // Modal Approve Withdrawal
    document.querySelectorAll(".btn-open-approve-wdr").forEach(function (btn) {
        btn.addEventListener("click", function () {
            const id = btn.getAttribute("data-id");
            const nasabah = btn.getAttribute("data-nasabah");
            const bank = btn.getAttribute("data-bank");
            const acc = btn.getAttribute("data-acc");
            const name = btn.getAttribute("data-name");
            const amount = btn.getAttribute("data-amount");

            const form = document.getElementById("formApproveWdr");
            if (form) form.action = "/wallet/withdrawals/" + id + "/approve";

            document.getElementById("wdrModalNasabah").textContent = nasabah || "-";
            document.getElementById("wdrModalBank").textContent = (bank || "").toUpperCase();
            document.getElementById("wdrModalAcc").textContent = acc || "-";
            document.getElementById("wdrModalName").textContent = name || "-";
            document.getElementById("wdrModalAmount").textContent = formatRupiah(amount);
        });
    });

    // Modal Reject Withdrawal
    document.querySelectorAll(".btn-open-reject-wdr").forEach(function (btn) {
        btn.addEventListener("click", function () {
            const id = btn.getAttribute("data-id");
            const nasabah = btn.getAttribute("data-nasabah");
            const amount = btn.getAttribute("data-amount");

            const form = document.getElementById("formRejectWdr");
            if (form) form.action = "/wallet/withdrawals/" + id + "/reject";

            document.getElementById("rejectModalNasabah").textContent = nasabah || "-";
            document.getElementById("rejectModalAmount").textContent = formatRupiah(amount);
        });
    });

    // Modal View Withdrawal Proof
    document.querySelectorAll(".btn-view-wdr-proof").forEach(function (btn) {
        btn.addEventListener("click", function () {
            const proof = btn.getAttribute("data-proof");
            const nasabah = btn.getAttribute("data-nasabah");
            const bank = btn.getAttribute("data-bank");
            const acc = btn.getAttribute("data-acc");
            const amount = btn.getAttribute("data-amount");
            const date = btn.getAttribute("data-date");
            const note = btn.getAttribute("data-note");

            document.getElementById("viewWdrNasabah").textContent = nasabah || "-";
            document.getElementById("viewWdrBank").textContent = (bank || "").toUpperCase();
            document.getElementById("viewWdrAcc").textContent = acc || "-";
            document.getElementById("viewWdrAmount").textContent = formatRupiah(amount);
            document.getElementById("viewWdrDate").textContent = date || "-";
            document.getElementById("viewWdrNote").textContent = note || "-";

            const img = document.getElementById("viewWdrImg");
            const loading = document.getElementById("viewWdrLoading");
            const empty = document.getElementById("viewWdrEmpty");
            const link = document.getElementById("viewWdrLink");

            loading.style.display = "block";
            img.style.display = "none";
            empty.style.display = "none";

            if (proof) {
                const fullPath = proof.startsWith("http") || proof.startsWith("/") ? proof : "/" + proof;
                link.href = fullPath;
                link.style.display = "inline-flex";

                if (fullPath.match(/\.(jpg|jpeg|png|webp|gif)$/i)) {
                    img.src = fullPath;
                    img.onload = function () {
                        loading.style.display = "none";
                        img.style.display = "block";
                    };
                    img.onerror = function () {
                        loading.style.display = "none";
                        empty.style.display = "block";
                    };
                } else {
                    loading.style.display = "none";
                    empty.style.display = "block";
                }
            } else {
                loading.style.display = "none";
                empty.style.display = "block";
                link.style.display = "none";
            }
        });
    });

    // Export Wallet Form Submit Buttons
    const exportForm = document.getElementById("walletExportForm");
    const btnPdf = document.getElementById("btnWalletPdf");
    const btnExcel = document.getElementById("btnWalletExcel");

    if (btnPdf && exportForm) {
        btnPdf.addEventListener("click", function () {
            exportForm.action = "/wallet/export/preview-pdf";
            exportForm.target = "_blank";
            exportForm.submit();
        });
    }

    if (btnExcel && exportForm) {
        btnExcel.addEventListener("click", function () {
            exportForm.action = "/wallet/export/excel";
            exportForm.target = "_self";
            exportForm.submit();
        });
    }
});
</script>