<!doctype html>
<html lang="id">

<head>
    <meta charset="utf-8">

    <meta name="viewport"
        content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">

    <meta name="theme-color" content="#16a34a">

    <meta name="description"
        content="Aplikasi Sampah - Sistem Pengelolaan Sampah Terintegrasi">

    <title>PILAHKITA | LOGIN</title>

    <!-- =========================================================
         BOOTSTRAP
    ========================================================== -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <!-- =========================================================
         BOOTSTRAP ICONS
    ========================================================== -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
        rel="stylesheet">

    <!-- =========================================================
         CUSTOM CSS
    ========================================================== -->
    <link rel="stylesheet" href="/css/style.css">
    <link rel="icon" type="image/png" href="/images/pilahkita.png">

    <style>

        /* =====================================================
           RESET
        ====================================================== */

        * {
            box-sizing: border-box;
        }

        html,
        body {
            width: 100%;
            min-height: 100%;
            margin: 0;
            padding: 0;
        }

        body.login-page {
            min-height: 100vh;
            min-height: 100dvh;

            display: flex;
            align-items: center;
            justify-content: center;

            padding: 24px;

            background:
                radial-gradient(
                    circle at 10% 10%,
                    rgba(34, 197, 94, 0.12),
                    transparent 35%
                ),
                radial-gradient(
                    circle at 90% 90%,
                    rgba(16, 185, 129, 0.08),
                    transparent 35%
                ),
                #f5f7fb;

            font-family:
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                Roboto,
                Helvetica,
                Arial,
                sans-serif;

            color: #172033;
        }


        /* =====================================================
           LOGIN CARD
        ====================================================== */

        .login-card {
            width: 100%;
            max-width: 420px;

            background: rgba(255, 255, 255, 0.96);

            border: 1px solid rgba(226, 232, 240, 0.9);

            border-radius: 24px;

            padding: 34px 32px 28px;

            box-shadow:
                0 25px 60px rgba(15, 23, 42, 0.10),
                0 5px 20px rgba(15, 23, 42, 0.04);

            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
        }


        /* =====================================================
           LOGO
        ====================================================== */

        .login-logo {
            width: 58px;
            height: 58px;

            margin: 0 auto 16px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 17px;

            background: linear-gradient(
                135deg,
                #16a34a,
                #22c55e
            );

            color: #ffffff;

            font-size: 28px;

            box-shadow:
                0 10px 25px rgba(22, 163, 74, 0.25);
        }


        /* =====================================================
           TITLE
        ====================================================== */

        .login-title {
            text-align: center;

            font-size: 24px;
            font-weight: 800;

            line-height: 1.2;

            color: #172033;

            margin-bottom: 6px;
        }

        .login-sub {
            text-align: center;

            font-size: 12px;

            color: #94a3b8;

            margin-bottom: 25px;
        }


        /* =====================================================
           ALERT
        ====================================================== */

        .login-alert {
            border: 0;

            border-radius: 12px;

            padding: 11px 13px;

            font-size: 12px;

            margin-bottom: 20px;
        }


        /* =====================================================
           LABEL
        ====================================================== */

        .login-card .form-label {
            display: block;

            margin-bottom: 7px;

            font-size: 12px;
            font-weight: 700;

            color: #475569;
        }


        /* =====================================================
           INPUT GROUP
        ====================================================== */

        .login-input-group {
            display: flex;

            width: 100%;

            margin-bottom: 18px;
        }


        /* =====================================================
           ICON
        ====================================================== */

        .login-input-icon {
            width: 48px;
            min-width: 48px;

            display: flex;
            align-items: center;
            justify-content: center;

            background: #ffffff;

            border: 1px solid #dbe3ed;

            border-right: 0;

            color: #64748b;

            font-size: 15px;

            border-radius: 12px 0 0 12px;
        }


        /* =====================================================
           INPUT
        ====================================================== */

        .login-input {
            height: 46px;

            border: 1px solid #dbe3ed;

            background: #ffffff;

            color: #172033;

            font-size: 13px;

            box-shadow: none !important;
        }

        .login-input::placeholder {
            color: #a8b3c2;
        }

        .login-input:focus {
            border-color: #86efac;

            background: #ffffff;

            box-shadow:
                0 0 0 3px rgba(34, 197, 94, 0.10) !important;
        }


        /* =====================================================
           USERNAME INPUT
        ====================================================== */

        .login-input-group .login-input {
            border-radius: 0 12px 12px 0;
        }


        /* =====================================================
           PASSWORD
        ====================================================== */

        .password-input {
            border-radius: 0 !important;
        }

        .password-toggle {
            width: 48px;
            min-width: 48px;

            height: 46px;

            display: flex;
            align-items: center;
            justify-content: center;

            border: 1px solid #dbe3ed !important;

            border-left: 0 !important;

            background: #ffffff !important;

            color: #64748b !important;

            border-radius: 0 12px 12px 0 !important;

            box-shadow: none !important;
        }

        .password-toggle:hover {
            background: #f8fafc !important;
        }

        .password-toggle:focus {
            box-shadow: none !important;
        }


        /* =====================================================
           LOGIN BUTTON
        ====================================================== */

        .btn-login {
            width: 100%;

            height: 47px;

            border: 0;

            border-radius: 12px;

            background: linear-gradient(
                135deg,
                #16a34a,
                #16a34a
            );

            color: #ffffff;

            font-size: 13px;

            font-weight: 700;

            box-shadow:
                0 8px 18px rgba(22, 163, 74, 0.18);

            transition:
                transform .15s ease,
                box-shadow .15s ease,
                background .15s ease;
        }

        .btn-login:hover {
            background: #15803d;

            color: #ffffff;

            transform: translateY(-1px);

            box-shadow:
                0 10px 22px rgba(22, 163, 74, 0.24);
        }

        .btn-login:active {
            transform: translateY(0);
        }


        /* =====================================================
           REGISTER
        ====================================================== */

        .register-area {
            text-align: center;

            margin-top: 22px;

            font-size: 12px;
        }

        .register-text {
            color: #94a3b8;
        }

        .register-link {
            color: #16a34a;

            font-weight: 700;

            text-decoration: none;
        }

        .register-link:hover {
            color: #15803d;

            text-decoration: underline;
        }


        /* =====================================================
           FOOTER
        ====================================================== */

        .login-footer {
            text-align: center;

            margin-top: 22px;

            padding-top: 18px;

            border-top: 1px solid #e9eef4;

            color: #94a3b8;

            font-size: 11px;
        }


        /* =====================================================
           MOBILE
        ====================================================== */

        @media (max-width: 576px) {

            body.login-page {
                padding: 16px;
            }

            .login-card {
                max-width: 100%;

                padding: 28px 22px 24px;

                border-radius: 22px;
            }

            .login-logo {
                width: 54px;
                height: 54px;

                font-size: 25px;
            }

            .login-title {
                font-size: 22px;
            }

            .login-sub {
                font-size: 11px;

                margin-bottom: 22px;
            }

        }


        /* =====================================================
           VERY SMALL PHONE
        ====================================================== */

        @media (max-width: 360px) {

            body.login-page {
                padding: 10px;
            }

            .login-card {
                padding: 24px 18px 20px;
            }

            .login-title {
                font-size: 20px;
            }

        }

    </style>
</head>


<body class="login-page">

    <!-- =========================================================
         LOGIN CARD
    ========================================================== -->

    <main class="login-card">

        <!-- =====================================================
             LOGO
        ====================================================== -->

        <div class="login-logo">
            <i class="bi bi-recycle"></i>
        </div>


        <!-- =====================================================
             TITLE
        ====================================================== -->

        <div class="login-title">
            PilahKita
        </div>

        <div class="login-sub">
            Sistem Pengelolaan Sampah Terintegrasi
        </div>


        <!-- =====================================================
             ERROR MESSAGE
        ====================================================== -->

        <% if (typeof error_msg !== "undefined" && error_msg) { %>

            <div
                class="alert alert-danger login-alert d-flex align-items-center gap-2"
                role="alert">

                <i class="bi bi-exclamation-circle-fill"></i>

                <span>
                    <%= error_msg %>
                </span>

            </div>

        <% } %>


        <!-- =====================================================
             TIMEOUT / INFO MESSAGE
        ====================================================== -->

        <% if (typeof info_msg !== "undefined" && info_msg) { %>

            <div
                class="alert alert-warning login-alert d-flex align-items-start gap-2"
                role="alert"
                style="background: #fffbeb; border: 1px solid #fde68a; color: #b45309; border-radius: 14px; padding: 12px 14px;">

                <i class="bi bi-clock-history fs-5 flex-shrink-0 mt-1 text-warning"></i>

                <div>
                    <strong class="d-block" style="font-size: 13px; font-weight: 700; color: #92400e;">Sesi Berakhir Otomatis</strong>
                    <span style="font-size: 11.5px; line-height: 1.4; color: #b45309;">
                        <%= info_msg %>
                    </span>
                </div>

            </div>

        <% } %>


        <!-- =====================================================
             SUCCESS MESSAGE
        ====================================================== -->

        <% if (typeof success_msg !== "undefined" && success_msg) { %>

            <div
                class="alert alert-success login-alert d-flex align-items-center gap-2"
                role="alert">

                <i class="bi bi-check-circle-fill"></i>

                <span>
                    <%= success_msg %>
                </span>

            </div>

        <% } %>


        <!-- =====================================================
             LOGIN FORM
             
             PENTING:
             name="username"
             name="password"
             
             Backend membaca req.body.username
             dan req.body.password
        ====================================================== -->

        <form
            method="POST"
            action="/login"
            autocomplete="on"
            id="loginForm">


            <!-- =================================================
                 USERNAME / EMAIL
            ================================================== -->

            <div class="mb-3">

                <label
                    for="username"
                    class="form-label">

                    Username atau Email

                </label>


                <div class="login-input-group">

                    <span class="login-input-icon">

                        <i class="bi bi-person"></i>

                    </span>


                    <input
                        type="text"
                        class="form-control login-input"
                        id="username"
                        name="username"
                        placeholder="Masukkan username atau email"
                        autocomplete="username"
                        autocapitalize="none"
                        spellcheck="false"
                        required>

                </div>

            </div>


            <!-- =================================================
                 PASSWORD
            ================================================== -->

            <div class="mb-4">

                <label
                    for="password"
                    class="form-label">

                    Password

                </label>


                <div class="login-input-group mb-0">

                    <span class="login-input-icon">

                        <i class="bi bi-lock"></i>

                    </span>


                    <input
                        type="password"
                        class="form-control login-input password-input"
                        id="password"
                        name="password"
                        placeholder="Masukkan password"
                        autocomplete="current-password"
                        required>


                    <button
                        type="button"
                        class="password-toggle"
                        id="showPass"
                        aria-label="Tampilkan password">

                        <i
                            class="bi bi-eye"
                            id="showPassIcon">
                        </i>

                    </button>

                </div>

            </div>


            <!-- =================================================
                 LOGIN BUTTON
            ================================================== -->

            <button
                type="submit"
                class="btn btn-login"
                id="loginButton">

                <i class="bi bi-box-arrow-in-right me-2"></i>

                <span id="loginButtonText">
                    Masuk
                </span>

            </button>

        </form>


        <!-- =====================================================
             REGISTER
        ====================================================== -->

        <div class="register-area">

            <span class="register-text">
                Belum punya akun?
            </span>

            <a
                href="/register"
                class="register-link">

                Daftar sebagai nasabah

            </a>

        </div>


        <!-- =====================================================
             FOOTER
        ====================================================== -->

        <div class="login-footer">

            <i class="bi bi-leaf me-1"></i>

            Kelola · Pilah · Kumpulkan · Daur Ulang

        </div>

    </main>


    <!-- =========================================================
         JAVASCRIPT
    ========================================================== -->

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            /* =================================================
               PASSWORD TOGGLE
            ================================================== */

            const showPass =
                document.getElementById("showPass");

            const password =
                document.getElementById("password");

            const showPassIcon =
                document.getElementById("showPassIcon");


            if (showPass && password && showPassIcon) {

                showPass.addEventListener("click", function () {

                    const isPassword =
                        password.type === "password";


                    password.type =
                        isPassword ? "text" : "password";


                    showPassIcon.className =
                        isPassword
                            ? "bi bi-eye-slash"
                            : "bi bi-eye";


                    showPass.setAttribute(
                        "aria-label",
                        isPassword
                            ? "Sembunyikan password"
                            : "Tampilkan password"
                    );

                });

            }


            /* =================================================
               LOGIN FORM
               
               Jangan disable input.
               Kita hanya mengubah tombol saat submit.
            ================================================== */

            const loginForm =
                document.getElementById("loginForm");

            const loginButton =
                document.getElementById("loginButton");

            const loginButtonText =
                document.getElementById("loginButtonText");


            if (loginForm) {

                loginForm.addEventListener("submit", function (event) {

                    /*
                     * Pastikan browser benar-benar memiliki
                     * value username dan password.
                     */

                    const username =
                        document
                            .getElementById("username")
                            ?.value
                            ?.trim();

                    const passwordValue =
                        document
                            .getElementById("password")
                            ?.value;


                    if (!username || !passwordValue) {

                        event.preventDefault();

                        return;

                    }


                    /*
                     * Jangan submit dua kali.
                     */

                    if (loginButton) {

                        loginButton.disabled = true;

                    }


                    if (loginButtonText) {

                        loginButtonText.textContent =
                            "Memproses...";

                    }

                });

            }

        });

    </script>

</body>

</html>