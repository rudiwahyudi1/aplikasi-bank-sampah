                        <i class="bi bi-hourglass-split fs-2 text-warning"></i>
                    </div>
                    <h5 class="modal-title fw-bolder text-dark" id="idleTimeoutModalLabel" style="font-size: 18px; letter-spacing: -0.3px;">Sesi Akan Segera Berakhir</h5>
                </div>
            </div>
            <div class="modal-body px-4 text-center py-3">
