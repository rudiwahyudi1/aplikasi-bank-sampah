<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
></script>


<script>

document.addEventListener(
    "DOMContentLoaded",
    function () {


        /* =====================================================
           SIDEBAR
        ====================================================== */

        const sidebar =
            document.getElementById("appSidebar");

        const sidebarToggle =
            document.getElementById("sidebarToggle");

        const sidebarOverlay =
            document.getElementById("sidebarOverlay");


        function openSidebar() {

            if (!sidebar) {
                return;
            }

            sidebar.classList.add("show");

            if (sidebarOverlay) {
                sidebarOverlay.classList.add("show");
            }

            document.body.classList.add("sidebar-open");

        }


        function closeSidebar() {

            if (!sidebar) {
                return;
            }

            sidebar.classList.remove("show");

            if (sidebarOverlay) {
                sidebarOverlay.classList.remove("show");
            }

            document.body.classList.remove("sidebar-open");

        }


        if (sidebarToggle) {

            sidebarToggle.addEventListener(
                "click",
                function () {

                    if (
                        sidebar &&
                        sidebar.classList.contains("show")
                    ) {

                        closeSidebar();

                    } else {

                        openSidebar();

                    }

                }
            );

        }

        const sidebarCloseBtn = document.getElementById("sidebarCloseBtn");
        if (sidebarCloseBtn) {
            sidebarCloseBtn.addEventListener("click", closeSidebar);
        }

        const bottomNavMenuBtn = document.getElementById("bottomNavMenuBtn");
        if (bottomNavMenuBtn) {
            bottomNavMenuBtn.addEventListener("click", function(e) {
                e.preventDefault();
                if (sidebar && sidebar.classList.contains("show")) {
                    closeSidebar();
                } else {
                    openSidebar();
                }
            });
        }


        if (sidebarOverlay) {

            sidebarOverlay.addEventListener(
                "click",
                closeSidebar
            );

        }


        document
            .querySelectorAll(".sidebar .side-link")
            .forEach(function (link) {

                link.addEventListener(
                    "click",
                    function () {

                        if (
                            window.innerWidth <= 991
                        ) {

                            closeSidebar();

                        }

                    }
                );

            });


        document.addEventListener(
            "keydown",
            function (event) {

                if (event.key === "Escape") {

                    closeSidebar();

                }

            }
        );


        /* =====================================================
           NOTIFICATION CHIME SOUND (WEB AUDIO API)
        ====================================================== */

        function playChimeSound() {
            try {
                const AudioContext = window.AudioContext || window.webkitAudioContext;
                if (!AudioContext) return;
                const ctx = new AudioContext();
                if (ctx.state === "suspended") {
                    ctx.resume();
                }

                // Chime melodis dual-tone "C-E-G-C (centringgg!)"
                const notes = [
                    { freq: 523.25, time: 0.00, dur: 0.35, gain: 0.18 }, // C5
                    { freq: 659.25, time: 0.08, dur: 0.40, gain: 0.22 }, // E5
                    { freq: 783.99, time: 0.16, dur: 0.45, gain: 0.25 }, // G5
                    { freq: 1046.50, time: 0.24, dur: 0.65, gain: 0.30 }  // C6 (tinggg)
                ];

                const now = ctx.currentTime;
                notes.forEach(n => {
                    const osc = ctx.createOscillator();
                    const gain = ctx.createGain();

                    osc.type = "sine";
                    osc.frequency.setValueAtTime(n.freq, now + n.time);

                    gain.gain.setValueAtTime(0, now + n.time);
                    gain.gain.linearRampToValueAtTime(n.gain, now + n.time + 0.02);
                    gain.gain.exponentialRampToValueAtTime(0.0001, now + n.time + n.dur);

                    osc.connect(gain);
                    gain.connect(ctx.destination);

                    osc.start(now + n.time);
                    osc.stop(now + n.time + n.dur);
                });
            } catch (e) {
                console.log("AudioContext chime disabled or blocked by browser policy:", e);
            }
        }
        window.playChimeSound = playChimeSound;

        /* =====================================================
           FLASH AUTO DISMISS & CHIME
        ====================================================== */

        const flashAlerts = document.querySelectorAll(".auto-dismiss");
        if (flashAlerts.length > 0) {
            // Bunyikan chime centring saat flash pesan tampil
            setTimeout(playChimeSound, 150);
        }

        flashAlerts.forEach(function (element) {
            setTimeout(
                function () {
                    element.style.transition = "opacity .3s ease";
                    element.style.opacity = "0";
                    setTimeout(
                        function () {
                            element.remove();
                        },
                        300
                    );
                },
                4500
            );
        });


        /* =====================================================
           NOTIFICATION
        ====================================================== */

        const notificationButton =
            document.getElementById(
                "notificationButton"
            );

        const notificationDropdown =
            document.getElementById(
                "notificationDropdown"
            );

        const notificationWrapper =
            document.getElementById(
                "notificationWrapper"
            );

        const notificationBadge =
            document.getElementById(
                "notificationBadge"
            );

        const notificationList =
            document.getElementById(
                "notificationList"
            );

        const notificationHeaderSub =
            document.getElementById(
                "notificationHeaderSub"
            );

        const notificationReadAll =
            document.getElementById(
                "notificationReadAll"
            );


        let notificationData = [];


        /* =====================================================
           FORMAT WAKTU
        ====================================================== */

        function formatNotificationTime(dateValue) {

            if (!dateValue) {
                return "";
            }

            const date =
                new Date(
                    String(dateValue).replace(" ", "T")
                );

            if (Number.isNaN(date.getTime())) {
                return "";
            }

            const now =
                new Date();

            const diff =
                Math.floor(
                    (now.getTime() - date.getTime())
                    / 1000
                );


            if (diff < 60) {
                return "Baru saja";
            }


            if (diff < 3600) {

                return (
                    Math.floor(diff / 60) +
                    " menit lalu"
                );

            }


            if (diff < 86400) {

                return (
                    Math.floor(diff / 3600) +
                    " jam lalu"
                );

            }


            if (diff < 604800) {

                return (
                    Math.floor(diff / 86400) +
                    " hari lalu"
                );

            }


            return date.toLocaleDateString(
                "id-ID",
                {
                    day: "2-digit",
                    month: "short",
                    year: "numeric"
                }
            );

        }


        /* =====================================================
           ICON NOTIFICATION
        ====================================================== */

        function getNotificationIcon(item) {

            if (item.icon) {
                return item.icon;
            }


            const type =
                String(item.type || "info")
                    .toLowerCase();


            if (
                type.includes("success") ||
                type.includes("collection") ||
                type.includes("waste")
            ) {

                return "bi bi-recycle";

            }


            if (
                type.includes("danger") ||
                type.includes("error")
            ) {

                return "bi bi-exclamation-triangle-fill";

            }


            if (
                type.includes("warning")
            ) {

                return "bi bi-exclamation-circle-fill";

            }


            if (
                type.includes("sales") ||
                type.includes("sale") ||
                type.includes("wallet")
            ) {

                return "bi bi-wallet2";

            }


            return "bi bi-bell-fill";

        }


        /* =====================================================
           ICON CLASS
        ====================================================== */

        function getIconClass(type) {

            const value =
                String(type || "info")
                    .toLowerCase();


            if (
                value.includes("danger") ||
                value.includes("error")
            ) {

                return "danger";

            }


            if (
                value.includes("warning")
            ) {

                return "warning";

            }


            if (
                value.includes("info")
            ) {

                return "info";

            }


            return "";

        }


        /* =====================================================
           ESCAPE HTML
        ====================================================== */

        function escapeHtml(value) {

            return String(value ?? "")
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");

        }


        /* =====================================================
           RENDER NOTIFICATIONS
        ====================================================== */

        function renderNotifications() {

            if (!notificationList) {
                return;
            }


            if (!Array.isArray(notificationData)) {

                notificationData = [];

            }


            const unreadCount =
                notificationData.filter(
                    item =>
                        Number(item.is_read) === 0
                ).length;


            updateBadge(unreadCount);


            if (notificationHeaderSub) {

                notificationHeaderSub.textContent =
                    unreadCount > 0
                        ? `${unreadCount} notifikasi belum dibaca`
                        : "Semua notifikasi sudah dibaca";

            }


            if (!notificationData.length) {

                notificationList.innerHTML = `

                    <div class="notification-empty">

                        <div class="notification-empty-icon">

                            <i class="bi bi-bell-slash"></i>

                        </div>

                        <div class="notification-empty-title">

                            Belum ada notifikasi

                        </div>

                        <div class="notification-empty-text">

                            Notifikasi aktivitas akan muncul di sini.

                        </div>

                    </div>

                `;

                return;

            }


            notificationList.innerHTML =
                notificationData
                    .map(function (item) {

                        const isUnread =
                            Number(item.is_read) === 0;


                        const icon =
                            getNotificationIcon(item);


                        const iconClass =
                            getIconClass(item.type);


                        const title =
                            escapeHtml(
                                item.title ||
                                "Notifikasi"
                            );


                        const message =
                            escapeHtml(
                                item.message ||
                                ""
                            );


                        const time =
                            formatNotificationTime(
                                item.created_at
                            );


                        return `

                            <div
                                class="notification-item ${isUnread ? "unread" : ""}"
                                data-notification-id="${Number(item.id)}"
                            >

                                <div class="notification-icon ${iconClass}">

                                    <i class="${escapeHtml(icon)}"></i>

                                </div>


                                <div class="notification-body">

                                    <div class="notification-title">

                                        ${title}

                                    </div>


                                    <div class="notification-message">

                                        ${message}

                                    </div>


                                    <div class="notification-time">

                                        <i class="bi bi-clock me-1"></i>

                                        ${escapeHtml(time)}

                                    </div>

                                </div>


                                ${
                                    isUnread
                                        ? `<div class="notification-dot"></div>`
                                        : ""
                                }

                            </div>

                        `;

                    })
                    .join("");

        }


        /* =====================================================
           BADGE
        ====================================================== */

        function updateBadge(count) {

            if (!notificationBadge) {
                return;
            }


            const total =
                Number(count || 0);


            if (total <= 0) {

                notificationBadge.classList.remove(
                    "show"
                );

                notificationBadge.textContent =
                    "0";

                return;

            }


            notificationBadge.classList.add(
                "show"
            );


            notificationBadge.textContent =
                total > 99
                    ? "99+"
                    : String(total);

        }


        /* =====================================================
           LOAD NOTIFICATIONS
        ====================================================== */

        async function loadNotifications() {

            try {

                const response =
                    await fetch(
                        "/notifications",
                        {
                            method: "GET",
                            headers: {
                                "Accept":
                                    "application/json"
                            },
                            cache: "no-store"
                        }
                    );


                if (!response.ok) {

                    return;

                }


                const result =
                    await response.json();


                if (
                    !result ||
                    result.success !== true
                ) {

                    return;

                }


                const previousUnread = notificationData.filter(i => Number(i.is_read) === 0).length;
                const newUnread = Array.isArray(result.notifications) 
                    ? result.notifications.filter(i => Number(i.is_read) === 0).length 
                    : 0;

                if (notificationData.length > 0 && newUnread > previousUnread) {
                    playChimeSound();
                }

                notificationData =
                    Array.isArray(
                        result.notifications
                    )
                        ? result.notifications
                        : [];


                renderNotifications();

            } catch (error) {

                console.error(
                    "Gagal memuat notifikasi:",
                    error
                );

            }

        }


        /* =====================================================
           MARK ONE READ
        ====================================================== */

        async function markNotificationRead(id) {

            if (!id) {
                return;
            }


            try {

                const response =
                    await fetch(
                        `/notifications/${id}/read`,
                        {
                            method: "POST",
                            headers: {
                                "Content-Type":
                                    "application/json"
                            }
                        }
                    );


                if (!response.ok) {
                    return;
                }


                const item =
                    notificationData.find(
                        notification =>
                            Number(notification.id) ===
                            Number(id)
                    );


                if (item) {

                    item.is_read = 1;

                }


                renderNotifications();

            } catch (error) {

                console.error(
                    "Gagal membaca notifikasi:",
                    error
                );

            }

        }


        /* =====================================================
           MARK ALL READ
        ====================================================== */

        async function markAllNotificationsRead() {

            try {

                const response =
                    await fetch(
                        "/notifications/read-all",
                        {
                            method: "POST",
                            headers: {
                                "Content-Type":
                                    "application/json"
                            }
                        }
                    );


                if (!response.ok) {
                    return;
                }


                notificationData.forEach(
                    function (item) {

                        item.is_read = 1;

                    }
                );


                renderNotifications();

            } catch (error) {

                console.error(
                    "Gagal menandai semua notifikasi:",
                    error
                );

            }

        }


        /* =====================================================
           CLICK NOTIFICATION
        ====================================================== */

        if (notificationList) {

            notificationList.addEventListener(
                "click",
                async function (event) {

                    const item =
                        event.target.closest(
                            ".notification-item"
                        );


                    if (!item) {
                        return;
                    }

                    if (item.classList.contains("unread")) {
                        playChimeSound();
                    }

                    const id =
                        Number(
                            item.dataset.notificationId
                        );


                    await markNotificationRead(id);

                }
            );

        }


        /* =====================================================
           OPEN / CLOSE DROPDOWN
        ====================================================== */

        if (notificationButton) {

            notificationButton.addEventListener(
                "click",
                async function (event) {

                    event.stopPropagation();


                    const isOpen =
                        notificationDropdown &&
                        notificationDropdown.classList.contains(
                            "show"
                        );


                    if (notificationDropdown) {

                        notificationDropdown.classList.toggle(
                            "show"
                        );

                    }


                    notificationButton.setAttribute(
                        "aria-expanded",
                        isOpen ? "false" : "true"
                    );


                    if (!isOpen) {

                        await loadNotifications();

                    }

                }
            );

        }


        document.addEventListener(
            "click",
            function (event) {

                if (
                    notificationWrapper &&
                    !notificationWrapper.contains(
                        event.target
                    )
                ) {

                    if (notificationDropdown) {

                        notificationDropdown.classList.remove(
                            "show"
                        );

                    }


                    if (notificationButton) {

                        notificationButton.setAttribute(
                            "aria-expanded",
                            "false"
                        );

                    }

                }

            }
        );


        /* =====================================================
           READ ALL BUTTON
        ====================================================== */

        if (notificationReadAll) {

            notificationReadAll.addEventListener(
                "click",
                function (event) {

                    event.preventDefault();

                    event.stopPropagation();

                    markAllNotificationsRead();

                }
            );

        }


        /* =====================================================
           LIVE CHAT UNREAD BADGE SINKRONISASI
        ====================================================== */
        async function loadChatUnreadCount() {
            try {
                const response = await fetch('/chat/api/unread-count');
                const data = await response.json();
                if (data && data.success) {
                    const total = Number(data.total_unread || 0);
                    const navBadge = document.getElementById('chatNavBadge');
                    const topbarBadge = document.getElementById('chatTopbarBadge');
                    const bottomBadge = document.getElementById('chatBottomBadge');

                    if (navBadge) {
                        navBadge.innerText = total > 99 ? '99+' : total;
                        navBadge.style.display = total > 0 ? 'inline-block' : 'none';
                    }
                    if (topbarBadge) {
                        topbarBadge.innerText = total > 99 ? '99+' : total;
                        topbarBadge.style.display = total > 0 ? 'inline-block' : 'none';
                    }
                    if (bottomBadge) {
                        bottomBadge.innerText = total > 99 ? '99+' : total;
                        bottomBadge.style.display = total > 0 ? 'inline-block' : 'none';
                    }
                }
            } catch (err) {
                // Silently ignore
            }
        }

        /* =====================================================
           INITIAL LOAD & REALTIME SSE AUTO-SYNC
        ====================================================== */

        loadNotifications();
        loadChatUnreadCount();

        /* =====================================================
           PILAHKITA UNIFIED REALTIME SSE CLIENT (AUTO-SYNC)
        ====================================================== */
        function initGlobalRealtime() {
            if (typeof EventSource === "undefined") return;

            let evtSource = null;
            try {
                evtSource = new EventSource("/api/realtime/stream");
            } catch (e) {
                return;
            }

            evtSource.addEventListener("connected", function () {
                // Connection established
            });

            evtSource.addEventListener("chat_message", function (e) {
                try {
                    const msg = JSON.parse(e.data);
                    window.dispatchEvent(new CustomEvent("pilahkita:chat", { detail: msg }));
                    loadChatUnreadCount();

                    // Jika tidak sedang di halaman /chat dan bukan pesan sendiri, tampilkan toast
                    const myUserId = <%= (typeof viewUser !== "undefined" && viewUser) ? viewUser.id : 0 %>;
                    if (!window.location.pathname.startsWith("/chat") && msg.sender_id !== myUserId) {
                        const isPublic = (!msg.receiver_id || msg.receiver_id === 0);
                        const title = isPublic ? `💬 Diskusi Umum: ${msg.sender_name || 'Pengguna'}` : `💬 Pesan Baru: ${msg.sender_name || 'Pengguna'}`;
                        showRealtimeToast({
                            icon: "bi-chat-dots-fill",
                            iconBg: "#e0f2fe",
                            iconColor: "#0284c7",
                            title: title,
                            message: msg.message || "Mengirim lampiran file",
                            actionUrl: "/chat"
                        });
                    }
                } catch (_) {}
            });

            evtSource.addEventListener("chat_clear", function (e) {
                try {
                    const data = JSON.parse(e.data);
                    window.dispatchEvent(new CustomEvent("pilahkita:chat_clear", { detail: data }));
                    loadChatUnreadCount();
                } catch (_) {}
            });

            evtSource.addEventListener("chat_delete", function (e) {
                try {
                    const data = JSON.parse(e.data);
                    window.dispatchEvent(new CustomEvent("pilahkita:chat_delete", { detail: data }));
                } catch (_) {}
            });

            evtSource.addEventListener("data_change", function (e) {
                try {
                    const data = JSON.parse(e.data);
                    window.dispatchEvent(new CustomEvent("pilahkita:datachanged", { detail: data }));

                    // Segarkan notifikasi & badge unread chat seketika
                    loadNotifications();
                    loadChatUnreadCount();

                    // Pemetaan ikon & rute entitas data
                    let icon = "bi-arrow-repeat";
                    let iconBg = "#ecfdf5";
                    let iconColor = "#16a34a";
                    let targetUrl = "";

                    if (data.entity === "collection") {
                        icon = "bi-truck";
                        iconBg = "#f0fdf4";
                        iconColor = "#15803d";
                        targetUrl = "/collection";
                    } else if (data.entity === "wallet") {
                        icon = "bi-wallet2";
                        iconBg = "#ecfdf5";
                        iconColor = "#059669";
                        targetUrl = "/wallet";
                    } else if (data.entity === "sales") {
                        icon = "bi-bag-check-fill";
                        iconBg = "#fef3c7";
                        iconColor = "#d97706";
                        targetUrl = "/sales";
                    } else if (data.entity === "prices") {
                        icon = "bi-tags-fill";
                        iconBg = "#eff6ff";
                        iconColor = "#2563eb";
                        targetUrl = "/prices";
                    } else if (data.entity === "complaints") {
                        icon = "bi-exclamation-octagon-fill";
                        iconBg = "#fee2e2";
                        iconColor = "#dc2626";
                        targetUrl = "/complaints";
                    } else if (data.entity === "documents") {
                        icon = "bi-file-earmark-text-fill";
                        iconBg = "#f5f3ff";
                        iconColor = "#7c3aed";
                        targetUrl = "/documents";
                    } else if (data.entity === "drop_points") {
                        icon = "bi-geo-alt-fill";
                        iconBg = "#f0fdf4";
                        iconColor = "#16a34a";
                        targetUrl = "/drop-points";
                    }

                    // Tampilkan floating toast modern
                    showRealtimeToast({
                        icon: icon,
                        iconBg: iconBg,
                        iconColor: iconColor,
                        title: data.title || "Pembaruan Realtime",
                        message: data.message || "Data baru saja diperbarui oleh sistem.",
                        actionUrl: targetUrl
                    });

                    // AUTO-SYNC: Jika pengguna sedang aktif di halaman entitas tersebut
                    // sinkronkan data otomatis tanpa harus menekan refresh browser manual
                    if (targetUrl && window.location.pathname.startsWith(targetUrl)) {
                        clearTimeout(window._pilahkitaAutoReloadTimer);
                        window._pilahkitaAutoReloadTimer = setTimeout(() => {
                            const activeModal = document.querySelector(".modal.show");
                            const isTyping = document.activeElement && (document.activeElement.tagName === "INPUT" || document.activeElement.tagName === "TEXTAREA");
                            if (!activeModal && !isTyping) {
                                window.location.reload();
                            }
                        }, 1200);
                    }
                } catch (_) {}
            });
        }

        // Floating Toast Renderer
        function showRealtimeToast(options) {
            const container = document.getElementById("realtimeToastContainer");
            if (!container) return;

            const toastEl = document.createElement("div");
            toastEl.className = "toast align-items-center shadow-lg border-0 mb-2";
            toastEl.setAttribute("role", "alert");
            toastEl.setAttribute("aria-live", "assertive");
            toastEl.setAttribute("aria-atomic", "true");
            toastEl.style.borderRadius = "16px";
            toastEl.style.background = "rgba(255, 255, 255, 0.98)";
            toastEl.style.backdropFilter = "blur(12px)";
            toastEl.style.border = "1px solid rgba(187, 247, 208, 0.8)";
            toastEl.style.pointerEvents = "auto";
            toastEl.style.boxShadow = "0 14px 35px -8px rgba(0, 0, 0, 0.15)";

            toastEl.innerHTML = `
                <div class="d-flex p-3 align-items-start gap-3">
                    <div style="width: 40px; height: 40px; border-radius: 12px; background: ${options.iconBg || '#ecfdf5'}; color: ${options.iconColor || '#16a34a'}; display: grid; place-items: center; font-size: 18px; flex-shrink: 0; box-shadow: 0 4px 10px rgba(0,0,0,0.05);">
                        <i class="bi ${options.icon || 'bi-bell-fill'}"></i>
                    </div>
                    <div class="flex-grow-1 min-w-0">
                        <div class="d-flex align-items-center justify-content-between mb-0.5">
                            <span class="fw-bold text-dark text-truncate" style="font-size: 13.5px;">${options.title}</span>
                            <span class="badge rounded-pill bg-success-subtle text-success px-2 py-0.5 ms-1" style="font-size: 10px; font-weight: 600;">Realtime</span>
                        </div>
                        <div class="text-secondary small text-truncate" style="font-size: 12px; max-width: 250px; line-height: 1.35;">
                            ${options.message}
                        </div>
                        ${options.actionUrl ? `
                            <a href="${options.actionUrl}" class="btn btn-sm btn-link text-success p-0 fw-semibold mt-1 d-inline-flex align-items-center gap-1" style="font-size: 11.5px; text-decoration: none;">
                                <span>Lihat Data</span> <i class="bi bi-arrow-right"></i>
                            </a>
                        ` : ''}
                    </div>
                    <button type="button" class="btn-close ms-auto p-1" data-bs-dismiss="toast" aria-label="Tutup" style="font-size: 10px;"></button>
                </div>
            `;

            container.appendChild(toastEl);
            const bsToast = new bootstrap.Toast(toastEl, { delay: 6000 });
            bsToast.show();

            toastEl.addEventListener("hidden.bs.toast", () => {
                toastEl.remove();
            });
        }

        initGlobalRealtime();


        /* =====================================================
           AUTO REFRESH
           
           Setiap 15 detik
        ====================================================== */

        setInterval(
            function () {

                loadNotifications();
                loadChatUnreadCount();

            },
            15000
        );



        /* =====================================================
           RESET BODY DESKTOP
        ====================================================== */

        window.addEventListener(
            "resize",
            function () {

                if (
                    window.innerWidth > 991
                ) {

                    closeSidebar();

                }

            }
        );

    }

);

/* =========================================================
   INACTIVITY AUTO-LOGOUT & SESSION TIMEOUT ENGINE
========================================================= */
(function initInactivityHandler() {
    // 15 menit total idle, tampilkan warning 60 detik sebelum logout
    const TOTAL_IDLE_MS = 15 * 60 * 1000;
    const WARNING_BEFORE_MS = 60 * 1000;
    const WARNING_THRESHOLD_MS = TOTAL_IDLE_MS - WARNING_BEFORE_MS;

    let lastInteraction = Date.now();
    let isWarningShown = false;
    let idleModalInstance = null;

    function getModal() {
        const modalEl = document.getElementById('idleTimeoutModal');
        if (!modalEl) return null;
        if (!idleModalInstance && window.bootstrap && window.bootstrap.Modal) {
            idleModalInstance = new bootstrap.Modal(modalEl, {
                backdrop: 'static',
                keyboard: false
            });
        }
        return { el: modalEl, instance: idleModalInstance };
    }

    async function pingServerSession() {
        try {
            await fetch('/auth/ping', {
                method: 'POST',
                headers: { 'Accept': 'application/json', 'Content-Type': 'application/json' }
            });
        } catch (err) {
            // Silently ignore network hiccup
        }
    }

    function recordActivity() {
        if (isWarningShown) return;
        const now = Date.now();
        if (now - lastInteraction > 2000) {
            lastInteraction = now;
        }
    }

    function showIdleWarning() {
        if (isWarningShown) return;
        isWarningShown = true;

        const modalObj = getModal();
        if (modalObj && modalObj.instance) {
            modalObj.instance.show();
        } else if (modalObj && modalObj.el) {
            modalObj.el.classList.add('show');
            modalObj.el.style.display = 'block';
        }

        updateCountdown();
    }

    function extendSession() {
        lastInteraction = Date.now();
        isWarningShown = false;

        const modalObj = getModal();
        if (modalObj && modalObj.instance) {
            modalObj.instance.hide();
        } else if (modalObj && modalObj.el) {
            modalObj.el.classList.remove('show');
            modalObj.el.style.display = 'none';
        }

        pingServerSession();
    }

    function updateCountdown() {
        const remainingMs = Math.max(0, TOTAL_IDLE_MS - (Date.now() - lastInteraction));
        const remainingSec = Math.ceil(remainingMs / 1000);

        const countEl = document.getElementById('idleCountdownDisplay');
        if (countEl) {
            countEl.textContent = remainingSec;
        }

        if (remainingMs <= 0) {
            window.location.href = '/logout?reason=idle';
        }
    }

    ['mousemove', 'mousedown', 'keydown', 'touchstart', 'scroll'].forEach(evt => {
        window.addEventListener(evt, recordActivity, { passive: true });
    });

    document.addEventListener('DOMContentLoaded', () => {
        const stayBtn = document.getElementById('stayLoggedInBtn');
        if (stayBtn) {
            stayBtn.addEventListener('click', extendSession);
        }
    });

    setInterval(() => {
        const elapsed = Date.now() - lastInteraction;

        if (elapsed >= TOTAL_IDLE_MS) {
            window.location.href = '/logout?reason=idle';
        } else if (elapsed >= WARNING_THRESHOLD_MS) {
            showIdleWarning();
            updateCountdown();
        }
    }, 1000);

    document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible') {
            const elapsed = Date.now() - lastInteraction;
            if (elapsed >= TOTAL_IDLE_MS) {
                window.location.href = '/logout?reason=idle';
            } else if (elapsed >= WARNING_THRESHOLD_MS) {
                showIdleWarning();
                updateCountdown();
            }
        }
    });

    window.addEventListener('pageshow', (event) => {
        if (event.persisted) {
            window.location.reload();
        }
    });
})();

</script>

