/* =========================================================
   SAFE VIEW DATA
========================================================= */

const viewUser =
    (typeof user !== "undefined" && user)
        ? user
        : null;

const viewPermissions =
    (typeof permissions !== "undefined" && Array.isArray(permissions))
        ? permissions
        : [];

const pageUrl =
    (typeof currentUrl !== "undefined" && currentUrl)
        ? currentUrl
        : (typeof currentPath !== "undefined" && currentPath ? currentPath : "");

const successMessage =
    (typeof success_msg !== "undefined" && success_msg)
        ? success_msg
        : "";

const errorMessage =
    (typeof error_msg !== "undefined" && error_msg)
        ? error_msg
        : "";


/* =========================================================
   HELPER
========================================================= */

const hasPermission = (code) => {

    if (viewUser && viewUser.role === "superadmin") {
        return true;
    }

    return viewPermissions.includes(code);
};


const isActive = (path) => {

    if (!pageUrl) {
        return false;
    }

    return (
        pageUrl === path ||
        pageUrl.startsWith(path + "/")
    );
};


const userName =
    viewUser && viewUser.full_name
        ? viewUser.full_name
        : "Pengguna";


const userRole =
    viewUser && viewUser.role
        ? String(viewUser.role).replaceAll("_", " ")
        : "User";


const userInitial =
    userName.charAt(0).toUpperCase();

