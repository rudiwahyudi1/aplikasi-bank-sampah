<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title><%= title %> - <%= appName %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        @page {
            size: A4 portrait;
            margin: 15mm 12mm 15mm 12mm;
        }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            font-size: 12px;
            color: #1f2937;
            background: #fff;
        }
        .header-box {
            border-bottom: 2px solid #047857;
            padding-bottom: 12px;
            margin-bottom: 20px;
        }
        .app-brand {
            font-size: 20px;
            font-weight: 800;
            color: #047857;
            letter-spacing: -0.5px;
        }
        .doc-title {
            font-size: 15px;
            font-weight: 700;
            color: #111827;
            margin-top: 2px;
        }
        .stat-card {
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            padding: 12px;
            text-align: center;
            background: #f9fafb;
            height: 100%;
        }
        .stat-card .val {
            font-size: 14px;
            font-weight: 700;
            margin-top: 4px;
        }
        .pdf-table-responsive {
            width: 100%;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
            border-radius: 12px;
            border: 1px solid #e5e7eb;
            margin-top: 10px;
            margin-bottom: 20px;
            background: #fff;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin: 0;
            min-width: 620px;
        }
        th {
            background-color: #047857 !important;
            color: white !important;
            font-weight: 600;
            padding: 10px 12px;
            font-size: 11px;
            text-align: left;
            border: 1px solid #047857;
        }
        td {
            padding: 8px 12px;
            font-size: 11px;
            border: 1px solid #e5e7eb;
        }
        tr:nth-child(even) {
            background-color: #f9fafb;
        }
        .no-print {
            background: #ffffff;
            border-bottom: 1px solid #e5e7eb;
            padding: 12px 16px;
            position: sticky;
            top: 0;
            z-index: 1000;
            box-shadow: 0 2px 8px rgba(0,0,0,0.04);
        }
        @media screen and (max-width: 767.98px) {
            body {
                background: #f8fafc;
                padding-bottom: 30px;
            }
            .no-print {
                padding: 10px 12px;
            }
            .header-box {
                flex-direction: column !important;
                align-items: flex-start !important;
                gap: 10px;
            }
            .header-box .text-end {
                text-align: left !important;
            }
            .doc-container {
                padding: 12px !important;
            }
            .doc-paper {
                background: #fff;
                border-radius: 18px;
                padding: 16px;
                border: 1px solid #edf0f4;
                box-shadow: 0 4px 20px rgba(0,0,0,0.04);
            }
        }
        @media print {
            .no-print { display: none !important; }
            .pdf-table-responsive {
                overflow: visible !important;
                border: none !important;
                border-radius: 0 !important;
                margin: 10px 0 20px 0 !important;
            }
            table {
                min-width: 100% !important;
            }
            .doc-paper {
                border: none !important;
                box-shadow: none !important;
                padding: 0 !important;
            }
        }
    </style>
</head>
<body>

<div class="no-print d-flex flex-wrap justify-content-between align-items-center gap-2">
    <div class="d-flex align-items-center gap-2">
        <a href="/reports" onclick="handlePdfBack(event, '/reports')" class="btn btn-sm btn-light border rounded-pill px-3 text-dark text-decoration-none d-inline-flex align-items-center shadow-sm">
            <i class="bi bi-arrow-left me-1"></i> Kembali
        </a>
        <span class="fw-bold text-dark d-none d-sm-inline">Pratinjau PDF Laporan Analitik</span>
    </div>
    <div class="d-flex gap-2 w-100 w-sm-auto justify-content-end">
        <button onclick="window.print()" class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm">
            <i class="bi bi-printer me-1"></i> Cetak / Unduh PDF
        </button>
        <% if (typeof excelUrl !== 'undefined' && excelUrl) { %>
        <a href="<%= excelUrl %>" class="btn btn-sm btn-success rounded-pill px-3">
            <i class="bi bi-file-earmark-excel me-1"></i> Excel
        </a>
        <% } %>
    </div>
</div>

<div class="container-fluid doc-container px-3 px-md-4 py-3">
    <div class="doc-paper">
        <!-- Notifikasi Mobile View -->
        <div class="d-md-none alert alert-light border shadow-sm py-2 px-3 small rounded-3 mb-3 d-flex align-items-center gap-2 text-muted">
            <i class="bi bi-phone-flip text-success fs-6"></i>
            <span><strong>Mode Ponsel:</strong> Geser tabel ke samping untuk melihat seluruh kolom data, atau klik tombol cetak untuk cetak A4.</span>
        </div>

        <div class="header-box d-flex justify-content-between align-items-end">
            <div>
                <div class="app-brand"><i class="bi bi-recycle text-success"></i> <%= appName %></div>
                <div class="doc-title"><%= title %></div>
                <div class="text-muted small">Periode Analisis: <strong><%= periodText %></strong></div>
            </div>
            <div class="text-end small">
                <div>Dicetak oleh: <strong><%= printedBy %></strong></div>
                <div>Waktu Cetak: <strong><%= printDate %></strong></div>
            </div>
        </div>

        <!-- Ringkasan Eksekutif KPI -->
        <div class="row g-2 mb-3">
            <div class="col-6 col-md-3">
                <div class="stat-card">
                    <div class="text-muted small">Total Penjemputan</div>
                    <div class="val text-dark"><%= stats.collections || 0 %> Pickup (<%= stats.completed || 0 %> Selesai)</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-card">
                    <div class="text-muted small">Total Berat Sampah</div>
                    <div class="val text-success"><%= formatWeight(stats.weight || 0) %></div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-card">
                    <div class="text-muted small">Nilai Sampah Terkumpul</div>
                    <div class="val text-primary"><%= formatRupiah(stats.value || 0) %></div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-card">
                    <div class="text-muted small">Omset Penjualan Sampah</div>
                    <div class="val text-success"><%= formatRupiah(stats.sales_value || 0) %></div>
                </div>
            </div>
        </div>

        <!-- Tabel 1: Rekap Sampah Berdasarkan Jenis & Kategori -->
        <div class="fw-bold text-dark mt-4 mb-2 small text-uppercase" style="letter-spacing: 0.5px;">
            1. Rekapitulasi Berdasarkan Jenis & Kategori Sampah
        </div>
        <div class="pdf-table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th style="width: 40px;" class="text-center">No</th>
                        <th>Jenis Sampah</th>
                        <th style="width: 140px;" class="text-center">Kategori</th>
                        <th style="width: 150px;" class="text-end">Total Berat</th>
                        <th style="width: 170px;" class="text-end">Total Nilai Ekonomi</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (byWaste && byWaste.length) { %>
                        <% byWaste.forEach((w, idx) => { %>
                            <tr>
                                <td class="text-center"><%= idx + 1 %></td>
                                <td><strong><%= w.name || '-' %></strong></td>
                                <td class="text-center"><span class="badge bg-light text-dark border"><%= (w.category || '-').toUpperCase() %></span></td>
                                <td class="text-end fw-bold text-dark"><%= formatWeight(w.weight || 0) %></td>
                                <td class="text-end fw-bold text-success"><%= formatRupiah(w.value || 0) %></td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="5" class="text-center py-3 text-muted">Tidak ada data sampah pada periode ini.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>

        <!-- Tabel 2: Rekap Berdasarkan Mitra Perusahaan -->
        <div class="fw-bold text-dark mt-4 mb-2 small text-uppercase" style="letter-spacing: 0.5px;">
            2. Rekapitulasi Berdasarkan Mitra / Perusahaan
        </div>
        <div class="pdf-table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th style="width: 40px;" class="text-center">No</th>
                        <th>Nama Perusahaan / Wilayah</th>
                        <th style="width: 140px;" class="text-center">Frekuensi Pickup</th>
                        <th style="width: 150px;" class="text-end">Total Tonase</th>
                        <th style="width: 170px;" class="text-end">Total Nilai</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (byCompany && byCompany.length) { %>
                        <% byCompany.forEach((c, idx) => { %>
                            <tr>
                                <td class="text-center"><%= idx + 1 %></td>
                                <td><strong><%= c.company || '-' %></strong></td>
                                <td class="text-center"><%= c.collections || 0 %> kali</td>
                                <td class="text-end fw-bold text-dark"><%= formatWeight(c.weight || 0) %></td>
                                <td class="text-end fw-bold text-success"><%= formatRupiah(c.value || 0) %></td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="5" class="text-center py-3 text-muted">Tidak ada data mitra perusahaan pada periode ini.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>

        <div class="row mt-4 pt-3">
            <div class="col-12 col-md-8 small text-muted mb-4 mb-md-0">
                <p class="mb-1">Catatan Monitoring:</p>
                <ul class="ps-3 mb-0">
                    <li>Laporan analitik diringkas secara real-time dari data transaksi penjemputan dan penjualan.</li>
                    <li>Diterbitkan untuk keperluan evaluasi performa lingkungan dan sirkularitas ekonomi.</li>
                </ul>
            </div>
            <div class="col-12 col-md-4 text-center">
                <div class="small text-muted mb-4 mb-md-5">Disahkan Oleh,</div>
                <div class="fw-bold text-dark text-decoration-underline"><%= printedBy %></div>
                <div class="small text-muted">Manajer Pengelolaan Sampah</div>
            </div>
        </div>
    </div>
</div>

<script>
function handlePdfBack(e, fallbackUrl) {
    if (e) e.preventDefault();
    if (window.opener) {
        window.close();
        return;
    }
    if (window.history.length > 1 && document.referrer && document.referrer.includes(window.location.host)) {
        window.history.back();
        return;
    }
    window.location.href = fallbackUrl || '/reports';
}
</script>
</body>
</html>
