<script>
document.addEventListener("DOMContentLoaded", function () {

    /* ========================================================
       ICON INPUT MODAL
       Tidak mengubah name/value/action/function input.
    ======================================================== */

    function getBuyerInputIcon(element) {

        const name =
            String(element.getAttribute("name") || "").toLowerCase();

        const id =
            String(element.getAttribute("id") || "").toLowerCase();

        const placeholder =
            String(element.getAttribute("placeholder") || "").toLowerCase();

        const type =
            String(element.getAttribute("type") || "").toLowerCase();

        const text =
            `${name} ${id} ${placeholder}`;


        /* Nama */
        if (
            text.includes("nama") ||
            text.includes("name") ||
            text.includes("buyer")
        ) {
            return "bi-person";
        }


        /* Tipe */
        if (
            text.includes("type") ||
            text.includes("tipe") ||
            text.includes("jenis")
        ) {
            return "bi-person-badge";
        }


        /* Perusahaan */
        if (
            text.includes("company") ||
            text.includes("perusahaan") ||
            text.includes("organization") ||
            text.includes("organisasi")
        ) {
            return "bi-building";
        }


        /* Telepon */
        if (
            text.includes("phone") ||
            text.includes("telepon") ||
            text.includes("telp") ||
            text.includes("mobile") ||
            text.includes("whatsapp") ||
            text.includes("wa")
        ) {
            return "bi-telephone";
        }


        /* Email */
        if (
            text.includes("email") ||
            text.includes("mail")
        ) {
            return "bi-envelope";
        }


        /* Alamat */
        if (
            text.includes("address") ||
            text.includes("alamat") ||
            text.includes("jalan") ||
            text.includes("street")
        ) {
            return "bi-geo-alt";
        }


        /* Kota */
        if (
            text.includes("city") ||
            text.includes("kota")
        ) {
            return "bi-buildings";
        }


        /* Provinsi */
        if (
            text.includes("province") ||
            text.includes("provinsi")
        ) {
            return "bi-map";
        }


        /* Kode Pos */
        if (
            text.includes("postal") ||
            text.includes("postcode") ||
            text.includes("kodepos") ||
            text.includes("kode_pos") ||
            text.includes("zip")
        ) {
            return "bi-mailbox";
        }


        /* NIK */
        if (
            text.includes("nik") ||
            text.includes("identity") ||
            text.includes("identitas")
        ) {
            return "bi-person-vcard";
        }


        /* NPWP */
        if (
            text.includes("npwp") ||
            text.includes("tax")
        ) {
            return "bi-receipt";
        }


        /* Harga / nilai */
        if (
            text.includes("price") ||
            text.includes("harga") ||
            text.includes("value") ||
            text.includes("nilai") ||
            text.includes("amount") ||
            text.includes("nominal")
        ) {
            return "bi-cash-stack";
        }


        /* Catatan */
        if (
            text.includes("note") ||
            text.includes("catatan") ||
            text.includes("description") ||
            text.includes("deskripsi") ||
            text.includes("keterangan")
        ) {
            return "bi-card-text";
        }


        /* File */
        if (type === "file") {
            return "bi-image";
        }


        /* Password */
        if (type === "password") {
            return "bi-lock";
        }


        /* Select */
        if (element.tagName === "SELECT") {
            return "bi-list-check";
        }


        /* Textarea */
        if (element.tagName === "TEXTAREA") {
            return "bi-chat-left-text";
        }


        /* Default */
        return "bi-pencil-square";
    }


    function addBuyerInputIcons() {

        document
            .querySelectorAll(".ios-modal")
            .forEach(function (modal) {

                const fields =
                    modal.querySelectorAll(
                        "input:not([type='hidden']):not([type='submit']):not([type='button']):not([type='reset']), select, textarea"
                    );


                fields.forEach(function (field) {

                    /* Jangan proses dua kali */
                    if (
                        field.closest(".buyer-input-group")
                    ) {
                        return;
                    }


                    /*
                     * Jangan mengganggu checkbox/radio.
                     * Fungsi dan value tetap asli.
                     */
                    if (
                        field.type === "checkbox" ||
                        field.type === "radio"
                    ) {
                        return;
                    }


                    const parent =
                        field.parentElement;

                    if (!parent) return;


                    const group =
                        document.createElement("div");

                    group.className =
                        "buyer-input-group";


                    const icon =
                        document.createElement("span");

                    icon.className =
                        "buyer-input-icon";


                    const iconElement =
                        document.createElement("i");

                    iconElement.className =
                        "bi " +
                        getBuyerInputIcon(field);


                    icon.appendChild(
                        iconElement
                    );


                    /*
                     * Pindahkan field ke wrapper.
                     * Atribut name, id, value, required,
                     * validation, dan event tetap berada
                     * pada element field asli.
                     */
                    parent.insertBefore(
                        group,
                        field
                    );


                    group.appendChild(icon);

                    group.appendChild(field);

                });

            });

    }


    /*
     * Jalankan saat halaman selesai.
     */
    addBuyerInputIcons();


    /*
     * Jalankan kembali ketika modal dibuka.
     * Aman karena field yang sudah diproses
     * tidak akan diproses ulang.
     */
    document
        .querySelectorAll(".ios-modal")
        .forEach(function (modal) {

            modal.addEventListener(
                "shown.bs.modal",
                function () {

                    addBuyerInputIcons();

                }
            );

        });


    /* ========================================================
       CONFIG
    ======================================================== */

    const rows = Array.from(
        document.querySelectorAll(".buyer-row")
    );

    const searchInput =
        document.getElementById("buyerSearch");

    const clearButton =
        document.getElementById("clearBuyerSearch");

    const pagination =
        document.getElementById("buyerPagination");

    const pageInfo =
        document.getElementById("buyerPageInfo");

    const countInfo =
        document.getElementById("buyerCount");

    const emptyState =
        document.getElementById("buyerEmpty");

    const paginationWrap =
        document.getElementById("buyerPaginationWrap");

    const pageSize = 10;

    let currentPage = 1;

    let filteredRows = [...rows];


    /* ========================================================
       ALERT
    ======================================================== */

    function showBuyerAlert(
        message,
        type = "warning",
        icon = "bi-exclamation-circle"
    ) {

        const container =
            document.getElementById(
                "buyerAlertContainer"
            );

        if (!container) return;

        const alertId =
            "buyerAlert_" + Date.now();

        const html = `
            <div
                id="${alertId}"
                class="alert alert-${type} alert-dismissible fade show ios-alert d-flex align-items-center gap-2"
                role="alert">

                <i class="bi ${icon} fs-5"></i>

                <div>
                    ${message}
                </div>

                <button
                    type="button"
                    class="btn-close ms-auto"
                    data-bs-dismiss="alert">
                </button>

            </div>
        `;

        container.insertAdjacentHTML(
            "beforeend",
            html
        );

        setTimeout(() => {

            const alertElement =
                document.getElementById(alertId);

            if (alertElement) {

                const alert =
                    bootstrap.Alert.getOrCreateInstance(
                        alertElement
                    );

                alert.close();

            }

        }, 3500);
    }


    /* ========================================================
       RENDER PAGINATION
    ======================================================== */

    function renderPagination() {

        pagination.innerHTML = "";

        if (filteredRows.length === 0) {

            paginationWrap.style.display = "none";

            return;
        }

        paginationWrap.style.display = "flex";

        const totalPages =
            Math.ceil(
                filteredRows.length / pageSize
            );


        /* Previous */

        const prev =
            document.createElement("button");

        prev.type = "button";

        prev.className =
            "ios-page-btn";

        prev.innerHTML =
            '<i class="bi bi-chevron-left"></i>';

        prev.disabled =
            currentPage === 1;

        prev.addEventListener(
            "click",
            function () {

                if (currentPage > 1) {

                    currentPage--;

                    renderTable();

                }

            }
        );

        pagination.appendChild(prev);


        /* Number pagination */

        let startPage =
            Math.max(
                1,
                currentPage - 2
            );

        let endPage =
            Math.min(
                totalPages,
                startPage + 4
            );

        if (endPage - startPage < 4) {

            startPage =
                Math.max(
                    1,
                    endPage - 4
                );

        }


        for (
            let page = startPage;
            page <= endPage;
            page++
        ) {

            const button =
                document.createElement("button");

            button.type = "button";

            button.className =
                "ios-page-btn" +
                (
                    page === currentPage
                        ? " active"
                        : ""
                );

            button.textContent =
                page;

            button.addEventListener(
                "click",
                function () {

                    currentPage = page;

                    renderTable();

                }
            );

            pagination.appendChild(button);

        }


        /* Next */

        const next =
            document.createElement("button");

        next.type = "button";

        next.className =
            "ios-page-btn";

        next.innerHTML =
            '<i class="bi bi-chevron-right"></i>';

        next.disabled =
            currentPage === totalPages;

        next.addEventListener(
            "click",
            function () {

                if (
                    currentPage <
                    totalPages
                ) {

                    currentPage++;

                    renderTable();

                }

            }
        );

        pagination.appendChild(next);

    }


    /* ========================================================
       RENDER TABLE
    ======================================================== */

    function renderTable() {

        rows.forEach(row => {

            row.style.display = "none";

        });


        /* EMPTY */

        if (filteredRows.length === 0) {

            emptyState.style.display = "block";

            paginationWrap.style.display = "none";

            pageInfo.textContent =
                "Tidak ada data";

            countInfo.textContent =
                "0 data";

            return;
        }


        emptyState.style.display = "none";


        const totalPages =
            Math.ceil(
                filteredRows.length / pageSize
            );


        if (currentPage > totalPages) {

            currentPage = totalPages;

        }


        const start =
            (currentPage - 1) *
            pageSize;

        const end =
            start + pageSize;


        const pageRows =
            filteredRows.slice(
                start,
                end
            );


        pageRows.forEach(row => {

            row.style.display = "";

        });


        /* INFO */

        const from =
            start + 1;

        const to =
            Math.min(
                end,
                filteredRows.length
            );

        pageInfo.textContent =
            `Menampilkan ${from}-${to} dari ${filteredRows.length} data`;

        countInfo.textContent =
            `${filteredRows.length} data`;


        renderPagination();

    }


    /* ========================================================
       SEARCH
    ======================================================== */

    function doSearch(showAlert = true) {

        const keyword =
            String(
                searchInput.value || ""
            )
            .trim()
            .toLowerCase();


        /* Clear button */

        clearButton.style.display =
            keyword
                ? "flex"
                : "none";


        filteredRows =
            rows.filter(row => {

                const searchData =
                    String(
                        row.dataset.search || ""
                    ).toLowerCase();

                return searchData.includes(
                    keyword
                );

            });


        currentPage = 1;


        renderTable();


        /* Alert jika kosong */

        if (
            showAlert &&
            keyword &&
            filteredRows.length === 0
        ) {

            showBuyerAlert(
                `Pembeli dengan kata kunci "<strong>${escapeHtml(keyword)}</strong>" tidak ditemukan.`,
                "warning",
                "bi-search"
            );

        }

    }


    /* ========================================================
       ESCAPE HTML
    ======================================================== */

    function escapeHtml(value) {

        return String(value)
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");

    }


    /* ========================================================
       SEARCH EVENT
    ======================================================== */

    searchInput.addEventListener(
        "input",
        function () {

            doSearch(false);

        }
    );


    searchInput.addEventListener(
        "keydown",
        function (event) {

            if (event.key === "Enter") {

                event.preventDefault();

                doSearch(true);

            }

        }
    );


    /* ========================================================
       CLEAR SEARCH
    ======================================================== */

    clearButton.addEventListener(
        "click",
        function () {

            searchInput.value = "";

            doSearch(false);

            searchInput.focus();

        }
    );


    /* ========================================================
       DELETE CONFIRMATION
    ======================================================== */

    document
        .querySelectorAll(".buyer-delete-form")
        .forEach(form => {

            form.addEventListener(
                "submit",
                function (event) {

                    event.preventDefault();

                    const buyerName =
                        form.dataset.name ||
                        "Pembeli ini";


                    const confirmed =
                        window.confirm(
                            `Hapus ${buyerName}?\n\nData pembeli yang dihapus tidak dapat dikembalikan.`
                        );


                    if (confirmed) {

                        form.submit();

                    }

                }
            );

        });


    /* ========================================================
       INITIAL
    ======================================================== */

    if (rows.length === 0) {

        filteredRows = [];

        emptyState.style.display =
            "block";

        paginationWrap.style.display =
            "none";

        pageInfo.textContent =
            "Belum ada data pembeli";

        countInfo.textContent =
            "0 data";

    } else {

        renderTable();

    }

});
</script>