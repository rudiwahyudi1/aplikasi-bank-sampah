<!-- ================================================================
     CLIENT SCRIPT & CHARTS
================================================================ -->
<script>
document.addEventListener("DOMContentLoaded", function () {

    // 1. Live Clock & Greeting
    function updateLiveClock() {
        const now = new Date();
        const hours = String(now.getHours()).padStart(2, '0');
        const minutes = String(now.getMinutes()).padStart(2, '0');
        const seconds = String(now.getSeconds()).padStart(2, '0');
        const clockEl = document.getElementById("liveClock");
        if (clockEl) {
            clockEl.textContent = `${hours}:${minutes}:${seconds} WIB`;
        }

        const dateOptions = { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' };
        const dateEl = document.getElementById("liveDate");
        if (dateEl) {
            dateEl.innerHTML = `<i class="bi bi-calendar3 me-1"></i> ${now.toLocaleDateString('id-ID', dateOptions)}`;
        }

        const greetingEl = document.getElementById("greetingText");
        if (greetingEl) {
            const h = now.getHours();
            if (h >= 4 && h < 11) greetingEl.textContent = "Selamat Pagi";
            else if (h >= 11 && h < 15) greetingEl.textContent = "Selamat Siang";
            else if (h >= 15 && h < 18) greetingEl.textContent = "Selamat Sore";
            else greetingEl.textContent = "Selamat Malam";
        }
    }
    updateLiveClock();
    setInterval(updateLiveClock, 1000);

    // 2. Trend Chart
    const trendCtx = document.getElementById('trendChart');
    if (trendCtx && typeof Chart !== 'undefined') {
        <% 
            const trendLabels = (trend && trend.length > 0) 
                ? trend.map(t => t.label || t.ym) 
                : ['Apr 2026', 'Mei 2026', 'Jun 2026', 'Jul 2026', 'Agu 2026', 'Sep 2026'];

            const trendWeights = (trend && trend.length > 0)
                ? trend.map(t => Number(t.total_kg || 0))
                : [8.5, 14.2, 22.0, 18.5, 27.3, Number(m.totalKg || 32.5)];

            const trendCounts = (trend && trend.length > 0)
                ? trend.map(t => Number(t.total_collections || 0))
                : [1, 2, 3, 2, 3, Number(m.completedPickups || 2)];
        %>

        const labels = <%- JSON.stringify(trendLabels) %>;
        const weightData = <%- JSON.stringify(trendWeights) %>;
        const countData = <%- JSON.stringify(trendCounts) %>;

        const ctx2d = trendCtx.getContext('2d');
        const gradient = ctx2d.createLinearGradient(0, 0, 0, 250);
        gradient.addColorStop(0, 'rgba(22, 163, 74, 0.35)');
        gradient.addColorStop(1, 'rgba(22, 163, 74, 0.01)');

        new Chart(trendCtx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [
                    {
                        label: 'Total Sampah (Kg)',
                        data: weightData,
                        borderColor: '#16a34a',
                        backgroundColor: gradient,
                        borderWidth: 3,
                        pointBackgroundColor: '#ffffff',
                        pointBorderColor: '#16a34a',
                        pointBorderWidth: 2.5,
                        pointRadius: 4,
                        fill: true,
                        tension: 0.35,
                        yAxisID: 'y'
                    },
                    {
                        label: 'Jumlah Pickup',
                        data: countData,
                        borderColor: '#0284c7',
                        borderWidth: 2,
                        borderDash: [5, 5],
                        pointBackgroundColor: '#0284c7',
                        pointRadius: 3,
                        fill: false,
                        tension: 0.35,
                        yAxisID: 'y1'
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'top',
                        labels: { usePointStyle: true, boxWidth: 8, font: { size: 11 } }
                    }
                },
                scales: {
                    x: { grid: { display: false } },
                    y: {
                        type: 'linear',
                        display: true,
                        position: 'left',
                        beginAtZero: true,
                        grid: { color: '#f1f5f9' },
                        title: { display: true, text: 'Berat (Kg)', color: '#64748b', font: { size: 10 } }
                    },
                    y1: {
                        type: 'linear',
                        display: true,
                        position: 'right',
                        beginAtZero: true,
                        grid: { drawOnChartArea: false },
                        ticks: { stepSize: 1 },
                        title: { display: true, text: 'Pickup', color: '#64748b', font: { size: 10 } }
                    }
                }
            }
        });
    }

    // 3. Category Doughnut Chart
    const catCtx = document.getElementById('categoryChart');
    if (catCtx && typeof Chart !== 'undefined') {
        <%
            const catLabelsArr = [];
            const catWeightsArr = [];
            const catPaletteArr = [];

            if (categories && categories.length > 0) {
                categories.forEach(function(c) {
                    const cWeight = Number(c.total_weight || 0);
                    const cName = c.category ? c.category.replace(/_/g, ' ').toUpperCase() : 'LAINNYA';
                    catLabelsArr.push(cName);
                    catWeightsArr.push(cWeight > 0 ? cWeight : 1);
                    catPaletteArr.push(catColors[c.category] || '#64748b');
                });
            } else {
                catLabelsArr.push('DAUR ULANG', 'ORGANIK', 'B3');
                catWeightsArr.push(32.5, 5.0, 2.0);
                catPaletteArr.push('#8b5cf6', '#10b981', '#f43f5e');
            }
        %>

        new Chart(catCtx, {
            type: 'doughnut',
            data: {
                labels: <%- JSON.stringify(catLabelsArr) %>,
                datasets: [{
                    data: <%- JSON.stringify(catWeightsArr) %>,
                    backgroundColor: <%- JSON.stringify(catPaletteArr) %>,
                    borderWidth: 2,
                    borderColor: '#ffffff'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '74%',
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function(ctx) {
                                return ` ${ctx.label}: ${ctx.raw} kg`;
                            }
                        }
                    }
                }
            }
        });
    }
});
</script>