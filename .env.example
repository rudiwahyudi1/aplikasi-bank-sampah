# ==============================================================================
# Aplikasi Bank Sampah — Environment Configuration
# ==============================================================================
# Salin file ini menjadi .env dan isi dengan nilai yang sesuai.
# JANGAN commit file .env ke repository!
# ==============================================================================

# ──────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────
NODE_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3000

# ──────────────────────────────────────────────
# Database (MySQL)
# ──────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bank_sampah
DB_USER=bank_sampah_user
DB_PASSWORD=your_database_password_here
DB_ROOT_PASSWORD=your_root_password_here
DB_EXTERNAL_PORT=3307

# ──────────────────────────────────────────────
# Authentication (JWT)
# ──────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_key_here_min_32_chars
JWT_EXPIRES_IN=7d

# ──────────────────────────────────────────────
# Email / SMTP
# ──────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_app_password_here

# ──────────────────────────────────────────────
# WhatsApp API (Webhook Notification)
# ──────────────────────────────────────────────
WHATSAPP_API_URL=https://api.whatsapp.com/v1
WHATSAPP_API_KEY=your_whatsapp_api_key_here

# ──────────────────────────────────────────────
# Payment Gateway (Midtrans / Xendit)
# ──────────────────────────────────────────────
PAYMENT_GATEWAY_KEY=your_payment_gateway_client_key
PAYMENT_GATEWAY_SECRET=your_payment_gateway_server_key
PAYMENT_GATEWAY_ENV=sandbox

# ──────────────────────────────────────────────
# Google Maps API (Peta & GPS)
# ──────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ──────────────────────────────────────────────
# Docker Registry (CI/CD)
# ──────────────────────────────────────────────
DOCKER_REGISTRY=ghcr.io
DOCKER_IMAGE_NAME=your-org/bank-sampah
DOCKER_USERNAME=your_docker_username
DOCKER_PASSWORD=your_docker_password
